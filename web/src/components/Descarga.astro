---
// La descarga. Hay seis artefactos publicados y en lista plana serían seis
// filas sin jerarquía, así que el botón abre un modal y allí se elige. Fuera
// del modal solo hay una decisión: descargar o no.
//
// El modal es un <dialog> nativo. Trae encierro del foco, cierre con Escape y
// fondo inerte de serie, sin librería ni JavaScript propio para nada de eso.

import { siApple, siLinux } from "simple-icons";
import { textos } from "../i18n/textos";

const t = textos(Astro.currentLocale);

const REPO = "https://github.com/luishidalgoa/ondine";
const ULTIMA = `${REPO}/releases/latest/download`;

// Los destinos son los mismos en los dos idiomas: solo cambian las etiquetas.
// Van aquí y no en el fichero de textos porque una URL no se traduce, y si
// estuviera allí habría dos copias que se desincronizarían.
const ENLACES = [
  [`${REPO}/releases/latest`, `${ULTIMA}/ondine-windows-x64.exe`],
  [`${ULTIMA}/ondine-macos-arm64.tar.gz`, `${ULTIMA}/ondine-macos-x64.tar.gz`],
  [`${ULTIMA}/ondine-linux-x64.tar.gz`, `${ULTIMA}/ondine-linux-arm64.tar.gz`],
];

// Simple Icons no trae Windows: Microsoft pidió que retirasen sus marcas del
// paquete. Así que Apple y Tux salen de la fuente, y para Windows va un glifo
// genérico de ventana. No es su logotipo ni pretende parecerlo, y dibujar el
// suyo a mano sería saltarse justo la razón por la que no está.
const VENTANA =
  "M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 " +
  "2.5h-13A2.5 2.5 0 0 1 3 18.5v-13Zm1.6 0v2.1h14.8V5.5a.9.9 0 0 0-.9-.9h-13a" +
  ".9.9 0 0 0-.9.9Zm14.8 3.7H4.6v9.3c0 .5.4.9.9.9h13c.5 0 .9-.4.9-.9V9.2Z";

const ICONOS = [VENTANA, siApple.path, siLinux.path];

// El instalador de Windows lleva la versión en el nombre, así que no admite
// enlace fijo a la última: ese va a la página de versiones y los otros cinco
// descargan directo.
const GRUPOS = t.descarga.grupos.map((g, i) => ({
  ...g,
  icono: ICONOS[i],
  opciones: g.opciones.map((o, j) => ({ ...o, href: ENLACES[i][j] })),
}));

const PROMESAS = t.descarga.promesas;
---

<section id="descarga" class="descarga">
  <div class="marco">
    <h2 class="acero titulo">{t.descarga.titulo}</h2>
    <p class="apoyo">{t.descarga.apoyo}</p>

    <button class="boton-grande" type="button" data-abre>{t.descarga.boton}</button>

    <ul class="promesas">
      {PROMESAS.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<dialog class="modal" data-modal aria-labelledby="modal-titulo">
  <div class="modal-cabecera">
    <h3 id="modal-titulo">{t.descarga.modalTitulo}</h3>
    <button class="cerrar" type="button" data-cierra aria-label={t.descarga.cerrar}>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="grupos">
    {
      GRUPOS.map((g) => (
        <section class="tarjeta">
          <header>
            <svg
              class="logo"
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <path d={g.icono} />
            </svg>
            <h4>{g.sistema}</h4>
          </header>
          <ul>
            {g.opciones.map((o) => (
              <li>
                <a href={o.href}>
                  <span class="etiqueta">{o.etiqueta}</span>
                  <span class="peso">{o.peso}</span>
                  <span class="detalle">{o.detalle}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <!-- Qué hacer con el .tar.gz una vez descargado. Va DENTRO del modal y no
         en una sección aparte porque solo tiene sentido al lado de los
         binarios a los que se refiere: fuera de aquí es un comando sin
         contexto. -->
    <section class="terminal">
      <h4>{t.descarga.terminalTitulo}</h4>
      <p>{t.descarga.terminalNota}</p>
      <pre class="orden"><code>{t.descarga.terminalOrden}</code></pre>
      <p class="manual">{t.descarga.terminalManual}</p>
      <pre><code>{t.descarga.terminalComandos}</code></pre>
    </section>
    {
      []
    }
  </div>

  <p class="modal-pie">
    {t.descarga.pieA}<a href={`${REPO}/releases`}>{t.descarga.pieEnlace}</a>{t.descarga.pieB}
  </p>
</dialog>

<style>
  .descarga {
    padding: clamp(4.5rem, 9vh, 7rem) 0;
    border-top: 1px solid rgb(255 255 255 / 0.05);
  }

  .marco {
    margin: 0 auto;
    max-width: 1400px;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) { .marco { padding: 0 2.5rem; } }

  .titulo {
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .apoyo {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: 17px;
    line-height: 1.6;
    color: #8a8fa3;
  }

  .boton-grande {
    margin-top: 2rem;
    padding: 1.1rem 2.5rem;
    border: 0;
    border-radius: 999px;
    background: #968ae0;
    color: #12101f;
    font-family: inherit;
    font-size: 17px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
  }
  .boton-grande:hover { background: #b5abfc; }
  .boton-grande:active { transform: translateY(1px); }

  .promesas {
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    display: grid;
    gap: 0.85rem;
    max-width: 70ch;
  }

  .promesas li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 15px;
    line-height: 1.6;
    color: #8a8fa3;
  }

  /* Una raya corta y no un punto de color: los puntos de color delante de
     cada línea son adorno, y aquí lo que se lee es la frase. */
  .promesas li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: #4a4f63;
  }

  /* ── el modal ──────────────────────────────────────────────────────────── */
  .modal {
    width: min(940px, calc(100vw - 2rem));
    max-height: min(86vh, 760px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: #232532;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 24px 70px rgb(8 9 16 / 0.6);
    color: #e9e9ed;
    overflow: hidden;
  }

  .modal::backdrop {
    background: rgb(12 13 22 / 0.72);
    backdrop-filter: blur(3px);
  }

  .modal-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 1.5rem 1.1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
  }

  .modal-cabecera h3 {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .cerrar {
    position: relative;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .cerrar:hover { background: rgb(255 255 255 / 0.07); }

  /* La equis son dos trazos cruzados, no un icono dibujado a mano. */
  .cerrar span,
  .cerrar span::before {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 13px;
    height: 1.5px;
    background: #8a8fa3;
    border-radius: 2px;
  }
  .cerrar span {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .cerrar span::before {
    content: "";
    left: 0;
    top: 0;
    transform: rotate(90deg);
  }

  /* ── el bloque del terminal ────────────────────────────────────────────── */
  .terminal {
    grid-column: 1 / -1;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }

  .terminal h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8a8fa3;
  }

  .terminal p {
    margin-top: 0.55rem;
    font-size: 13px;
    line-height: 1.6;
    color: #8a8fa3;
  }

  .terminal pre {
    margin-top: 0.7rem;
    padding: 0.8rem 0.95rem;
    border-radius: 8px;
    background: #101120;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    overflow-x: auto;
  }

  .terminal code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: #c9ccd6;
    white-space: pre;
  }

  /* La orden de una línea es la recomendada, así que va marcada; la manual es
     el respaldo para quien no quiera canalizar un script a la consola, que es
     una desconfianza razonable. */
  .terminal .orden {
    box-shadow: inset 0 0 0 1px rgb(150 138 224 / 0.35);
  }
  .terminal .orden code { color: #e9e9ed; }

  .terminal .manual {
    margin-top: 0.9rem;
    font-size: 12.5px;
    color: #8a8fa3;
  }

  .grupos {
    padding: 1.25rem 1.5rem 1.5rem;
    overflow-y: auto;
    max-height: calc(86vh - 150px);
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 780px) {
    .grupos { grid-template-columns: repeat(3, 1fr); }
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    padding: 1.15rem 1.1rem 1.1rem;
    border-radius: 12px;
    background: #292b31;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .tarjeta header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
  }

  /* Los logotipos van en el gris del texto, no en sus colores de marca: en la
     web de otro, un logo a color se lee como sello de aprobación. */
  .logo {
    width: 20px;
    height: 20px;
    flex: none;
    fill: #8a8fa3;
  }

  .tarjeta h4 {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #e9e9ed;
  }

  .tarjeta ul {
    display: grid;
    gap: 0.2rem;
  }

  .tarjeta a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.2rem 0.75rem;
    padding: 0.65rem 0.6rem;
    border-radius: 8px;
    transition: background-color 0.15s;
  }
  .tarjeta a:hover { background: rgb(255 255 255 / 0.05); }

  .etiqueta {
    font-size: 14px;
    font-weight: 500;
    color: #e9e9ed;
  }

  .peso {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #8a8fa3;
    white-space: nowrap;
    align-self: center;
  }

  .detalle {
    grid-column: 1 / -1;
    font-size: 12.5px;
    line-height: 1.45;
    color: #8a8fa3;
  }

  .modal-pie {
    padding: 1rem 1.5rem 1.35rem;
    border-top: 1px solid rgb(255 255 255 / 0.07);
    font-size: 13px;
    color: #8a8fa3;
  }
  .modal-pie a { color: #b5abfc; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const modal = document.querySelector<HTMLDialogElement>("[data-modal]");

  document
    .querySelectorAll<HTMLButtonElement>("[data-abre]")
    .forEach((b) => b.addEventListener("click", () => modal?.showModal()));

  document
    .querySelector<HTMLButtonElement>("[data-cierra]")
    ?.addEventListener("click", () => modal?.close());

  // Pulsar fuera del cuadro cierra. El <dialog> reparte los clics del fondo al
  // propio elemento, así que basta con comprobar que el clic no cayó dentro.
  modal?.addEventListener("click", (e) => {
    const c = modal.getBoundingClientRect();
    const fuera =
      e.clientX < c.left ||
      e.clientX > c.right ||
      e.clientY < c.top ||
      e.clientY > c.bottom;
    if (fuera) modal.close();
  });

  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!quieto) {
    gsap.from(
      "#descarga .titulo, #descarga .apoyo, #descarga .boton-grande, #descarga .promesas li",
      {
        opacity: 0,
        y: 20,
        duration: 0.6,
        stagger: 0.07,
        ease: "power2.out",
        scrollTrigger: { trigger: "#descarga", start: "top 75%" },
      },
    );
  }
</script>
