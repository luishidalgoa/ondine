---
// El spot, servido desde la propia página. Nada de YouTube: un incrustado de
// terceros mete scripts y cookies a quien solo pasaba por aquí, y además saca
// al visitante de la página justo antes de la descarga, que es lo último que
// interesa.
//
// El vídeo original pesaba 15,9 MB. Aquí va a 3,1 MB, a 1280 de ancho y con
// los metadatos al principio del fichero para que empiece antes de acabar de
// bajar. Lo comprimió Ondine, que es de lo que va esto.
//
// `preload="metadata"` es deliberado: sin pulsar no se descargan los 3 MB,
// solo la cabecera. La portada es una imagen aparte de 59 KB.
const base = import.meta.env.BASE_URL;
---

<section id="spot" class="spot">
  <div class="marco">
    <h2 class="acero titulo">Cuarenta y cuatro segundos.</h2>

    <div class="reproductor" data-reproductor>
      <video
        data-video
        poster={`${base}/spot-portada.jpg`}
        preload="metadata"
        playsinline
        width="1920"
        height="1080"
      >
        <source src={`${base}/spot-ondine.mp4`} type="video/mp4" />
        Tu navegador no reproduce vídeo. <a href={`${base}/spot-ondine.mp4`}>
          Descarga el spot</a
        >.
      </video>

      <button class="disparo" data-disparo type="button">
        <span class="disco" aria-hidden="true"><span class="punta"></span></span>
        <span class="rotulo">Reproducir el spot</span>
      </button>
    </div>
  </div>
</section>

<style>
  .spot { padding: clamp(3.5rem, 7vh, 5.5rem) 0; }

  .marco {
    margin: 0 auto;
    max-width: 1400px;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) { .marco { padding: 0 2.5rem; } }

  .titulo {
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .reproductor {
    position: relative;
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
    border-radius: 12px;
    overflow: hidden;
    background: #101120;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }

  .reproductor video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* El disparador tapa el vídeo entero mientras no se ha pulsado. Al pulsar,
     se retira y aparecen los controles nativos, que es lo que la gente ya
     sabe manejar. */
  .disparo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    gap: 1rem;
    border: 0;
    padding: 0;
    background: rgb(22 24 38 / 0.28);
    cursor: pointer;
    transition: opacity 0.35s, background-color 0.3s;
  }
  .disparo:hover { background: rgb(22 24 38 / 0.14); }
  .disparo[hidden] { display: none; }

  .disco {
    width: clamp(58px, 6.5vw, 82px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(150 138 224 / 0.94);
    display: grid;
    place-items: center;
    transition: transform 0.2s, background-color 0.2s;
  }
  .disparo:hover .disco { background: #b5abfc; transform: scale(1.06); }

  /* Triángulo de geometría pura, no un icono dibujado a mano. */
  .punta {
    width: 0;
    height: 0;
    margin-left: 16%;
    font-size: clamp(15px, 1.7vw, 20px);
    border-top: 0.55em solid transparent;
    border-bottom: 0.55em solid transparent;
    border-left: 0.95em solid #12101f;
  }

  .rotulo {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: rgb(22 24 38 / 0.8);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #c9ccd6;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const video = document.querySelector<HTMLVideoElement>("[data-video]");
  const disparo = document.querySelector<HTMLButtonElement>("[data-disparo]");

  disparo?.addEventListener("click", () => {
    if (!video) return;
    video.controls = true;
    disparo.hidden = true;
    // La reproducción la ha pedido una persona pulsando, así que puede sonar.
    void video.play();
  });

  // Si se acaba, vuelve la portada: deja la sección como estaba en vez de
  // quedarse con el último fotograma congelado.
  video?.addEventListener("ended", () => {
    if (!disparo) return;
    video.controls = false;
    video.load();
    disparo.hidden = false;
  });

  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!quieto) {
    gsap.from("#spot .titulo, #spot .reproductor", {
      opacity: 0,
      y: 26,
      duration: 0.75,
      stagger: 0.12,
      ease: "power2.out",
      scrollTrigger: { trigger: "#spot", start: "top 78%" },
    });
  }
</script>
