---
// El spot, servido desde la propia página y reproduciéndose solo. Nada de
// YouTube: un incrustado de terceros mete scripts y cookies a quien solo
// pasaba por aquí, y saca al visitante fuera justo antes de la descarga.
//
// Va sin barra de controles, en bucle, y arranca cuando entra en pantalla.
// Dos cosas que eso obliga y no se pueden saltar:
//
//   1. Los navegadores solo autorreproducen si el vídeo está EN SILENCIO. No
//      es opcional ni se puede rodear. Pero este spot tiene música compuesta
//      para él, así que hay un interruptor de sonido: pequeño, en una esquina
//      y sin barra de controles alrededor.
//   2. Un vídeo moviéndose solo es justo lo que evita quien navega con
//      `prefers-reduced-motion`. A esa persona no se le autorreproduce nada:
//      se le deja la portada y un botón.
//
// El vídeo original pesaba 15,9 MB. Aquí va a 3,1 MB, a 1280 de ancho y con
// los metadatos al principio del fichero para que empiece antes de acabar de
// bajar. Lo comprimió Ondine, que es de lo que va esto.
const base = import.meta.env.BASE_URL;
---

<section id="spot" class="spot">
  <div class="marco">
    <h2 class="acero titulo">Cuarenta y cuatro segundos.</h2>

    <div class="escena">
      <div class="reproductor" data-reproductor>
        <video
          data-video
          poster={`${base}/spot-portada.jpg`}
          preload="metadata"
          muted
          loop
          playsinline
          width="1920"
          height="1080"
        >
          <source src={`${base}/spot-ondine.mp4`} type="video/mp4" />
          Tu navegador no reproduce vídeo. <a href={`${base}/spot-ondine.mp4`}>
            Descarga el spot</a
          >.
        </video>

        <!-- Solo aparece si no hay autorreproducción, que es el caso de quien
             tiene las animaciones desactivadas. -->
        <button class="disparo" data-disparo type="button" hidden>
          <span class="disco" aria-hidden="true"><span class="punta"></span></span>
          <span class="rotulo">Reproducir el spot</span>
        </button>

        <button class="sonido" data-sonido type="button" aria-pressed="false">
          <span data-sonido-texto>Activar sonido</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .spot { padding: clamp(3.5rem, 7vh, 5.5rem) 0; }

  .marco {
    margin: 0 auto;
    max-width: 1400px;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) { .marco { padding: 0 2.5rem; } }

  .titulo {
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1.12;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  /* La escena existe solo para dar sitio a la inclinación: sin ella, las
     esquinas giradas se comerían el relleno de la sección. */
  .escena {
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
    perspective: 1600px;
  }

  .reproductor {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #101120;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 30px 80px rgb(8 9 16 / 0.55);
    will-change: transform;
  }

  .reproductor video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── el interruptor de sonido ──────────────────────────────────────────── */
  /* No es una barra de controles: es un botón suelto y pequeño. Sin él, la
     música del spot no sonaría nunca, porque autorreproducir obliga a
     empezar en silencio. */
  .sonido {
    position: absolute;
    right: clamp(0.75rem, 1.6vw, 1.25rem);
    bottom: clamp(0.75rem, 1.6vw, 1.25rem);
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: rgb(22 24 38 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #c9ccd6;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .sonido:hover {
    background: rgb(22 24 38 / 0.9);
    color: #e9e9ed;
  }
  .sonido[hidden] { display: none; }

  /* ── el disparador de reserva ──────────────────────────────────────────── */
  .disparo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    gap: 1rem;
    border: 0;
    padding: 0;
    background: rgb(22 24 38 / 0.28);
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .disparo:hover { background: rgb(22 24 38 / 0.14); }
  .disparo[hidden] { display: none; }

  .disco {
    width: clamp(58px, 6.5vw, 82px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(150 138 224 / 0.94);
    display: grid;
    place-items: center;
    transition: transform 0.2s, background-color 0.2s;
  }
  .disparo:hover .disco { background: #b5abfc; transform: scale(1.06); }

  /* Triángulo de geometría pura, no un icono dibujado a mano. */
  .punta {
    width: 0;
    height: 0;
    margin-left: 16%;
    font-size: clamp(15px, 1.7vw, 20px);
    border-top: 0.55em solid transparent;
    border-bottom: 0.55em solid transparent;
    border-left: 0.95em solid #12101f;
  }

  .rotulo {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: rgb(22 24 38 / 0.8);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #c9ccd6;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const video = document.querySelector<HTMLVideoElement>("[data-video]");
  const disparo = document.querySelector<HTMLButtonElement>("[data-disparo]");
  const sonido = document.querySelector<HTMLButtonElement>("[data-sonido]");
  const sonidoTexto = document.querySelector<HTMLElement>("[data-sonido-texto]");

  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (video) {
    if (quieto) {
      // Nada se mueve solo. Portada, botón, y si lo pulsa, con controles.
      if (disparo) disparo.hidden = false;
      if (sonido) sonido.hidden = true;
      disparo?.addEventListener("click", () => {
        video.controls = true;
        video.muted = false;
        disparo.hidden = true;
        void video.play();
      });
    } else {
      // Solo se reproduce mientras se está viendo. Un vídeo corriendo fuera de
      // pantalla gasta batería y datos sin que nadie lo mire.
      const ojo = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) {
            video.play().catch(() => {
              // Si el navegador se niega aun estando en silencio, no se deja
              // al visitante con un cuadro parado: se le da el botón.
              if (disparo) disparo.hidden = false;
            });
          } else {
            video.pause();
          }
        },
        { threshold: 0.35 },
      );
      ojo.observe(video);

      disparo?.addEventListener("click", () => {
        disparo.hidden = true;
        void video.play();
      });

      sonido?.addEventListener("click", () => {
        video.muted = !video.muted;
        sonido.setAttribute("aria-pressed", String(!video.muted));
        if (sonidoTexto) {
          sonidoTexto.textContent = video.muted
            ? "Activar sonido"
            : "Silenciar";
        }
      });

      // Entra girado y se endereza. El giro es el mismo gesto que el mural del
      // hero, así que la página se reconoce a sí misma en vez de estrenar un
      // efecto nuevo aquí.
      gsap.from("#spot .titulo", {
        opacity: 0,
        y: 24,
        duration: 0.7,
        ease: "power2.out",
        scrollTrigger: { trigger: "#spot", start: "top 78%" },
      });

      gsap.fromTo(
        "[data-reproductor]",
        { rotateY: -9, rotateX: 4, scale: 0.94, opacity: 0 },
        {
          rotateY: 0,
          rotateX: 0,
          scale: 1,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          scrollTrigger: { trigger: "#spot", start: "top 80%" },
        },
      );
    }
  }
</script>
