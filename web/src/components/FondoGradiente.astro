---
// El fondo de la página: un campo de color continuo que se deforma solo.
//
// La referencia lo hace con un canvas WebGL a pantalla completa. Aquí no hace
// falta traer un shader: el campo se pinta en un lienzo de 120x68 y se estira.
// Al ampliar, el navegador interpola y lo que era un mosaico se vuelve un
// degradado continuo; el desenfoque remata lo que quede.
//
// Son unos 8.000 píxeles por fotograma en vez de dos millones, y cuesta lo
// mismo en un móvil viejo que en un monitor 4K, porque el tamaño del lienzo no
// depende de la pantalla.
---

<div class="fondo" aria-hidden="true">
  <canvas data-fondo-lienzo></canvas>
</div>

<style>
  .fondo {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter: blur(46px) saturate(1.15);
    /* Se pasa del borde para que el desenfoque no deje halo en los cantos. */
    transform: scale(1.2);
  }
</style>

<script>
  const lienzo = document.querySelector<HTMLCanvasElement>("[data-fondo-lienzo]");

  if (lienzo) {
    // Fijo y pequeño a propósito: no depende del tamaño de la pantalla.
    const A = 120, H = 68;
    lienzo.width = A;
    lienzo.height = H;
    const ctx = lienzo.getContext("2d")!;
    const imagen = ctx.createImageData(A, H);
    const px = imagen.data;

    // La rampa: del lienzo a un morado hondo. Solo colores de la familia de la
    // paleta; un gradiente con tonos inventados es lo que hace que una página
    // se lea como generada.
    //
    // El techo NO es una elección estética, es un límite medido. Encima de
    // este fondo va el texto de cuerpo en #8A8FA3, y el contraste mínimo de la
    // norma AA son 4,5. Con la rampa subiendo hasta #6D60A8 ese texto se
    // quedaba en 2,19, o sea ilegible sobre las zonas claras. Cortando en
    // #332C52 el punto más claro deja el cuerpo por encima del mínimo.
    // Si alguien sube este techo, tiene que volver a medirlo.
    const RAMPA: Array<[number, number, number, number]> = [
      [0.0, 0x16, 0x18, 0x26],
      [0.45, 0x1b, 0x1c, 0x2f],
      [0.75, 0x25, 0x23, 0x40],
      [1.0, 0x2a, 0x24, 0x44],
    ];

    const color = (t: number) => {
      let i = 0;
      while (i < RAMPA.length - 2 && t > RAMPA[i + 1][0]) i++;
      const [t0, r0, g0, b0] = RAMPA[i];
      const [t1, r1, g1, b1] = RAMPA[i + 1];
      const f = (t - t0) / (t1 - t0 || 1);
      return [r0 + (r1 - r0) * f, g0 + (g1 - g0) * f, b0 + (b1 - b0) * f];
    };

    // El campo sale de sumar ondas con periodos que no encajan entre sí. Es la
    // vieja «plasma»: barata, continua y sin costuras, y desenfocada no se
    // distingue del ruido de un shader.
    const pintar = (t: number) => {
      let n = 0;
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < A; x++) {
          const u = x / A, v = y / H;
          const s =
            Math.sin(u * 4.1 + t * 0.16) +
            Math.sin(v * 3.3 - t * 0.11) +
            Math.sin((u + v) * 5.7 + t * 0.09) +
            Math.sin(Math.hypot(u - 0.5, v - 0.55) * 8.2 - t * 0.13);

          // De -4..4 a 0..1, elevado para que lo claro ocupe poco sitio.
          const [r, g, b] = color(Math.pow((s + 4) / 8, 1.7));
          px[n++] = r; px[n++] = g; px[n++] = b; px[n++] = 255;
        }
      }
      ctx.putImageData(imagen, 0, 0);
    };

    const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Un fotograma siempre, pase lo que pase. Hace falta en dos casos reales:
    // con las animaciones desactivadas, donde no habrá bucle nunca; y cuando la
    // página se abre en una pestaña de fondo, porque ahí el navegador no
    // dispara ni un `requestAnimationFrame` y el fondo se quedaría en blanco.
    pintar(0);

    if (!quieto) {
      let id = 0;
      const paso = (t: number) => {
        pintar(t / 1000);
        id = requestAnimationFrame(paso);
      };
      const arrancar = () => {
        if (!id) id = requestAnimationFrame(paso);
      };
      const parar = () => {
        if (id) { cancelAnimationFrame(id); id = 0; }
      };
      // Con la pestaña de fondo el navegador ya congela el bucle, pero al
      // volver el identificador seguía puesto y no rearrancaba solo.
      document.addEventListener("visibilitychange", () =>
        document.hidden ? parar() : arrancar(),
      );
      arrancar();
    }
  }
</script>
