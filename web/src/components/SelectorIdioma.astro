---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { IDIOMAS, NOMBRE_IDIOMA, idiomaDe, textos } from "../i18n/textos";

// Las banderas se leen del paquete EN COMPILACIÓN y se incrustan: pesan menos
// de 1 KB cada una, así que no compensa una petición extra por bandera.
//
// Y son SVG y no emoji a propósito: en Windows, los emoji de bandera no se
// pintan como banderas, sino como las dos letras del código de país. Justo el
// sistema de la gente que usa Ondine.
//
// Bandera del Reino Unido y no de Estados Unidos porque el texto está escrito
// en inglés británico: «licence», «organise», «film».
const BANDERAS: Record<string, string> = Object.fromEntries(
  ([
    ["en", "GB"],
    ["es", "ES"],
  ] as const).map(([idioma, pais]) => [
    idioma,
    readFileSync(
      join(process.cwd(), "node_modules/country-flag-icons/3x2", `${pais}.svg`),
      "utf8",
    ),
  ]),
);

// El selector de idioma.
//
// Va con <details> y no con una lista y JavaScript: <details> ya sabe abrirse,
// cerrarse con Escape y anunciarse a un lector de pantalla, sin una linea de
// codigo. Lo unico que hace falta a mano es cerrarlo al pulsar fuera.
//
// Y son ENLACES de verdad, no un cambio de estado: cada idioma tiene su URL,
// asi que se puede compartir, indexar y abrir en otra pestaña.

const actual = idiomaDe(Astro.currentLocale);
const t = textos(actual);
const base = import.meta.env.BASE_URL;

// La ruta equivalente en el otro idioma. Se calcula quitando el prefijo de
// idioma y el de despliegue, y volviendo a montarlos: asi «/ondine/en/about»
// sabe volver a «/ondine/sobre-mi» y no a la portada.
// El inglés es el idioma por defecto, así que va sin prefijo y el castellano
// cuelga de `es`.
const EQUIVALENTES: Record<string, Record<string, string>> = {
  "": { en: "", es: "es/" },
  "es": { en: "", es: "es/" },
  "about": { en: "about", es: "es/sobre-mi" },
  "es/sobre-mi": { en: "about", es: "es/sobre-mi" },
};

const ruta = Astro.url.pathname
  .replace(base, "")
  .replace(/^\/+|\/+$/g, "");

const destino = (idioma: string) => {
  const par = EQUIVALENTES[ruta];
  const trozo = par ? par[idioma] : idioma === "en" ? "" : "es/";
  return `${base}/${trozo}`.replace(/\/{2,}/g, "/");
};
---

<details class="idioma" data-idioma>
  <summary aria-label={t.armazon.idioma}>
    <span class="bandera" aria-hidden="true" set:html={BANDERAS[actual]} />
    <span class="codigo">{actual.toUpperCase()}</span>
    <span class="punta" aria-hidden="true"></span>
  </summary>

  <ul>
    {
      IDIOMAS.map((i) => (
        <li>
          <a href={destino(i)} hreflang={i} aria-current={i === actual ? "true" : undefined}>
            <span class="bandera" aria-hidden="true" set:html={BANDERAS[i]} />
            {NOMBRE_IDIOMA[i]}
            <span class="marca-actual" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .idioma {
    position: relative;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    font-size: 14px;
    color: #8a8fa3;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s, background-color 0.2s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: #e9e9ed; }
  .idioma[open] summary {
    background: rgb(255 255 255 / 0.06);
    color: #e9e9ed;
  }

  /* La bandera lleva un filo tenue por dentro: las dos tienen blanco en el
     borde y sin él se derraman sobre el fondo oscuro. */
  .bandera {
    display: block;
    width: 21px;
    aspect-ratio: 3 / 2;
    flex: none;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }
  .bandera :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .codigo {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  /* Un triángulo de bordes, no un icono dibujado a mano. */
  .punta {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4.5px solid currentColor;
    transition: transform 0.2s;
  }
  .idioma[open] .punta { transform: rotate(180deg); }

  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 150px;
    padding: 0.3rem;
    border-radius: 12px;
    background: #232532;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 18px 40px rgb(8 9 16 / 0.55);
    z-index: 60;
  }

  ul a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 14px;
    color: #c9ccd6;
    transition: background-color 0.15s, color 0.15s;
  }
  ul a:hover { background: #292b31; color: #e9e9ed; }

  /* El idioma en curso se marca con un punto, y aquí sí está justificado: no
     es adorno, es el único dato que distingue una opción de la otra. Va al
     final para que las banderas queden alineadas entre sí. */
  .marca-actual {
    width: 5px;
    height: 5px;
    flex: none;
    margin-left: auto;
    border-radius: 50%;
    background: transparent;
  }
  [aria-current="true"] .marca-actual { background: #968ae0; }
  [aria-current="true"] { color: #e9e9ed; }
</style>

<script>
  // Lo único que <details> no trae de serie: cerrarse al pulsar fuera.
  const selector = document.querySelector<HTMLDetailsElement>("[data-idioma]");
  if (selector) {
    document.addEventListener("click", (e) => {
      if (selector.open && !selector.contains(e.target as Node)) {
        selector.open = false;
      }
    });
  }
</script>
