---
// El decorado del spot: la superficie del agua de la que sale el vídeo.
//
// Son cuatro planos a distinta distancia, no un dibujo pegado delante:
//
//   cielo   · el fondo, que se abre por el horizonte mientras se baja
//   lejos   · casi del color del cielo, apenas se despega
//   medio   · un punto más oscuro
//   cerca   · silueta plana, la más oscura, saliéndose por abajo
//
// Ese escalado de claro a oscuro es perspectiva atmosférica: lo que está lejos
// pierde contraste contra el fondo. Es lo que da profundidad de verdad.
//
// Y CADA PLANO SE MECE de lado, con su propio periodo. Eso es lo que hace que
// se lea como agua y no como tres curvas abstractas: una superficie que solo
// sube y baja puede ser cualquier cosa; una que se mece es líquida. Los
// periodos son primos entre sí para que las tres crestas no vuelvan a
// coincidir nunca y no se vea el bucle.
//
// El vaivén va en el SVG y el recorrido del scroll en el contenedor. Separado
// a posta: si los dos escribieran `transform` sobre el mismo elemento, el
// último en llegar borraría al otro.
---

<div class="escenario-fondo" aria-hidden="true">
  <div class="cielo" data-cielo></div>

  <div class="capa lejos" data-capa="1">
    <svg viewBox="0 0 1440 180" preserveAspectRatio="none">
      <path d="M0 96 C 180 78 300 104 480 92 C 660 80 780 100 960 90 C 1140 80 1290 98 1440 88 L1440 180 L0 180 Z" />
    </svg>
  </div>

  <div class="capa medio" data-capa="2">
    <svg viewBox="0 0 1440 200" preserveAspectRatio="none">
      <path d="M0 118 C 160 92 320 130 500 106 C 680 82 820 118 1000 100 C 1180 82 1320 116 1440 98 L1440 200 L0 200 Z" />
      <!-- El filo iluminado de la cresta. Sin esta línea, la silueta es una
           mancha; con ella, es una superficie que refleja. -->
      <path class="filo" d="M0 118 C 160 92 320 130 500 106 C 680 82 820 118 1000 100 C 1180 82 1320 116 1440 98" />
    </svg>
  </div>

  <div class="capa cerca" data-capa="3">
    <svg viewBox="0 0 1440 240" preserveAspectRatio="none">
      <path d="M0 150 C 150 118 300 168 470 128 C 600 97 680 88 720 86 C 760 88 840 97 970 128 C 1140 168 1290 118 1440 150 L1440 240 L0 240 Z" />
      <path class="filo" d="M0 150 C 150 118 300 168 470 128 C 600 97 680 88 720 86 C 760 88 840 97 970 128 C 1140 168 1290 118 1440 150" />
    </svg>
  </div>
</div>

<style>
  .escenario-fondo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── el cielo ──────────────────────────────────────────────────────────── */
  /* El alto es una variable porque GSAP la mueve con el scroll. Arranca
     cerrado y de noche, y al bajar se abre por el horizonte. No cambia de
     color: un atardecer de naranjas se saldría de la paleta. */
  .cielo {
    --alto: 0;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        130% 62% at 50% calc(78% + var(--alto) * 8%),
        rgb(93 82 148 / calc(0.1 + var(--alto) * 0.26)) 0%,
        rgb(121 108 191 / calc(var(--alto) * 0.09)) 34%,
        rgb(22 24 38 / 0) 66%
      ),
      linear-gradient(
        to bottom,
        #12131f 0%,
        #161826 46%,
        #191b2b calc(72% + var(--alto) * 6%),
        #161826 100%
      );
  }

  /* ── los planos ────────────────────────────────────────────────────────── */
  /* Sobran por los lados: al mecerse no puede asomar el borde. */
  .capa {
    position: absolute;
    left: -10%;
    width: 120%;
    will-change: transform;
  }

  .capa svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .capa .filo {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* De lejos a cerca: más abajo, más alta y más oscura. */
  .lejos {
    bottom: 26%;
    height: clamp(70px, 13vh, 130px);
    opacity: 0.55;
  }
  .lejos path { fill: #232532; }
  .lejos svg { animation: mecer-lejos 23s ease-in-out infinite alternate; }

  .medio {
    bottom: 12%;
    height: clamp(96px, 18vh, 180px);
  }
  .medio path { fill: #1b1d2c; }
  .medio .filo { stroke: rgb(150 138 224 / 0.16); }
  .medio svg { animation: mecer-medio 17s ease-in-out infinite alternate; }

  .cerca {
    bottom: -2%;
    height: clamp(130px, 26vh, 250px);
  }
  .cerca path { fill: #101120; }
  .cerca .filo { stroke: rgb(150 138 224 / 0.3); }
  .cerca svg { animation: mecer-cerca 13s ease-in-out infinite alternate; }

  /* El de delante se mece más: es el que está más cerca del ojo. */
  @keyframes mecer-lejos {
    from { transform: translate3d(-0.9%, 0, 0); }
    to   { transform: translate3d(0.9%, 0, 0); }
  }
  @keyframes mecer-medio {
    from { transform: translate3d(1.6%, 0, 0); }
    to   { transform: translate3d(-1.6%, 0, 0); }
  }
  @keyframes mecer-cerca {
    from { transform: translate3d(-2.6%, 0, 0); }
    to   { transform: translate3d(2.6%, 0, 0); }
  }

  /* Sin movimiento, el decorado se queda en un fotograma que aguanta solo: el
     cielo medio abierto y las crestas quietas. */
  @media (prefers-reduced-motion: reduce) {
    .cielo { --alto: 0.6; }
    .capa svg { animation: none; }
  }
</style>
