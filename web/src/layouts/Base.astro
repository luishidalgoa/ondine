---
import "../styles/global.css";
import Marca from "../components/Marca.astro";
import FondoGradiente from "../components/FondoGradiente.astro";
import SelectorIdioma from "../components/SelectorIdioma.astro";
import { idiomaDe, textos } from "../i18n/textos";
import { siGithub } from "simple-icons";

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
const base = import.meta.env.BASE_URL;
const idioma = idiomaDe(Astro.currentLocale);
const t = textos(idioma);

const REPO = "https://github.com/luishidalgoa/ondine";

// Cada idioma tiene su portada y su «sobre mí». El selector necesita saber
// estas rutas y los buscadores también, para no tratar las dos versiones como
// contenido duplicado.
const PORTADA = idioma === "es" ? `${base}/` : `${base}/en/`;
const SOBRE_MI = idioma === "es" ? `${base}/sobre-mi` : `${base}/en/about`;

const ALTERNAS = [
  { hreflang: "es", href: new URL(`${base}/`, Astro.site).href },
  { hreflang: "en", href: new URL(`${base}/en/`, Astro.site).href },
  { hreflang: "x-default", href: new URL(`${base}/`, Astro.site).href },
];
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#161826" />
    <link rel="icon" type="image/png" href={`${base}/icon.png`} />

    {ALTERNAS.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content={idioma === "es" ? "es_ES" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <FondoGradiente />

    <!-- La barra no lleva menú: la página es una sola y el único destino que
         importa es la descarga. Cabe de sobra en una línea a cualquier ancho. -->
    <header
      class="fixed inset-x-0 top-0 z-50 h-16 border-b border-white/5 bg-lienzo/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-full max-w-[1400px] items-center justify-between px-6 lg:px-10"
      >
        <!-- Va a la portada y no a un ancla: desde una subpágina, `#inicio` no
             lleva a ninguna parte. -->
        <a
          href={PORTADA}
          class="flex items-center gap-3 text-tinta transition-opacity hover:opacity-80"
        >
          <Marca clase="size-6 text-acento" titulo="Ondine" />
          <span class="text-[17px] font-medium tracking-[0.01em]">Ondine</span>
        </a>

        <nav class="flex items-center gap-3 sm:gap-5">
          <SelectorIdioma />

          <a
            href={REPO}
            class="flex items-center gap-2 text-sm text-tinta-3 transition-colors hover:text-tinta"
          >
            <svg
              class="size-[18px] shrink-0 fill-current"
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <path d={siGithub.path}></path>
            </svg>
            <span class="hidden sm:inline">{t.armazon.codigo}</span>
          </a>

          <!-- Abre el mismo modal que el botón de la sección de descarga: una
               sola intención, un solo texto y un solo sitio donde elegir. -->
          <button
            type="button"
            data-abre
            class="cursor-pointer rounded-full bg-acento px-4 py-2 text-sm font-medium whitespace-nowrap text-[#12101f] transition-all hover:bg-acento-claro active:translate-y-px"
          >
            {t.armazon.descargar}
          </button>
        </nav>
      </div>
    </header>

    <!-- El fondo va posicionado y en z-index 0, y un elemento posicionado
         pinta por encima del contenido sin posicionar aunque vaya antes en el
         documento. Por eso el contenido tiene que subir explícitamente. -->
    <main class="relative z-[1]">
      <slot />
    </main>

    <footer class="relative z-[1] border-t border-white/5 px-6 py-10 lg:px-10">
      <div
        class="mx-auto flex max-w-[1400px] flex-col gap-6 text-sm text-tinta-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-3">
          <Marca clase="size-5 text-trazo-tenue" />
          <span>{t.armazon.licencia}</span>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            <a class="transition-colors hover:text-tinta-2" href={SOBRE_MI}>
              {t.armazon.sobreMi}
            </a>
          </li>
          <li>
            <a class="transition-colors hover:text-tinta-2" href={REPO}>
              {t.armazon.repositorio}
            </a>
          </li>
          <li>
            <a class="transition-colors hover:text-tinta-2" href={`${REPO}/releases`}>
              {t.armazon.versiones}
            </a>
          </li>
          <li>
            <a
              class="transition-colors hover:text-tinta-2"
              href={`${REPO}/blob/main/CHANGELOG.md`}
            >
              {t.armazon.cambios}
            </a>
          </li>
          <li>
            <a
              class="transition-colors hover:text-tinta-2"
              href={`${REPO}/blob/main/ROADMAP.md`}
            >
              {t.armazon.hojaDeRuta}
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
