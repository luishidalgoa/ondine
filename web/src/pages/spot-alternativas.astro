---
import Base from "../layouts/Base.astro";
import Spot from "../components/Spot.astro";
import SpotEmergente from "../components/SpotEmergente.astro";

// Página de comparación, no forma parte del sitio y no se enlaza. Existe solo
// para elegir entre las dos formas del módulo de vídeo viéndolas seguidas.
// Cuando esté decidida, esta página se borra y la que gane se queda en la
// portada.
---

<Base
  titulo="Spot · dos alternativas"
  descripcion="Comparación de las dos formas del módulo de vídeo."
>
  <div class="rotulo-alt">
    <span class="letra">A</span>
    <div>
      <h3>Se endereza</h3>
      <p>
        Entra girada y se pone recta al aparecer. Ocupa lo que ocupa cualquier
        otra sección, no ancla el scroll y se pasa de largo en un gesto. Es la
        opción sobria.
      </p>
    </div>
  </div>

  <Spot />

  <div class="rotulo-alt">
    <span class="letra">B</span>
    <div>
      <h3>Emerge</h3>
      <p>
        Sale desde detrás de la biblioteca mientras bajas, y el primer plano se
        mueve al revés que el vídeo. Ancla el scroll durante dos pantallas y
        media, así que obliga a pararse. Es la opción de más efecto y la que
        más tiempo pide al visitante.
      </p>
    </div>
  </div>

  <SpotEmergente />
</Base>

<style>
  .rotulo-alt {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.07);
  }
  @media (min-width: 1024px) {
    .rotulo-alt { padding-left: 2.5rem; padding-right: 2.5rem; }
  }

  .letra {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 999px;
    background: rgb(150 138 224 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(150 138 224 / 0.42);
    font-family: var(--font-mono);
    font-size: 16px;
    color: #b5abfc;
  }

  .rotulo-alt h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .rotulo-alt p {
    margin-top: 0.5rem;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.6;
    color: #8a8fa3;
  }
</style>
