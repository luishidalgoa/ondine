---
import "../styles/global.css";
import Fondos from "../components/Fondos.astro";
import Marca from "../components/Marca.astro";

// Página para elegir fondo. No se enlaza desde el sitio. Se prueban sobre el
// contenido real del hero, porque un fondo no se juzga solo: se juzga por si
// deja leer lo que lleva encima.
//
// Los cinco se mueven. Solo dibuja el que está encendido: los de lienzo paran
// su bucle y los de CSS quedan ocultos, así que no hay cinco fondos
// animándose a la vez detrás de nada.
const OPCIONES = [
  {
    id: "a",
    nombre: "Retícula",
    idea: "La cuadrícula de una herramienta de precisión, con una luz que la recorre muy despacio.",
    pro: "La más sobria y la más barata. Sólo CSS, cero lienzo, cero cálculo por fotograma.",
    contra: "No dice nada de Ondine en concreto. Podría ser el fondo de cualquier herramienta.",
  },
  {
    id: "b",
    nombre: "Ondas",
    idea: "La marca a tamaño de pantalla: arriba ondula y según se baja se aplana hasta quedar recta.",
    pro: "Es el logotipo hecho fondo. Cuenta lo que hace el producto sin escribir una palabra.",
    contra: "Es el que más presencia tiene. Si el contenido de encima es denso, compite.",
  },
  {
    id: "c",
    nombre: "Partículas",
    idea: "Van sueltas, se alinean en filas, aguantan un momento y se vuelven a soltar.",
    pro: "El argumento entero en bucle: lo que entra revuelto sale ordenado.",
    contra: "El más caro de los cuatro, y el movimiento se nota aunque estés leyendo otra cosa.",
  },
  {
    id: "d",
    nombre: "Profundidad",
    idea: "Una respiración muy lenta y grano de película, saltando a ocho pasos por segundo.",
    pro: "El grano es lo que le quita a un fondo oscuro el aspecto de plano digital.",
    contra: "Puede leerse como que no hay fondo. Es la opción de no arriesgar.",
  },
  {
    id: "e",
    nombre: "Gradiente",
    idea: "Tres manchas grandes y difuminadas, cada una con su recorrido y su duración.",
    pro: "El más suave de los cinco y el que mejor deja leer lo que lleva encima. Como las duraciones no son múltiplos entre sí, el bucle no se ve nunca.",
    contra: "Es la familia del fondo por defecto de cualquier página generada. Solo se salva porque usa los morados de la marca y ningún tono inventado; con otra paleta sería intercambiable con miles de sitios.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>Fondos · cinco pruebas</title>
  </head>
  <body data-fondo="b">
    <Fondos />

    <!-- Muestra: el hero de verdad, para ver si el fondo deja leer -->
    <section class="muestra">
      <div class="texto">
        <div class="firma">
          <Marca clase="size-6 text-acento" titulo="Ondine" />
          <span>Ondine</span>
        </div>
        <h1 class="acero titular">Ordena bibliotecas de series y películas</h1>
        <p class="bajada">
          Cada capítulo con su título, su número y su temporada. Escrito como
          los metadatos esperan encontrarlo.
        </p>
        <div class="botones">
          <span class="primario">Descargar para Windows</span>
          <span class="secundario">Instalar por terminal</span>
        </div>
      </div>
    </section>

    <!-- Selector -->
    <div class="selector">
      {
        OPCIONES.map((o) => (
          <button type="button" data-elige={o.id}>
            <span class="letra">{o.id.toUpperCase()}</span>
            {o.nombre}
          </button>
        ))
      }
    </div>

    <section class="fichas-tecnicas">
      {
        OPCIONES.map((o) => (
          <article>
            <h2>
              <span class="letra">{o.id.toUpperCase()}</span>
              {o.nombre}
            </h2>
            <p class="idea">{o.idea}</p>
            <p class="pro">{o.pro}</p>
            <p class="contra">{o.contra}</p>
          </article>
        ))
      }
    </section>

    <script>
      const botones = document.querySelectorAll<HTMLButtonElement>("[data-elige]");
      const marcar = () => {
        const activo = document.body.dataset.fondo;
        botones.forEach((b) =>
          b.classList.toggle("activo", b.dataset.elige === activo),
        );
      };
      botones.forEach((b) =>
        b.addEventListener("click", () => {
          document.body.dataset.fondo = b.dataset.elige!;
          marcar();
        }),
      );
      marcar();
    </script>

    <style>
      .muestra {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        padding: 5rem 1.5rem 9rem;
      }
      @media (min-width: 1024px) { .muestra { padding-inline: 2.5rem; } }

      .texto { max-width: 1400px; margin: 0 auto; width: 100%; }

      .firma {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 17px;
        font-weight: 500;
        letter-spacing: 0.01em;
      }

      .titular {
        margin-top: 2rem;
        max-width: 11.5em;
        font-size: clamp(38px, 5.4vw, 60px);
        line-height: 1.05;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      .bajada {
        margin-top: 1.5rem;
        max-width: 21em;
        font-size: clamp(17px, 1.5vw, 21px);
        line-height: 1.55;
        color: #c9ccd6;
      }

      .botones { margin-top: 2.25rem; display: flex; flex-wrap: wrap; gap: 1rem; }

      .primario,
      .secundario {
        border-radius: 999px;
        padding: 0.9rem 1.75rem;
        font-size: 15px;
        font-weight: 500;
      }
      .primario { background: #968ae0; color: #12101f; }
      .secundario {
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
        color: #c9ccd6;
      }

      /* ── selector ─────────────────────────────────────────────────────── */
      .selector {
        position: fixed;
        z-index: 30;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.35rem;
        padding: 0.4rem;
        border-radius: 999px;
        background: rgb(22 24 38 / 0.86);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
        backdrop-filter: blur(10px);
      }

      .selector button {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1rem;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #8a8fa3;
        font-family: inherit;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
      }
      .selector button:hover { color: #e9e9ed; }
      .selector button.activo {
        background: rgb(150 138 224 / 0.16);
        color: #e9e9ed;
      }

      .letra {
        font-family: var(--font-mono);
        font-size: 11px;
        color: #968ae0;
      }

      /* ── fichas técnicas ──────────────────────────────────────────────── */
      .fichas-tecnicas {
        position: relative;
        z-index: 1;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.5rem 9rem;
        display: grid;
        gap: 1rem;
      }
      @media (min-width: 900px) {
        .fichas-tecnicas {
          grid-template-columns: repeat(2, 1fr);
          padding-inline: 2.5rem;
        }
      }

      .fichas-tecnicas article {
        padding: 1.35rem 1.4rem;
        border-radius: 12px;
        background: rgb(35 37 50 / 0.82);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
        backdrop-filter: blur(4px);
      }

      .fichas-tecnicas h2 {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 17px;
        font-weight: 500;
      }

      .idea { margin-top: 0.7rem; font-size: 15px; line-height: 1.6; color: #c9ccd6; }

      .pro,
      .contra {
        margin-top: 0.6rem;
        padding-left: 1.3rem;
        position: relative;
        font-size: 14px;
        line-height: 1.55;
        color: #8a8fa3;
      }
      .pro::before,
      .contra::before {
        position: absolute;
        left: 0;
        font-family: var(--font-mono);
        font-size: 12px;
      }
      .pro::before { content: "+"; color: #5db872; }
      .contra::before { content: "-"; color: #c64545; }
    </style>
  </body>
</html>
