<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0 "a secas": las reglas del motor no dependen de Windows ni de WPF -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>reindex-tests</AssemblyName>
    <RootNamespace>Ondine.Reindex.Tests</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Se referencia el motor. Antes se enlazaban sus fuentes fichero a fichero desde el
    proyecto WPF, porque `Ondine` apunta a net9.0-windows y no compila fuera de Windows
    mientras que estas reglas sí. Ahora el motor es `Ondine.Core`, que ya es net9.0 a
    secas: la referencia vale y desaparece la lista que había que mantener a mano.

    Sigue sin haber un solo paquete NuGet, para que CI no restaure nada.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ondine.Core\Ondine.Core.csproj" />
    <!--
      Y el servidor MCP, para poder EJECUTAR sus herramientas en vez de leer su codigo. Es un
      Exe, y referenciarlo vale: cada proyecto conserva su propio punto de entrada.
    -->
    <ProjectReference Include="..\..\src\Ondine.Mcp\Ondine.Mcp.csproj" />
  </ItemGroup>

</Project>
