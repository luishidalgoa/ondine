<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0 "a secas": las reglas del motor no dependen de Windows ni de WPF -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>reindex-tests</AssemblyName>
    <RootNamespace>Ondine.Reindex.Tests</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Se ENLAZAN las fuentes del motor en vez de referenciar el proyecto WPF: Ondine
    apunta a net9.0-windows y no compila fuera de Windows, mientras que estas reglas sí.
    Mismo patrón que Ondine.Cli, y sin paquetes NuGet para que CI no restaure nada.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Ondine\Reindex\*.cs" LinkBase="Reindex" />
    <!-- Igual que Reindex: lógica sin WPF ni ffmpeg, así que entra en el arnés y corre en CI. -->
    <Compile Include="..\..\src\Ondine\Pistas\*.cs" LinkBase="Pistas" />
    <!-- El resumen de una pista es texto de interfaz y sale del catálogo, así que las fuentes
         de Pistas ya no compilan sin él. Se enlazan `Idioma.cs` y los `Textos.*.cs` uno a uno
         y NO la carpeta entera: `T.cs` es la extensión de marcado y depende de WPF. -->
    <Compile Include="..\..\src\Ondine\Localizacion\Idioma.cs" LinkBase="Localizacion" />
    <Compile Include="..\..\src\Ondine\Settings.cs" LinkBase="Ajustes" />
    <Compile Include="..\..\src\Ondine\RenameRule.cs" LinkBase="Ajustes" />
    <Compile Include="..\..\src\Ondine\Preset.cs" LinkBase="Ajustes" />
    <Compile Include="..\..\src\Ondine\Localizacion\Textos.*.cs" LinkBase="Localizacion" />
    <!-- Dónde viven los datos del usuario, y la mudanza de la carpeta al cambiar de nombre.
         ReindexStore depende de esto: sin enlazarlo no compila ni el arnés ni la CLI. -->
    <Compile Include="..\..\src\Ondine\Rutas\*.cs" LinkBase="Rutas" />
  </ItemGroup>

</Project>
