<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:o="clr-namespace:Ondine.Ava">

  <!--
    Los campos: caja de texto, casilla y desplegable.

    Van como estilos IMPLICITOS -sin x:Key- y no como ControlTheme con nombre, al reves que
    los botones. El motivo es que en el XAML de WPF estos tres se usan a pelo: `<TextBox/>`,
    `<CheckBox .../>`, `<ComboBox .../>`, sin Style. Si aqui pidieran un Theme por nombre,
    cada uno de los cientos que hay en las dieciocho pantallas habria que tocarlo al portar,
    y el que se olvidara saldria con el aspecto de Fluent sin que nada lo dijera.

    Asi el puerto de cada pantalla es copiar el XAML y traducir lo que cambia, no repasar
    control por control.
  -->

  <!-- ══ Caja de texto ═════════════════════════════════════════════════════════ -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Neutral800}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Accent800}"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="caja"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6">
          <Panel>
            <!-- El texto de ayuda: se ve solo con la caja vacia. En WPF esto era un
                 DataTrigger sobre Text.IsEmpty; aqui hay una pseudoclase para ello. -->
            <TextBlock Name="pista"
                       Text="{TemplateBinding Watermark}"
                       Margin="{TemplateBinding Padding}"
                       Foreground="{StaticResource Neutral600}"
                       IsVisible="False"
                       VerticalAlignment="Center"/>
            <TextPresenter Name="PART_TextPresenter"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           CaretBrush="{TemplateBinding CaretBrush}"
                           SelectionBrush="{TemplateBinding SelectionBrush}"
                           SelectionStart="{TemplateBinding SelectionStart}"
                           SelectionEnd="{TemplateBinding SelectionEnd}"
                           TextWrapping="{TemplateBinding TextWrapping}"
                           Margin="{TemplateBinding Padding}"
                           VerticalAlignment="Center"/>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:empty /template/ TextBlock#pista">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="^:pointerover /template/ Border#caja">
      <Setter Property="BorderBrush" Value="{StaticResource Neutral700}"/>
    </Style>

    <!-- Con el foco, el acento. Es la unica pista de donde esta escribiendo uno cuando
         hay seis campos en la misma fila, que es el caso de Comprimir. -->
    <Style Selector="^:focus /template/ Border#caja">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style Selector="^:disabled /template/ Border#caja">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
  </ControlTheme>

  <!-- ══ Casilla ═══════════════════════════════════════════════════════════════ -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Neutral400}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>

    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
          <Border Name="marco" Width="15" Height="15" CornerRadius="4"
                  VerticalAlignment="Center"
                  Background="{StaticResource Field}"
                  BorderBrush="{StaticResource Neutral700}" BorderThickness="1">
            <Path Name="tic" Stretch="Uniform" Margin="3"
                  Data="M 0,4 L 3,7 L 9,0"
                  Stroke="{StaticResource Accent}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="False"/>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Path#tic">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:checked /template/ Border#marco">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#marco">
      <Setter Property="BorderBrush" Value="{StaticResource Neutral500}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
  </ControlTheme>

  <!-- ══ Desplegable ═══════════════════════════════════════════════════════════
       NO ESTA AQUI, y el motivo merece leerse: era un ControlTheme con diez Setters de
       color y sin plantilla, y un ControlTheme sin plantilla deja al control SIN NINGUNA.
       Los nueve desplegables de la ventana principal salieron como huecos vacios debajo de
       su rotulo, y Preferencias sin forma de elegir idioma. Compilaba perfectamente.

       Lo que solo cambia valores va como Style, que se aplica ENCIMA en vez de sustituir:
       Temas/Estilos.axaml. -->


  <!-- ══ Una fila del desplegable de sugerencias ═══════════════════════════════
       Va con nombre y no como estilo implicito a proposito: se lo pone SOLO la lista de
       sugerencias. Las demas listas de la app tienen su propia forma -filas de dos
       lineas, insignias- y heredar esta las estropearia.

       Sin esto la lista sale con el resaltado azul de Fluent, que no es de esta app.
       El elegido lleva Accent900 y no el azul del sistema, igual que en WPF. -->
  <ControlTheme x:Key="SuggestItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b" Background="Transparent" CornerRadius="5"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#b">
      <Setter Property="Background" Value="{StaticResource RowHover}"/>
    </Style>
    <!-- El elegido va DESPUES del raton: moverse con las flechas tiene que verse aunque
         el raton se haya quedado parado encima de otra fila. -->
    <Style Selector="^:selected /template/ Border#b">
      <Setter Property="Background" Value="{StaticResource Accent900}"/>
    </Style>
  </ControlTheme>

  <!-- ══ Caja de texto con icono ═══════════════════════════════════════════════
       El CampoTexto: un TextBox de verdad con un dibujo a la izquierda. Va como estilo
       implicito, igual que los demas campos, para que ponerlo en una pantalla sea escribir
       el control y ya.

       LO QUE NO SE PORTA, y conviene decirlo: en WPF este campo llevaba un «haz» de foco
       -un degradado girando por el borde, con cache de mapa de bits y un desenfoque
       encima-. Eso es maquinaria de WPF y su equivalente aqui seria una animacion escrita a
       mano para un adorno. El foco se marca con el acento, igual que en el resto de campos
       de esta interfaz: la pantalla queda coherente consigo misma, que importa mas que
       quedar identica a la otra. -->
  <ControlTheme x:Key="{x:Type o:CampoTexto}" TargetType="o:CampoTexto">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="110"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
          <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*">
            <!-- Sin icono no se reserva su hueco: el texto empieza donde el de un campo
                 normal. En WPF era un Trigger sobre Icono = null; aqui basta con atar la
                 visibilidad a que haya algo que dibujar. -->
            <Path Name="icono" Width="14" Height="14" Margin="0,0,8,0"
                  VerticalAlignment="Center" Stretch="Uniform"
                  Data="{TemplateBinding Icono}"
                  Stroke="{StaticResource Neutral500}" StrokeThickness="1.4"
                  StrokeJoin="Round"
                  IsVisible="{Binding Icono, RelativeSource={RelativeSource TemplatedParent},
                                      Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextPresenter Name="PART_TextPresenter" Grid.Column="1"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           CaretBrush="{TemplateBinding CaretBrush}"
                           SelectionBrush="{StaticResource Accent800}"
                           SelectionStart="{TemplateBinding SelectionStart}"
                           SelectionEnd="{TemplateBinding SelectionEnd}"
                           VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#b">
      <Setter Property="BorderBrush" Value="{StaticResource Neutral700}"/>
    </Style>
    <Style Selector="^:focus /template/ Border#b">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#b">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
  </ControlTheme>

</ResourceDictionary>
