<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Lo que se comparte entre la pantalla del encargo y la de Organizar.

    Estos dos estaban en ThemeOrganizar.xaml, el segundo diccionario de tema de WPF -el
    que el termometro no miraba-. Se portan aqui y no en Botones/Campos porque no son
    controles de base: son piezas de las pantallas de Organizar, y tenerlos juntos dice de
    donde vienen.
  -->

  <!-- ══ Chip de filtro ════════════════════════════════════════════════════════
       Un ToggleButton que se rellena al estar activo. El rotulo lleva su propio color de
       estado, asi que el filtro activo NO depende del color para leerse: tambien cambia
       el relleno y el borde. -->
  <ControlTheme x:Key="FiltroChip" TargetType="ToggleButton">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="Foreground" Value="{StaticResource Neutral400}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="b"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="7"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#b">
      <Setter Property="Opacity" Value="0.82"/>
    </Style>
    <Style Selector="^:checked /template/ Border#b">
      <Setter Property="Background" Value="{StaticResource Accent800}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#b">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
  </ControlTheme>

  <!-- ══ Rotulo de campo ═══════════════════════════════════════════════════════
       El texto pequeno que va encima de cada caja.

       En WPF heredaba de TextoRecortable, un estilo que le pone al TextBlock un tooltip
       con su propio texto para cuando se recorta. Eso NO se hereda aqui: Avalonia si
       distingue si el texto se ha recortado de verdad, asi que poner el tooltip a todo lo
       que PUEDE recortarse -que es lo que hacia WPF, y luego lo cancelaba midiendo a
       mano- sobra. Queda pendiente en su sitio, no colado dentro de este. -->
  <ControlTheme x:Key="OrgLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Neutral500}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </ControlTheme>

  <!-- ══ Tarjeta de la pagina ══════════════════════════════════════════════════
       La caja que agrupa un bloque de la pantalla de inicio. Es solo geometria y color, asi
       que se traduce tal cual. -->
  <!-- SIN BasedOn, al contrario que los temas de la tabla. La regla no es «siempre
       BasedOn»: es «hereda quien tenga algo que heredar». Un Border no es un control con
       plantilla, asi que Fluent no le da ningun tema de serie — y pedirlo revienta al
       arrancar con «Static resource Avalonia.Controls.Border not found», que no dice
       exactamente eso. Aqui solo hay Setters, asi que no hace falta nada. -->
  <ControlTheme x:Key="OrgCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </ControlTheme>

  <!-- ══ Texto atenuado ════════════════════════════════════════════════════════
       Como OrgLabel: en WPF heredaba de TextoRecortable, que le ponia un tooltip con su
       propio texto para cuando se recorta. Aqui no se hereda, por lo mismo — Avalonia si
       distingue si un texto se ha recortado de verdad. -->
  <ControlTheme x:Key="OrgMuted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Neutral500}"/>
    <Setter Property="FontSize" Value="12"/>
  </ControlTheme>

</ResourceDictionary>
