<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Ava.Localizacion"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:o="clr-namespace:Ondine.Ava"
        x:Class="Ondine.Ava.Reproductor"
        Title="{i:T ReproductorTitulo}"
        Width="1120" Height="680" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="#08090F" Foreground="{StaticResource Text}">

  <!--
    Reproductor integrado, portado de ReproductorWindow.xaml.

    LA PIEZA CENTRAL CAMBIA: donde habia un MediaElement -los codecs del sistema- hay un
    VideoView de LibVLC. Y eso no es un cambio de nombre, se lleva por delante una pantalla
    entera del original:

    En WPF, un AV1 o un HEVC daban pantalla negra porque Windows no los trae de fabrica, asi
    que habia (a) un aviso que recomendaba instalar la extension de la tienda y (b) un «modo
    fotogramas» que recorria el video sacando cuadros con ffmpeg, sin sonido ni reproduccion
    seguida, para al menos contestar «¿que capitulo es?». LibVLC decodifica los tres, asi que
    ese plan B pierde su razon de ser y no se porta. Lo que si queda es el panel de fallo
    generico: si aqui algo no se abre, se dice y se ofrece el reproductor del sistema.
  -->
  <Grid Name="raiz" Background="#08090F">
    <!--
      TODO LO QUE VA ENCIMA DEL VIDEO VA DENTRO DE VideoView.Content, y no como hermano.

      VideoView es un NativeControlHost: una ventana del sistema metida en la nuestra. Y una
      ventana nativa se pinta ENCIMA de todo lo que dibuja Avalonia, diga lo que diga el orden
      del XAML o el ZIndex. Puestos como hermanos, los controles no se veian y no recibian el
      raton: el titulo, el transporte, la barra de posicion y el lienzo de clic quedaban
      tapados por el video.

      LibVLCSharp trae Content precisamente para esto: lo que se le da se pinta en una capa
      por encima del video nativo. Compilaba igual de las dos formas, y de una de ellas no se
      veia nada.
    -->
    <vlc:VideoView Name="video">
      <vlc:VideoView.Content>
        <Grid Name="encimaDelVideo">

        <!-- Capta el clic sobre el video (play/pausa) y el doble clic (pantalla completa).
             Va por debajo de las capas de control, asi que estas reciben los suyos primero. -->
        <Panel Name="lienzo" Background="Transparent"/>

        <!-- La espera. Encima del video y por debajo de los controles. -->
        <o:CirculosCargando Name="cargando"/>

        <!-- Si no se puede abrir, se dice y se ofrece el reproductor del sistema: mejor un plan
             B claro que una pantalla negra sin explicacion. -->
        <StackPanel Name="panelFallo" IsVisible="False" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MaxWidth="460">
          <TextBlock Name="lblFallo" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5"
                     Foreground="{StaticResource Neutral400}" LineHeight="19"/>
          <Button Name="btnSistema" Theme="{StaticResource BtnPrimary}" Margin="0,14,0,0"
                  HorizontalAlignment="Center" Content="{i:T ReproductorAbrirEnSistema}"/>
        </StackPanel>

        <!-- ══ Capa superior: titulo y cierre ══ -->
        <Grid Name="capaSuperior" VerticalAlignment="Top" Height="88">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#C4000000" Offset="0"/>
              <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>
          </Grid.Background>
          <StackPanel Margin="18,11,120,0" VerticalAlignment="Top">
            <TextBlock Name="lblTitulo" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <!-- Aviso de fichero en la nube: explica el tiron antes de que desconcierte. -->
            <Border Name="chipNube" IsVisible="False" Margin="0,6,0,0" CornerRadius="5"
                    Background="#382B2741" BorderBrush="{StaticResource Accent700}" BorderThickness="1"
                    Padding="8,2.5" HorizontalAlignment="Left">
              <TextBlock Name="lblNube" FontSize="10.5" Foreground="{StaticResource Accent300}"/>
            </Border>
          </StackPanel>
          <Button Name="btnCerrar" Theme="{StaticResource BtnIcono}" Content="✕"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"/>
        </Grid>

        <!-- ══ Capa inferior: barra de posicion y transporte ══ -->
        <Grid Name="capaInferior" VerticalAlignment="Bottom" Height="150">
          <Grid.Background>
            <!-- El velo empieza a oscurecer ANTES de la fila de tiempos: medido sobre un
                 fotograma naranja, el texto de la duracion se quedaba en 2,6:1 de contraste
                 porque caia por encima de la parte oscura. -->
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#00000000" Offset="0"/>
              <GradientStop Color="#BF000000" Offset="0.38"/>
              <GradientStop Color="#F2000000" Offset="1"/>
            </LinearGradientBrush>
          </Grid.Background>

          <Grid Margin="18,0,18,16" VerticalAlignment="Bottom" RowDefinitions="Auto,Auto">

            <!-- fila 0: tiempo · barra · duracion -->
            <Grid Grid.Row="0" Margin="0,0,0,4" ColumnDefinitions="Auto,*,Auto">
              <TextBlock Name="lblPos" VerticalAlignment="Center" Margin="0,0,11,0" MinWidth="42"
                         TextAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11"
                         Foreground="#D6D9E8" Text="0:00"/>
              <Slider Name="barra" Grid.Column="1" Theme="{StaticResource BarraVideo}"
                      VerticalAlignment="Center"/>

              <!-- El globo de la previa vive en un lienzo de altura 0 sobre la barra, asi que
                   puede salirse hacia arriba y taparse el video sin empujar nada. -->
              <Canvas Name="capaPrevia" Grid.Column="1" Height="0" VerticalAlignment="Top"
                      IsHitTestVisible="False">
                <Border Name="globoPrevia" IsVisible="False" Background="#F00A0B14"
                        CornerRadius="6" Padding="3" BorderBrush="{StaticResource Accent700}"
                        BorderThickness="1">
                  <Panel>
                    <Image Name="imgPrevia" Width="192" Height="108" Stretch="UniformToFill"/>
                    <Border Background="#B0000000" CornerRadius="3" Padding="5,1"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5">
                      <TextBlock Name="lblPrevia" FontFamily="{StaticResource FontMono}"
                                 FontSize="11" Foreground="White" Text="0:00"/>
                    </Border>
                    <TextBlock Name="lblPreviaCargando" Text="…" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Neutral500}"/>
                  </Panel>
                </Border>
              </Canvas>

              <TextBlock Name="lblDur" Grid.Column="2" VerticalAlignment="Center" Margin="11,0,0,0"
                         MinWidth="42" FontFamily="{StaticResource FontMono}" FontSize="11"
                         Foreground="#B9BECF" Text="0:00"/>
            </Grid>

            <!-- fila 1: transporte al centro, volumen y pantalla completa a la derecha -->
            <Grid Grid.Row="1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Spacing="10">
                <Button Name="btnAtras" Theme="{StaticResource BtnIcono}"
                        ToolTip.Tip="{i:T ReproductorAtrasTip}">
                  <Path Data="M10,5 L4.5,10 L10,15 M16,5 L10.5,10 L16,15" Width="20" Height="20"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.9"
                        StrokeLineCap="Round" StrokeJoin="Round"/>
                </Button>

                <Button Name="btnPlay" Theme="{StaticResource BtnPlay}"
                        ToolTip.Tip="{i:T ReproductorPlayTip}">
                  <Path Name="glifoPlay" Stroke="White" StrokeThickness="3.2"
                        StrokeLineCap="Round" StrokeJoin="Round" Width="19" Height="20"
                        Data="M6,3 L6,17 M13,3 L13,17"/>
                </Button>

                <Button Name="btnAdelante" Theme="{StaticResource BtnIcono}"
                        ToolTip.Tip="{i:T ReproductorAdelanteTip}">
                  <Path Data="M10,5 L15.5,10 L10,15 M4,5 L9.5,10 L4,15" Width="20" Height="20"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.9"
                        StrokeLineCap="Round" StrokeJoin="Round"/>
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Spacing="2">
                <Button Name="btnMudo" Theme="{StaticResource BtnIcono}"
                        ToolTip.Tip="{i:T ReproductorMudoTip}">
                  <Path Name="glifoVol" Width="20" Height="20"
                        Fill="{Binding $parent[Button].Foreground}"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Data="M4,8 L7,8 L11,4.5 L11,15.5 L7,12 L4,12 Z"/>
                </Button>
                <Slider Name="volumen" Theme="{StaticResource BarraVolumen}" VerticalAlignment="Center"
                        Margin="0,0,8,0" Minimum="0" Maximum="1" Value="0.8"/>
                <Button Name="btnPantalla" Theme="{StaticResource BtnIcono}"
                        ToolTip.Tip="{i:T ReproductorPantallaTip}">
                  <Path Name="glifoPantalla" Width="20" Height="20"
                        Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Data="M3,7.5 L3,3 L7.5,3 M12.5,3 L17,3 L17,7.5 M17,12.5 L17,17 L12.5,17 M7.5,17 L3,17 L3,12.5"/>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        </Grid>
      </vlc:VideoView.Content>
    </vlc:VideoView>
  </Grid>
</Window>
