<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0 "a secas": compila y corre en Windows, Linux y macOS -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ondine</AssemblyName>
    <RootNamespace>Ondine</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Recorta el runtime: el binario pasa de ~68 MB a ~13 MB. Requiere que el JSON de
         ffprobe se deserialice con el contexto generado (FfProbeJsonContext), no por
         reflexión, o el recortador se lleva los tipos y el análisis devuelve datos vacíos. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <Version>1.12.0</Version>
    <Product>Ondine CLI</Product>
    <Company>luishidalgoa</Company>
    <Authors>luishidalgoa</Authors>
    <Description>Ondine CLI: cross-platform video compressor, running the same engine as the desktop app.</Description>
  </PropertyGroup>

  <!--
    El motor es un proyecto y se referencia.

    Antes se ENLAZABAN sus ficheros uno a uno desde la app WPF, que era la dueña de las
    fuentes. Aquello obligaba a acordarse de apuntar aquí cada carpeta nueva del motor, y
    la avería llegó: al añadir Pistas/ (quitar audio o subtítulos) el motor empezó a usar
    sus tipos y la CLI dejó de compilar en las cinco plataformas. Con una referencia de
    proyecto no hay lista que mantener y no puede repetirse.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Ondine.Core\Ondine.Core.csproj" />
  </ItemGroup>

</Project>
