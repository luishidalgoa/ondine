<UserControl x:Class="Ondine.OrganizarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ondine"
             xmlns:i="clr-namespace:Ondine.Localizacion"
             FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><!-- barra de contexto -->
      <RowDefinition Height="Auto"/><!-- resumen-filtro -->
      <RowDefinition Height="*"/>   <!-- inicio / revisión -->
      <RowDefinition Height="Auto"/><!-- acciones -->
    </Grid.RowDefinitions>

    <!-- ══════════════ Barra de contexto ══════════════ -->
    <!-- La carpeta ya no vive aquí: se eligió centralizarla en el panel de ficheros,
         que es donde se ve el recuento y donde está «Simular» — tres piezas de la misma
         acción repartidas por la pantalla eran información redundante. -->
    <Grid Grid.Row="0" Margin="16,4,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*" MinWidth="120"/>
      </Grid.ColumnDefinitions>

      <!-- De qué es esta carpeta. Va lo PRIMERO y no como una casilla más porque
           condiciona todo lo que hay a su derecha: una película no tiene catálogo,
           ni temporada, ni número, así que el resto de la fila sobra cuando se
           elige «Películas». Se recuerda por carpeta. -->
      <StackPanel Grid.Column="0" Margin="0,0,14,0">
        <TextBlock Text="{i:T OrganizarTipoBiblioteca}" Style="{StaticResource OrgLabel}"/>
        <ComboBox x:Name="cboTipo" Height="34" MinWidth="128" VerticalContentAlignment="Center"
                  ToolTip="{i:T OrganizarTipoBibliotecaAyuda}">
          <ComboBoxItem Content="{i:T OrganizarTipoSerie}" IsSelected="True"/>
          <ComboBoxItem Content="{i:T OrganizarTipoPelicula}"/>
        </ComboBox>
      </StackPanel>

      <!-- Serie (catálogo de referencia) -->
      <StackPanel x:Name="panelSerie" Grid.Column="1">
        <TextBlock Text="{i:T OrganizarSerie}" Style="{StaticResource OrgLabel}"/>
        <StackPanel Orientation="Horizontal">
          <!-- ItemTemplate explícito y no DisplayMemberPath: la plantilla propia del tema
               pinta la selección con SelectionBoxItemTemplate, y con DisplayMemberPath se
               quedaba sin plantilla y enseñaba el nombre del tipo. -->
          <ComboBox x:Name="cboSerie" MinWidth="110" MaxWidth="215" Height="34" VerticalContentAlignment="Center"
                    ToolTip="{i:T OrganizarSerieAyuda}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Serie}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="btnCatalogos" Style="{StaticResource BtnSecondary}" Height="34" Margin="6,0,0,0"
                  Content="{i:T OrganizarCatalogos}"
                  ToolTip="{i:T OrganizarCatalogosAyuda}"/>
          <!-- Verificar una propuesta sin abrir el JSON a mano: busca por número o título -->
          <Button x:Name="btnExplorar" Style="{StaticResource BtnSecondary}" Width="34" Height="34" Padding="0"
                  Margin="6,0,0,0" ToolTip="{i:T OrganizarExplorarAyuda}">
            <Viewbox Width="14" Height="14">
              <Path Data="M6.5 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9z M9.8 9.8 L13.5 13.5"
                    Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
            </Viewbox>
          </Button>
          <!-- En qué confía ESTE catálogo al identificar (se guarda por catálogo). -->
          <ComboBox x:Name="cboModo" Height="34" MinWidth="168" Margin="10,0,0,0" VerticalContentAlignment="Center"
                    ToolTip="{i:T OrganizarModoAyuda}">
            <ComboBoxItem Content="{i:T OrganizarModoAuto}" IsSelected="True"/>
            <ComboBoxItem Content="{i:T OrganizarModoNumero}"/>
          </ComboBox>
        </StackPanel>
      </StackPanel>

      <!-- Plantilla de biblioteca -->
      <StackPanel x:Name="panelPlantilla" Grid.Column="3">
        <TextBlock Text="{i:T OrganizarPlantilla}" Style="{StaticResource OrgLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <local:CampoTexto x:Name="txtPlantilla" HorizontalAlignment="Stretch" MinWidth="90"
                            FontFamily="{StaticResource FontMono}" FontSize="11.5"
                            Foreground="{StaticResource Neutral400}"
                            ToolTip="{i:T OrganizarPlantillaAyuda}"/>
          <!-- «Editar» no hacía nada que no hiciera pinchar en el propio campo. En su sitio,
               un desplegable que inserta las marcas y explica qué es cada una. -->
          <ToggleButton x:Name="btnMarcas" Grid.Column="1" Style="{StaticResource FiltroChip}"
                        Margin="6,0,0,0" Padding="10,7" VerticalAlignment="Center"
                        ToolTip="{i:T OrganizarMarcasAyuda}">
            <TextBlock><Run Text="{i:T OrganizarMarcas}"/><Run Text=" ▾" Foreground="{StaticResource Neutral500}"/></TextBlock>
          </ToggleButton>

          <Popup x:Name="popMarcas" PlacementTarget="{Binding ElementName=btnMarcas}" Placement="Bottom"
                 IsOpen="{Binding IsChecked, ElementName=btnMarcas, Mode=TwoWay}"
                 StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-260">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Neutral800}"
                    BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,12,12" MaxWidth="420">
              <StackPanel>
                <TextBlock Text="{i:T OrganizarMarcasCursor}" Style="{StaticResource OrgMuted}"
                           FontSize="11" Margin="8,4,8,6"/>
                <ItemsControl x:Name="listaMarcas">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource BtnGhostMuted}" HorizontalContentAlignment="Stretch"
                              Padding="8,6" Click="OnInsertarMarca" Tag="{Binding Marca}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Marca}" FontFamily="{StaticResource FontMono}"
                                       FontSize="12" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="{Binding Nombre}" Margin="10,0,0,0" FontSize="12"
                                       Foreground="{StaticResource Text}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Descripcion}" FontSize="11.5" TextWrapping="Wrap"
                                     Foreground="{StaticResource Neutral500}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Cómo queda de verdad, con un episodio real del catálogo elegido: sin esto hay
             que aplicar para descubrir qué produce la plantilla. -->
        <TextBlock x:Name="lblVistaPrevia" Margin="0,5,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Neutral500}" ToolTip="{i:T OrganizarVistaPreviaAyuda}"/>
      </StackPanel>
    </Grid>

    <!-- ══════════════ Resumen-filtro (solo en revisión) ══════════════ -->
    <Grid x:Name="filaChips" Grid.Row="1" Margin="16,0,16,10" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <!-- WrapPanel: los chips bajan de linea en vez de meterse debajo de los botones. -->
      <WrapPanel Orientation="Horizontal" x:Name="panelChips">
        <!-- Sin esto, una vez simulas te quedas en la tabla para siempre: no había forma de
             volver a la pantalla limpia salvo cambiar de página y regresar. -->
        <Button x:Name="btnVolver" Style="{StaticResource BtnSecondary}" FontSize="11.5"
                Padding="9,4" Margin="0,0,10,0" Content="{i:T OrganizarVolver}"
                ToolTip="{i:T OrganizarVolverAyuda}"/>
        <!-- Los cinco Runs nacen vacíos: el texto lleva el recuento dentro, así que lo
             escribe ActualizarContadores, y siempre antes de que esta fila se enseñe. -->
        <ToggleButton x:Name="chipLimpios" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="●" Foreground="#86D8A6"/><Run x:Name="runLimpios"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipCorregidos" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="↻" Foreground="#86D8A6"/><Run x:Name="runCorregidos"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipEspeciales" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="▲" Foreground="#E3C36B"/><Run x:Name="runEspeciales"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipConflictos" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="◆" Foreground="#EC9AA0"/><Run x:Name="runConflictos"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipErrores" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="✕" Foreground="#EC9AA0"/><Run x:Name="runErrores"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipDudas" Style="{StaticResource FiltroChip}" Content="{i:T OrganizarSoloDudas}" Margin="6,0,0,0"
                      ToolTip="{i:T OrganizarSoloDudasAyuda}"/>
      </WrapPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <!-- Buscar dentro de la tabla (Ctrl+K). Filtra por el nombre original Y por la
             propuesta, con la misma normalización del identificador: sin tildes y a medias. -->
        <local:CampoTexto x:Name="txtBuscarTabla" Width="200" Margin="0,0,8,0"
                          Icono="M6.5 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9z M9.8 9.8 L13.5 13.5"
                          ToolTip="{i:T OrganizarBuscarAyuda}"/>
        <Button x:Name="btnAceptarVerdes" Style="{StaticResource BtnSecondary}" Content="{i:T OrganizarAceptarVerdes}"
                Padding="10,5" FontSize="12"
                ToolTip="{i:T OrganizarAceptarVerdesAyuda}"/>
        <Button x:Name="btnConfirmarEspeciales" Style="{StaticResource BtnSecondary}" Content="{i:T OrganizarConfirmarEspeciales}"
                Padding="10,5" FontSize="12" Margin="8,0,0,0"
                ToolTip="{i:T OrganizarConfirmarEspecialesAyuda}"/>
      </StackPanel>
    </Grid>

    <!-- ══════════════ INICIO: catálogos + ficheros ══════════════ -->
    <!-- La biblioteca de películas tiene su propio flujo y su propio componente:
         ni catálogo, ni plantilla, ni temporadas, ni segmentos. Ocupa las filas
         de contenido y acciones enteras, en vez de esconder media pantalla. -->
    <!-- La fila 2 es «inicio / revisión», y el panel de películas es el inicio DEL
         flujo de películas: ocupa la misma fila que vistaInicio y no tres, para que
         los chips (fila 1) y las acciones (fila 3) sean suyas también. -->
    <local:PeliculasPanel x:Name="vistaPeliculas" Grid.Row="2"
                          Visibility="Collapsed"/>

    <!-- ══ Chips de películas: mismo sitio y misma forma que los de series ══
         Llevan el recuento dentro y filtran la tabla. Con glifo además de color:
         un chip que solo se distingue por el color no se distingue para quien no
         distingue esos dos colores. -->
    <Grid x:Name="filaChipsPelis" Grid.Row="1" Margin="16,0,16,10" Visibility="Collapsed">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="btnVolverPelis" Style="{StaticResource BtnSecondary}" FontSize="11.5"
                Padding="9,4" Margin="0,0,10,0" Content="{i:T OrganizarVolver}"
                ToolTip="{i:T OrganizarVolverAyuda}"/>
        <ToggleButton x:Name="chipColocan" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="●" Foreground="#86D8A6"/><Run x:Name="runColocan"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipRenombran" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="↻" Foreground="#86D8A6"/><Run x:Name="runRenombran"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipMirar" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="◆" Foreground="#EC9AA0"/><Run x:Name="runMirar"/></TextBlock>
        </ToggleButton>
        <ToggleButton x:Name="chipQuietas" Style="{StaticResource FiltroChip}">
          <TextBlock><Run Text="✓" Foreground="#8A8F98"/><Run x:Name="runQuietas"/></TextBlock>
        </ToggleButton>
      </WrapPanel>
    </Grid>

    <Grid x:Name="vistaInicio" Grid.Row="2" Margin="16,0,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Catálogos importados -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceGlass}" CornerRadius="8" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="lblTituloCatalogos" Text="{i:T OrganizarCatalogosImportados}" FontSize="11" FontWeight="Medium"
                       Margin="0,0,8,0" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <!-- La ayuda del formato va SIEMPRE visible, no solo cuando no hay catálogos:
                 la duda «¿y esto cómo se escribe?» aparece justo al ir a importar. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="btnFormato" Style="{StaticResource BtnGhost}" Padding="8,5" FontSize="12"
                      Content="{i:T OrganizarQueFormato}" Margin="0,0,8,0"
                      ToolTip="{i:T OrganizarQueFormatoAyuda}"/>
              <Button x:Name="btnEjemplo" Style="{StaticResource BtnSecondary}" Padding="10,5" FontSize="12"
                      Content="{i:T OrganizarCrearEjemplo}" Margin="0,0,8,0"
                      ToolTip="{i:T OrganizarCrearEjemploAyuda}"/>
              <Button x:Name="btnPrompt" Style="{StaticResource BtnSecondary}" Padding="10,5" FontSize="12"
                      Content="{i:T OrganizarGenerarIA}" Margin="0,0,8,0"
                      ToolTip="{i:T OrganizarGenerarIAAyuda}"/>
              <Button x:Name="btnImportar" Style="{StaticResource BtnSecondary}"
                      Padding="10,5" FontSize="12"
                      ToolTip="{i:T OrganizarImportarAyuda}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                    <Path Data="M8 2v8M5 7l3 3 3-3M2.5 13h11" Stroke="{StaticResource Text}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                  </Viewbox>
                  <TextBlock Text="{i:T OrganizarImportarJson}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Horizontal en «Disabled», no en «Hidden»: con Hidden el contenido se mide con
               ancho infinito y las advertencias nunca llegan a ajustarse — se cortaban. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl x:Name="listaCatalogos">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Tarjeta de catálogo. Las ADVERTENCIAS van dentro y siempre visibles:
                         son lo que evita que el usuario confíe de más en el resultado. -->
                    <Border Style="{StaticResource OrgCard}" Background="{Binding Fondo}"
                            BorderBrush="{Binding Borde}">
                      <!-- El clic derecho lleva AL FICHERO: la app ya no guarda copia, así
                           que ver dónde vive y poder saltar ahí es parte del trato. -->
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{i:T OrganizarAbrirUbicacion}"
                                    Click="OnUbicacionCatalogo" Tag="{Binding Cat.Ruta}"/>
                          <MenuItem Header="{i:T OrganizarCopiarRuta}"
                                    Click="OnCopiarRutaCatalogo" Tag="{Binding Cat.Ruta}"/>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <StackPanel>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <!-- El texto tiene SU columna y se recorta. Grid y NO StackPanel
                               horizontal: el StackPanel mide con ancho infinito, el recorte
                               nunca actúa y el texto seguía corriendo bajo los botones —
                               la misma trampa que ya mordió tres veces en este fichero. -->
                          <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Cat.Serie}" FontSize="13.5" FontWeight="Medium"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Cat.Resumen}" Style="{StaticResource OrgMuted}"
                                       FontSize="11.5" Margin="10,1,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                          </Grid>
                          <!-- Los tres en UNA fila. Antes iban alineados a la derecha en la
                               misma celda: «seleccionado» y «Usar» son excluyentes y no
                               chocaban, pero «Quitar» sale siempre y quedaba encima de ambos.
                               Con fondo sólido, además: transparentes sobre el título de al
                               lado no había quien los leyera. -->
                          <StackPanel Orientation="Horizontal" Grid.Column="1"
                                      VerticalAlignment="Center">
                            <Border Background="{StaticResource Accent800}" CornerRadius="6" Padding="8,2"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding Seleccionado, Converter={StaticResource B2V}}">
                              <TextBlock Text="{i:T OrganizarSeleccionado}" FontSize="10.5"
                                         Foreground="{StaticResource Accent200}"/>
                            </Border>
                            <Button Content="{i:T OrganizarUsar}" Style="{StaticResource BtnCristal}" FontSize="11.5"
                                    Padding="10,3" Margin="0,0,6,0" Tag="{Binding Cat.Ruta}"
                                    Click="OnUsarCatalogo"
                                    Visibility="{Binding NoSeleccionado, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource BtnCristal}" FontSize="11.5" Padding="10,3"
                                    Content="{i:T Quitar}" Tag="{Binding Cat.Ruta}"
                                    Click="OnQuitarCatalogo"
                                    ToolTip="{i:T OrganizarQuitarCatalogoAyuda}"/>
                          </StackPanel>
                        </Grid>

                        <!-- Dónde vive el JSON que la app lee (ya no hay copia). Es un botón:
                             pulsar abre la carpeta con el fichero seleccionado. -->
                        <Button Style="{StaticResource BtnGhostMuted}" Padding="0" Margin="0,0,0,6"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Click="OnUbicacionCatalogo" Tag="{Binding Cat.Ruta}"
                                ToolTip="{Binding Cat.ProcedenciaDetalle}">
                          <TextBlock Text="{Binding Cat.Procedencia}" Style="{StaticResource OrgMuted}"
                                     FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Cat.Advertencias}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <!-- Grid y no StackPanel horizontal: un StackPanel horizontal mide a
                                   sus hijos con ancho infinito, así que TextWrapping no llega a
                                   actuar nunca y la advertencia salía cortada. -->
                              <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="▲" Foreground="{StaticResource OrgWarn}" FontSize="10.5"
                                           Margin="0,1,6,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource OrgWarn}"
                                           FontSize="11.5" TextWrapping="Wrap"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Sin catálogos: se explica qué es antes de pedir nada -->
              <StackPanel x:Name="panelSinCatalogos" Margin="0,10,0,0" Visibility="Collapsed">
                <!-- Los párrafos van partidos en Runs porque llevan una palabra destacada
                     dentro. Los dos últimos citan el rótulo de un botón: van con la MISMA
                     clave que el botón, así que no pueden descuadrarse al traducirse. -->
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Neutral400}" FontSize="12.5" LineHeight="19">
                  <Run Text="{i:T OrganizarSinCatalogos1a}"/><Run FontWeight="Medium" Foreground="{StaticResource Text}" Text="{i:T OrganizarSinCatalogosPalabra}"/><Run Text="{i:T OrganizarSinCatalogos1b}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Neutral500}" FontSize="12"
                           Margin="0,10,0,0" LineHeight="18">
                  <!-- «reindex/1.0» es el identificador del esquema: va tal cual en los dos
                       idiomas, y por eso es lo único que sigue escrito aquí dentro. -->
                  <Run Text="{i:T OrganizarSinCatalogos2a}"/><Run FontFamily="{StaticResource FontMono}">reindex/1.0</Run><Run Text="{i:T OrganizarSinCatalogos2b}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Neutral500}" FontSize="12"
                           Margin="0,10,0,0" LineHeight="18">
                  <Run Text="{i:T OrganizarSinCatalogos3a}"/><Run FontWeight="Medium" Foreground="{StaticResource Accent}" Text="{i:T OrganizarCrearEjemplo}"/><Run Text="{i:T OrganizarSinCatalogos3b}"/><Run FontWeight="Medium" Foreground="{StaticResource Accent}" Text="{i:T OrganizarQueFormato}"/><Run Text="{i:T OrganizarSinCatalogos3c}"/>
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Ficheros -->
      <Border Grid.Column="2" Background="{StaticResource SurfaceGlass}" CornerRadius="8" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{i:T OrganizarFicheros}" FontSize="11" FontWeight="Medium"
                     Foreground="{StaticResource Neutral500}" Margin="0,0,0,12"/>

          <Grid Grid.Row="1">
            <!-- Trazo discontinuo del diseño: marca «aquí falta algo» sin pesar como un marco
                 sólido. Border no sabe hacer guiones, así que va un Rectangle detrás. -->
            <Rectangle Stroke="{StaticResource Neutral800}" StrokeThickness="1" RadiusX="8" RadiusY="8"
                       StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
            <!-- El haz que rodea el panel mientras identifica. Lo enciende el código. -->
            <Border x:Name="hazFicheros" Style="{StaticResource HazDeBorde}" CornerRadius="8">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <LinearGradientBrush.RelativeTransform>
                    <RotateTransform CenterX="0.5" CenterY="0.5"/>
                  </LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#00968AE0" Offset="0.00"/>
                  <GradientStop Color="#33968AE0" Offset="0.34"/>
                  <GradientStop Color="#FFD2CEFD" Offset="0.50"/>
                  <GradientStop Color="#33968AE0" Offset="0.66"/>
                  <GradientStop Color="#00968AE0" Offset="1.00"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="18,0">

              <!-- La carpeta vive AQUÍ: elegirla, ver cuántos ficheros trae y simular son la
                   misma acción, y estaban repartidas por tres sitios de la pantalla. -->
              <TextBlock Text="{i:T OrganizarCarpeta}" Style="{StaticResource OrgLabel}"/>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:CampoTexto x:Name="txtCarpeta" Icono="M1.5 3.5h4l1.5 2h7.5v7h-13z" HorizontalAlignment="Stretch"/>
                <Button x:Name="btnCarpeta" Grid.Column="1" Style="{StaticResource BtnSecondary}" Width="34" Height="34" Padding="0"
                        Margin="6,0,0,0" ToolTip="{i:T OrganizarCarpetaAyuda}">
                  <Viewbox Width="15" Height="15">
                    <Path Data="M1.5 3.5h4l1.5 2h7.5l-2 7h-11z M1.5 3.5v9h11" Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                  </Viewbox>
                </Button>
                <!-- Carpetas vinculadas a ESTE catálogo: verlas, saltar a una, vincular la
                     actual o quitarla. Antes el vínculo se guardaba solo al analizar y no había
                     manera de verlo ni de hacerlo a mano — era una función invisible. -->
                <Button x:Name="btnVinculos" Grid.Column="2" Style="{StaticResource BtnSecondary}" Width="34" Height="34" Padding="0"
                        Margin="6,0,0,0" Click="OnVinculos"
                        ToolTip="{i:T OrganizarVinculosAyuda}">
                  <Viewbox Width="15" Height="15">
                    <Path Data="M6.2 9.8 9.8 6.2 M6.6 4.4 8.1 2.9a2.6 2.6 0 0 1 3.7 3.7l-1.5 1.5 M9.4 11.6 7.9 13.1a2.6 2.6 0 0 1-3.7-3.7l1.5-1.5"
                          Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Viewbox>
                </Button>
              </Grid>
              <!-- Estado del vínculo, a la vista: sin esto no hay forma de saber si la carpeta
                   quedará asociada al catálogo para la próxima vez. -->
              <TextBlock x:Name="lblVinculo" FontSize="11.5" Margin="0,0,0,12"
                         Foreground="{StaticResource Neutral500}" TextWrapping="Wrap"/>

              <TextBlock x:Name="lblFicheros" Text="{i:T OrganizarElegirCarpeta}" FontSize="13.5"
                         Foreground="{StaticResource Text}" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap"/>

              <!-- Reposo: promesa + botón. Se retiran mientras corren las etapas. -->
              <StackPanel x:Name="panelReposo">
                <!-- La promesa explícita: nada se toca sin aprobación. Es lo que permite
                     pulsar «Simular» sin miedo. -->
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Neutral500}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="18">
                  <!-- El destacado va con la clave del propio botón: la promesa nombra
                       «Analizar» y tiene que decir exactamente lo que pone el botón. -->
                  <Run Text="{i:T OrganizarPromesa1}"/><Run FontWeight="Medium" Foreground="{StaticResource Neutral400}" Text="{i:T OrganizarAnalizar}"/><Run Text="{i:T OrganizarPromesa2}"/>
                </TextBlock>
                <Button x:Name="btnSimularGrande" Style="{StaticResource BtnPrimary}" Margin="0,18,0,0"
                        HorizontalAlignment="Center" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                      <Canvas Width="16" Height="16">
                        <Ellipse Width="9" Height="9" Canvas.Left="2.5" Canvas.Top="2.5" Stroke="#968AE0" StrokeThickness="1.5"/>
                        <Path Data="M10.5 10.5L14 14" Stroke="#968AE0" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{i:T OrganizarAnalizarCarpeta}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Etapas de la identificación. Los iconos los conmuta el código:
                   círculo discontinuo (pendiente) → arco girando (en curso) → check que se
                   dibuja y da un pequeño salto (hecha). -->
              <StackPanel x:Name="panelEtapas" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ══════════════ REVISIÓN: la tabla de triaje ══════════════ -->
    <Grid x:Name="vistaRevision" Grid.Row="2" Margin="16,0,16,0" Visibility="Collapsed">
      <!-- Tres filas y no dos: los DOS avisos pueden estar puestos a la vez -uno dice
           cuántas filas piden decisión y el otro cuántas se acaban de renombrar- y
           compartiendo fila se pintaban uno encima del otro, ilegibles los dos. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Banner de aviso cuando el lote viene mayoritariamente dudoso -->
      <Border x:Name="bannerAviso" Grid.Row="0" Background="{StaticResource OrgWarnBg}"
              BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="▲" Foreground="{StaticResource OrgWarn}" VerticalAlignment="Top" Margin="0,1,9,0"/>
          <TextBlock x:Name="lblBannerAviso" Foreground="{StaticResource OrgWarn}" FontSize="12.5"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Banda de resultado tras aplicar -->
      <Border x:Name="bannerAplicado" Grid.Row="1" Background="{StaticResource OrgOkBg}"
              BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✓" Foreground="{StaticResource OrgOk}" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="lblBannerAplicado" Foreground="{StaticResource OrgOk}" FontSize="12.5"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="btnDeshacerBanda" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                  Content="{i:T OrganizarDeshacerEsteLote}" FontSize="12"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource SurfaceGlass}" CornerRadius="8" ClipToBounds="True">
        <!-- El resolutor se despliega al seleccionar la fila; el propio detalle se oculta
             para las filas que no tienen nada que resolver. -->
        <!-- La separación por temporada la pinta cada fila (ver «banda» en OrgRow), no
             DataGrid.GroupStyle: agrupar rompe el reparto de las columnas en «*». -->
        <DataGrid x:Name="tabla" Style="{StaticResource OrgGrid}" RowStyle="{StaticResource OrgRow}"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Sorting="OnTablaSorting">
          <!-- Va en la tabla y no en el estilo de fila: el estilo vive en un diccionario
               de recursos, que no tiene código detrás donde colgar los manejadores. La
               fila sobre la que se pulsó se resuelve al abrirlo. -->
          <DataGrid.ContextMenu>
            <ContextMenu x:Name="menuFila">
              <MenuItem x:Name="miReproducir" Header="{i:T OrganizarReproducir}"/>
              <MenuItem x:Name="miRecortar" Header="{i:T OrganizarEnviarRecortes}"/>
              <MenuItem x:Name="miUbicacion" Header="{i:T OrganizarAbrirUbicacion}"/>
              <Separator/>
              <!-- Cambiar la propuesta desde CUALQUIER fila, no solo desde las que tienen
                   conflicto: una fila en verde también puede estar mal, y hasta ahora el
                   resolutor solo se abría cuando la app dudaba. Aquí se elige el episodio y,
                   si trae varias historias, cuáles de ellas (E1b, E1bc…). -->
              <MenuItem x:Name="miElegirEpisodio" Header="{i:T OrganizarElegirEpisodioHistorias}"/>
              <!-- Para el fichero raro que mezcla historias de episodios DISTINTOS. El nombre
                   sale con el código compuesto («E1b+2b») a propósito: así se ve lo que hay. -->
              <MenuItem x:Name="miAnadirHistoria" Header="{i:T OrganizarAnadirHistoria}"/>
              <MenuItem x:Name="miQuitarHistorias" Header="{i:T OrganizarQuitarHistorias}"/>
              <!-- Se apunta EN EL CATÁLOGO, así la decisión viaja con él y no vuelve a
                   preguntarse en cada análisis. -->
              <MenuItem x:Name="miDejarComoEsta" Header="{i:T OrganizarDejarComoEstaMenu}"/>
              <Separator/>
              <!-- Encontrar un fichero problemático cuesta más que arreglarlo: esto lo
                   aparta para mañana sin tener que volver a buscarlo. -->
              <MenuItem x:Name="miRevisar" Header="{i:T OrganizarApartarRevisar}"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>

            <!-- Marcar qué se aplica. Solo tiene casilla lo que ESTÁ listo: poner una en
                 los conflictos insinuaría que marcándolos se aplican, y es al revés. -->
            <DataGridTemplateColumn Width="44" CanUserSort="False">
              <DataGridTemplateColumn.Header>
                <CheckBox x:Name="chkTodos" IsChecked="True" Checked="OnMarcarTodos" Unchecked="OnMarcarTodos"
                          ToolTip="{i:T OrganizarMarcarTodosAyuda}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Marcado, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Checked="OnMarcarFila" Unchecked="OnMarcarFila"
                            Visibility="{Binding ListoParaAplicar, Converter={StaticResource B2V}}"
                            ToolTip="{i:T OrganizarMarcarFilaAyuda}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- ESTADO — chip: glifo + palabra + color, nunca solo color -->
            <DataGridTemplateColumn Header="{i:T OrganizarColEstado}" Width="112" SortMemberPath="EstadoVisible">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding EstadoBg}" BorderBrush="{Binding EstadoBorde}" BorderThickness="1"
                          CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                    <Border.ToolTip>
                      <TextBlock Text="{Binding EstadoTooltip}" MaxWidth="360" TextWrapping="Wrap"/>
                    </Border.ToolTip>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding EstadoGlifo}" Foreground="{Binding EstadoFg}" FontSize="10.5"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                      <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoFg}" FontSize="11.5"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- APARTADO — sin encabezado ni anchura fija: es un margen de libreta, no una
                 columna de datos. Solo aparece si hay algo apartado. -->
            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="🔖" FontSize="12" Margin="0,0,2,0" VerticalAlignment="Center"
                             Visibility="{Binding VerApartada}" ToolTip="{i:T OrganizarEnLaCola}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- SEGMENTO — «E1bc» cuando el fichero es solo algunas historias del episodio.
                 Sin esto, una fila que es medio episodio se leía igual que las demás. -->
            <DataGridTemplateColumn Width="Auto" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Accent900}" BorderBrush="{StaticResource Accent700}"
                          BorderThickness="1" CornerRadius="7" Padding="7,1" Margin="0,0,4,0"
                          VerticalAlignment="Center" Visibility="{Binding VerSegmento}"
                          ToolTip="{Binding SegmentoTooltip}">
                    <TextBlock Text="{Binding SegmentoPildora}" FontSize="10.5"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource Accent200}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- FICHERO ORIGINAL -->
            <DataGridTemplateColumn Header="{i:T OrganizarColOriginal}" Width="1.1*" SortMemberPath="Original">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Original}" Foreground="{StaticResource Neutral300}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Res.Archivo.Path}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- PROPUESTA -->
            <DataGridTemplateColumn Header="{i:T OrganizarColPropuesta}" Width="1.6*" SortMemberPath="Propuesta">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Propuesta}" Foreground="{Binding PropuestaFg}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Propuesta}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <!-- Solo se destaca lo que de verdad va a cambiar -->
                          <DataTrigger Binding="{Binding PropuestaDestacada}" Value="True">
                            <Setter Property="FontWeight" Value="Medium"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- POR QUÉ — evidencia corta; la prosa completa, en el tooltip -->
            <!-- La duración. Se lee de la ficha de Windows, no del contenido, así que
                 los ficheros que están en la nube también la traen sin descargarse.
                 Va ANTES del «por qué» porque es un dato, y el «por qué» es la
                 conclusión que a veces se saca de él. -->
            <DataGridTemplateColumn Header="{i:T OrganizarColDuracion}" Width="74"
                                    SortMemberPath="DuracionOrden">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DuracionVisible}" FontFamily="{StaticResource FontMono}"
                             FontSize="11.5" Foreground="{StaticResource Neutral500}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             ToolTip="{Binding DuracionTooltip}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{i:T OrganizarColPorQue}" Width="0.7*" MinWidth="90" SortMemberPath="PorQue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PorQue}" Foreground="{StaticResource Neutral500}" FontSize="12"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Explicacion}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>

          <!-- ══ Resolutor de conflictos, desplegado BAJO la fila ══ -->
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,1"
                      Padding="16,14"
                      Visibility="{Binding TieneDetalle, Converter={StaticResource B2V}}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding TituloDetalle}" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource Accent400}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Original}" FontSize="12.5" Foreground="{StaticResource Text}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Explicacion}" Style="{StaticResource OrgMuted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <!-- Tarjetas de candidato, con la evidencia a favor y en contra -->
                  <!-- Se listan los Candidatos de la fila, no las alternativas del motor: esa
                       lista incluye al elegido, que antes no se enseñaba y hacía que las dos
                       opciones ofrecidas parecieran las dos equivocadas. -->
                  <!-- El selector de candidatos se esconde cuando el fichero trae dos
                       episodios: elegir uno es precisamente el error. En su lugar manda el
                       botón «Partirlo en dos…» de abajo. -->
                  <ItemsControl ItemsSource="{Binding Candidatos}" Visibility="{Binding VerSelector}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="tarjeta" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
                          <StackPanel>
                            <Grid Margin="0,0,0,8">
                              <TextBlock Text="{Binding Cabecera}" VerticalAlignment="Center" FontSize="13"
                                         FontWeight="Medium" Foreground="{StaticResource Text}"/>
                              <Border x:Name="insignia" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Background="{StaticResource Field}" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding Etiqueta}" FontSize="10.5"
                                           Foreground="{StaticResource Neutral400}"/>
                              </Border>
                            </Grid>
                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource OrgMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Evidencia}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                             Foreground="{StaticResource Neutral400}"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- La consecuencia, a la vista: qué nombre quedaría si eliges esta.
                                 Sin esto hay que decidir a ciegas. -->
                            <TextBlock Text="{i:T OrganizarQuedariaComo}" FontSize="10.5" Margin="0,8,0,3"
                                       Foreground="{StaticResource Neutral500}"/>
                            <Border Background="{StaticResource Field}" CornerRadius="6" Padding="8,6">
                              <TextBlock Text="{Binding NombreResultante}" FontSize="11.5" TextWrapping="Wrap"
                                         Foreground="{StaticResource Neutral300}"
                                         FontFamily="{StaticResource FontMono}"/>
                            </Border>

                            <Button Style="{StaticResource BtnSecondary}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    FontSize="12" Padding="10,5" Click="OnElegirCandidato" Tag="{Binding Episodio}"
                                    Content="{Binding TextoBoton}"/>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <!-- La propuesta actual se distingue de un vistazo -->
                          <DataTrigger Binding="{Binding EsElegido}" Value="True">
                            <Setter TargetName="tarjeta" Property="BorderBrush" Value="{StaticResource Accent700}"/>
                            <Setter TargetName="tarjeta" Property="Background" Value="{StaticResource Accent900}"/>
                            <Setter TargetName="insignia" Property="Background" Value="{StaticResource Accent800}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- FICHERO REPETIDO (#128): las DOS rutas implicadas, para elegir cuál va a la
                       Papelera. Nada se borra por su cuenta; ambos ficheros se pueden abrir antes. -->
                  <Grid Visibility="{Binding VerBorrarCopia}" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                      <StackPanel>
                        <TextBlock Text="{i:T OrganizarEsteFichero}" FontSize="10.5" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NombrePropio}" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CarpetaPropia}" FontSize="11" Foreground="{StaticResource Neutral400}"
                                   TextWrapping="Wrap" Margin="0,2,0,10" FontFamily="{StaticResource FontMono}"/>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="{i:T OrganizarEnviarEsteAPapelera}" Style="{StaticResource BtnSecondary}" FontSize="12"
                                  Padding="12,4" Click="OnBorrarEste"
                                  ToolTip="{i:T OrganizarEnviarEsteAyuda}"/>
                          <Button Content="{i:T OrganizarAbrirCarpeta}" Style="{StaticResource BtnGhost}" FontSize="12"
                                  Margin="8,0,0,0" Click="OnAbrirCarpetaEste"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                      <StackPanel>
                        <TextBlock Text="{i:T OrganizarElOtroFichero}" FontSize="10.5" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NombrePareja}" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CarpetaPareja}" FontSize="11" Foreground="{StaticResource Neutral400}"
                                   TextWrapping="Wrap" Margin="0,2,0,10" FontFamily="{StaticResource FontMono}"/>
                        <StackPanel Orientation="Horizontal">
                          <Button Content="{i:T OrganizarEnviarOtroAPapelera}" Style="{StaticResource BtnSecondary}" FontSize="12"
                                  Padding="12,4" Click="OnBorrarOtro"
                                  ToolTip="{i:T OrganizarEnviarOtroAyuda}"/>
                          <Button Content="{i:T OrganizarAbrirCarpeta}" Style="{StaticResource BtnGhost}" FontSize="12"
                                  Margin="8,0,0,0" Click="OnAbrirCarpetaOtro"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="chkRecordar" Content="{i:T OrganizarRecordarDecision}"
                              Foreground="{StaticResource Neutral400}" FontSize="12" VerticalAlignment="Center"
                              Visibility="{Binding VerSelector}"/>
                    <!-- Un fichero con dos episodios dentro no se arregla eligiendo número:
                         hay que partirlo. Por eso este botón va el PRIMERO y destacado
                         cuando toca — es la única salida real, no una alternativa más. -->
                    <Button Content="{i:T OrganizarPartirEnDos}" Style="{StaticResource BtnPrimary}" FontSize="12"
                            Padding="12,4" Margin="16,0,0,0" Click="OnPartirEnDos"
                            Visibility="{Binding VerRecortar}"
                            ToolTip="{i:T OrganizarPartirEnDosAyuda}"/>
                    <!-- Visible SIEMPRE, también cuando la app recomienda partir: aunque
                         detecte «dos episodios», el usuario puede querer asignar uno a mano
                         (p. ej. si la detección fue un falso positivo). Es la vía de escape.
                         Va en estilo discreto para no competir con «Partirlo en dos…». -->
                    <Button Content="{i:T OrganizarElegirOtroEpisodio}" Style="{StaticResource BtnGhost}" FontSize="12"
                            Margin="16,0,0,0" Click="OnElegirAMano"/>
                    <Button Content="{i:T OrganizarDejarComoEsta}" Style="{StaticResource BtnGhost}" FontSize="12"
                            Margin="8,0,0,0" Click="OnDejarComoEsta"/>
                    <!-- Solo aparece cuando hay OTRAS filas con la misma causa Y esa causa
                         tiene una única respuesta buena para todas. Contestar dieciséis
                         veces «esto no está en este catálogo» no es revisar, es teclear. -->
                    <!-- La acción CONTRARIA a la de al lado: aquella dice «no toques», esta
                         «acepta lo que propones». Por eso son dos botones y no uno. -->
                    <Button x:Name="btnConfirmarTodosIguales" Style="{StaticResource BtnPrimary}" FontSize="12"
                            Padding="12,4" Margin="8,0,0,0" Click="OnConfirmarTodosLosIguales"
                            Content="{Binding ConfirmarIgualesTexto}"
                            ToolTip="{i:T OrganizarConfirmarIgualesAyuda}"
                            Visibility="{Binding VerConfirmarIguales}"/>
                    <Button x:Name="btnDejarTodasIguales" Style="{StaticResource BtnGhost}" FontSize="12"
                            Margin="8,0,0,0" Click="OnDejarTodasLasIguales"
                            Content="{Binding DejarIgualesTexto}"
                            ToolTip="{i:T OrganizarDejarIgualesAyuda}"
                            Visibility="{Binding VerDejarIguales}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
      </Border>
    </Grid>

    <!-- ══════════════ Barra de acciones ══════════════ -->
    <!-- ══ Repaso de películas ══
         La forma es la del repaso de series a propósito: mismos chips arriba, misma
         rejilla, misma barra de aplicar abajo. Lo que da confianza es reconocer la
         pantalla y poder decidir fila a fila; para eso no hace falta compartir la
         clase de la fila, que en series arrastra catálogo, plantilla y temporada
         —tres cosas que una película no tiene—. -->
    <Grid x:Name="vistaRevisionPelis" Grid.Row="2" Margin="16,0,16,0" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Lo que va a costar el movimiento: cruzar de disco, entrar en una nube, o
           ficheros que solo están en la nube. Arriba y no abajo, porque es lo que
           puede hacerte no aplicar nada: un aviso que se lee después de pulsar no
           es un aviso. -->
      <Border x:Name="cajaRiesgoPelis" Grid.Row="0" Background="{StaticResource OrgWarnBg}"
              BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="▲" Foreground="{StaticResource OrgWarn}" VerticalAlignment="Top" Margin="0,1,9,0"/>
          <TextBlock x:Name="lblRiesgoPelis" Foreground="{StaticResource OrgWarn}" FontSize="12.5"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border x:Name="bandaPelis" Grid.Row="1" Background="{StaticResource OrgOkBg}"
              BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1" CornerRadius="8"
              Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="✓" Foreground="{StaticResource OrgOk}" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock x:Name="lblBandaPelis" Foreground="{StaticResource OrgOk}" FontSize="12.5"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource SurfaceGlass}" CornerRadius="8" ClipToBounds="True">
        <DataGrid x:Name="tablaPelis" Style="{StaticResource OrgGrid}"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
          <!-- ══ Elegir a mano, desplegado BAJO la fila ══
               La cascada se planta cuando dos encajan igual de bien, y hace bien. Pero
               si no puedes resolverlo tú, se planta para siempre. Aquí se elige, y la
               elección se recuerda: no hay que volver a tomarla en cada análisis. -->
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}"
                      BorderThickness="0,1,0,1" Padding="16,12"
                      Visibility="{Binding TieneDetalle, Converter={StaticResource B2V}}">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Text="{i:T PeliculasCual}" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource Accent400}" VerticalAlignment="Center"/>
                    <Button x:Name="btnOlvidarPeli" HorizontalAlignment="Right"
                            Style="{StaticResource BtnGhostMuted}" FontSize="11" Padding="10,3"
                            Content="{i:T PeliculasOlvidarEleccion}"
                            Visibility="{Binding VerOlvidar}"
                            Tag="{Binding}" Click="OnOlvidarPelicula"/>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Candidatos}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titulo}" FontSize="12.5"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Neutral500}">
                              <Run Text="{Binding Anio, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Original, Mode=OneWay}"/>
                            </TextBlock>
                          </StackPanel>
                          <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" FontSize="11"
                                  Padding="12,4" Content="{i:T PeliculasEsEsta}"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                  Click="OnElegirPelicula"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>

          <DataGrid.Columns>

            <!-- Marcar qué se aplica. Solo lleva casilla lo que tiene trabajo: ponerla
                 en un nombre ocupado insinuaría que marcándolo se aplica, y es al
                 revés. Es la pieza que faltaba, y la que hacía desconfiar de la
                 pantalla: era aplicar las once o ninguna. -->
            <DataGridTemplateColumn Width="44" CanUserSort="False">
              <DataGridTemplateColumn.Header>
                <CheckBox x:Name="chkTodasPelis" IsChecked="True"
                          Checked="OnMarcarTodasPelis" Unchecked="OnMarcarTodasPelis"
                          ToolTip="{i:T OrganizarMarcarTodosAyuda}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Marcado, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Checked="OnMarcarPelicula" Unchecked="OnMarcarPelicula"
                            Visibility="{Binding ListoParaAplicar, Converter={StaticResource B2V}}"
                            ToolTip="{i:T OrganizarMarcarFilaAyuda}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{i:T OrganizarColEstado}" Width="120" SortMemberPath="EstadoVisible">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding EstadoBg}" BorderBrush="{Binding EstadoBorde}" BorderThickness="1"
                          CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding EstadoGlifo}" Foreground="{Binding EstadoFg}" FontSize="10.5"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                      <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoFg}" FontSize="11.5"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{i:T OrganizarColOriginal}" Width="1.1*" SortMemberPath="Original">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Original}" FontFamily="{StaticResource FontMono}" FontSize="11.5"
                             Foreground="{StaticResource Neutral400}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Original}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="{i:T OrganizarColPropuesta}" Width="1.6*" SortMemberPath="Propuesta">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Propuesta}" FontFamily="{StaticResource FontMono}" FontSize="11.5"
                             Foreground="{StaticResource Text}"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Propuesta}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- POR QUÉ — la columna que convierte un color en una razón. En verde
                 cuando lo dijo TMDb y entró; en ámbar cuando lo dijo y NO entró. -->
            <DataGridTemplateColumn Header="{i:T OrganizarColPorQue}" Width="0.9*" MinWidth="110"
                                    SortMemberPath="PorQue">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding PorQue}" Foreground="{Binding PorQueColor}" FontSize="12"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Explicacion}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>

    <!-- ══ Acciones de películas ══ -->
    <Grid x:Name="filaAccionesPelis" Grid.Row="3" Margin="16,10,16,8" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="btnIdentificar" Style="{StaticResource BtnSecondary}" FontSize="12" Padding="12,5"
                Content="{i:T PeliculasIdentificar}" ToolTip="{i:T PeliculasIdentificarAyuda}"
                ToolTipService.ShowOnDisabled="True"/>
        <TextBlock x:Name="lblTmdbApagado" Text="{i:T PeliculasIdentificarApagado}" FontSize="10.5"
                   MaxWidth="300" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                   Foreground="{StaticResource Neutral600}" Visibility="Collapsed"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock x:Name="lblPiePelis" FontSize="11" Foreground="{StaticResource Neutral500}"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="0,0,10,0"/>
        <Button x:Name="btnDeshacerPelis" Style="{StaticResource BtnGhostMuted}" FontSize="12" Padding="12,5"
                Margin="0,0,8,0" Visibility="Collapsed" Content="{i:T PeliculasDeshacer}"/>
        <Button x:Name="btnAplicarPelis" Style="{StaticResource BtnPrimary}" FontSize="12" Padding="14,5"
                Content="{i:T PeliculasBotonNada}" IsEnabled="False"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="filaAcciones" Grid.Row="3" Margin="16,10,16,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="btnSimular" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" IsEnabled="False"
                ToolTip="{i:T OrganizarAnalizarAyuda}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
              <Canvas Width="16" Height="16">
                <Ellipse Width="9" Height="9" Canvas.Left="2.5" Canvas.Top="2.5" Stroke="#968AE0" StrokeThickness="1.5"/>
                <Path Data="M10.5 10.5L14 14" Stroke="#968AE0" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="{i:T OrganizarAnalizar}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button x:Name="btnAplicar" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" IsEnabled="False"
                ToolTip="{i:T OrganizarAplicarAyuda}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
              <Path Data="M2.5 8.5l4 4 7-9" Stroke="#968AE0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
            <TextBlock x:Name="lblAplicar" Text="{i:T Aplicar}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- El catálogo sabe qué episodios existen y la app cuáles tienes: la resta es «qué me
             falta», y estaba ahí sin aprovechar. -->
        <Button x:Name="btnQueFalta" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" IsEnabled="False"
                Content="{i:T OrganizarQueFalta}"
                ToolTip="{i:T OrganizarQueFaltaAyuda}"/>

        <!-- Un capítulo descargado cae donde cae. Esto lo lleva a la carpeta de su temporada,
             creándola si hace falta, y SOLO si ya está curado: un conflicto no se mueve. -->
        <Button x:Name="btnReordenar" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" IsEnabled="False"
                Content="{i:T OrganizarReordenar}"
                ToolTip="{i:T OrganizarReordenarAyuda}"/>

        <!-- Un fichero con 2-3 mini-historias se puede dejar en un fichero por historia, con la
             numeración por segmento («1a», «1b», «1c»). El corte va sin recodificar. -->
        <Button x:Name="btnPartirSegmentos" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" IsEnabled="False"
                Content="{i:T OrganizarPartirSegmentos}"
                ToolTip="{i:T OrganizarPartirSegmentosAyuda}"/>

        <Button x:Name="btnDeshacer" Style="{StaticResource BtnGhostMuted}" IsEnabled="False"
                ToolTip="{i:T OrganizarDeshacerAyuda}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
              <Path Data="M3 8a5 5 0 1 1 1.6 3.7M3 4.5V8h3.5" Stroke="{StaticResource Neutral500}" StrokeThickness="1.4"
                    StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
            <TextBlock x:Name="lblDeshacer" Text="{i:T OrganizarDeshacerLote}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="lblEstadoOrg" Text="{i:T OrganizarEstadoInicial}" VerticalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource Neutral500}" Margin="0,0,12,0"
                   MaxWidth="360" TextTrimming="CharacterEllipsis"/>
        <!-- La cola no es un filtro de la tabla: es una LISTA APARTE que se abre y se
             mira, como la cola de reproducción de un reproductor de música. Por eso es un
             botón con su desplegable y no un chip que esconde filas. -->
        <!-- FiltroChip y no BtnGhostMuted: aquel apunta a ToggleButton y este a Button, y
             la cola necesita quedarse pulsada mientras su lista está abierta. -->
        <ToggleButton x:Name="btnCola" Style="{StaticResource FiltroChip}" Padding="10,5" Margin="8,0,0,0"
                      ToolTip="{i:T OrganizarColaAyuda}">
          <TextBlock><Run Text="☰" Foreground="#C9A0FF"/><Run x:Name="runCola" Text="{i:T OrganizarCola}"/></TextBlock>
        </ToggleButton>

        <Popup x:Name="popCola" PlacementTarget="{Binding ElementName=btnCola}" Placement="Top"
               IsOpen="{Binding IsChecked, ElementName=btnCola, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Neutral800}"
                  BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,12,12,4"
                  Width="440" MaxHeight="420">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Margin="14,12,14,8" FontSize="11" FontWeight="Medium"
                         Foreground="{StaticResource Neutral500}" Text="{i:T OrganizarColaTitulo}"/>

              <TextBlock x:Name="lblColaVacia" Grid.Row="1" Margin="14,4,14,14" FontSize="12"
                         TextWrapping="Wrap" Foreground="{StaticResource Neutral500}"
                         Text="{i:T OrganizarColaVacia}"/>

              <ScrollViewer x:Name="visorCola" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                <ItemsControl x:Name="listaCola">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="6,1,6,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- La fila entera lleva a ese fichero: es lo que se quiere hacer
                             el 99 % de las veces al abrir la cola. -->
                        <Button Grid.Column="0" Style="{StaticResource BtnGhostMuted}" Padding="8,6"
                                HorizontalContentAlignment="Stretch" Click="OnIrAFicheroDeLaCola"
                                Tag="{Binding Ruta}" ToolTip="{Binding Ruta}">
                          <StackPanel>
                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock Text="{Binding Detalle}" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{StaticResource Neutral500}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource BtnGhostMuted}" Padding="8,6"
                                Content="✕" FontSize="11" Click="OnQuitarDeLaCola"
                                Tag="{Binding Ruta}" ToolTip="{i:T OrganizarSacarDeLaCola}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                      Padding="10,7">
                <Button x:Name="btnVaciarCola" Style="{StaticResource BtnGhostMuted}" Padding="8,4"
                        FontSize="11.5" HorizontalAlignment="Right" Content="{i:T OrganizarVaciarCola}"/>
              </Border>
            </Grid>
          </Border>
        </Popup>

        <Button x:Name="btnMemoria" Style="{StaticResource BtnGhostMuted}" Content="{i:T OrganizarMemoria}"
                ToolTip="{i:T OrganizarMemoriaAyuda}"/>
      </StackPanel>
    </Grid>

    <!-- ══════════════ Confirmación (superpuesta, no MessageBox) ══════════════ -->
    <!-- Va dentro de la ventana a propósito: un MessageBox del sistema rompería el tema
         y sacaría al usuario del contexto justo en la decisión más delicada. -->
    <Grid x:Name="overlayConfirmar" Grid.RowSpan="4" Background="#B0000000" Visibility="Collapsed"
          Panel.ZIndex="10">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="1"
              CornerRadius="12" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              Padding="24,20">
        <StackPanel>
          <TextBlock Text="{i:T OrganizarConfirmarTitulo}" FontSize="16" FontWeight="Medium"
                     Foreground="{StaticResource Text}" Margin="0,0,0,14"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="✓" Foreground="{StaticResource OrgOk}" Margin="0,0,9,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="lblConfSeRenombra" Foreground="{StaticResource Text}" FontSize="13"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel x:Name="filaNoSeToca" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="—" Foreground="{StaticResource Neutral500}" Margin="0,0,9,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="lblConfNoSeToca" Foreground="{StaticResource Neutral400}" FontSize="13"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <Border Background="{StaticResource Accent900}" BorderBrush="{StaticResource Accent800}" BorderThickness="1"
                  CornerRadius="8" Padding="12,9" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↺" Foreground="{StaticResource Accent300}" Margin="0,0,9,0" VerticalAlignment="Top"/>
              <TextBlock Foreground="{StaticResource Accent200}" FontSize="12.5" TextWrapping="Wrap"
                         Text="{i:T OrganizarConfirmarRegistro}"/>
            </StackPanel>
          </Border>

          <CheckBox x:Name="chkRecordarDecisiones" Margin="0,14,0,0" Foreground="{StaticResource Neutral400}"
                    FontSize="12.5" Visibility="Collapsed"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnConfCancelar" Style="{StaticResource BtnSecondary}" Content="{i:T Cancelar}"/>
            <Button x:Name="btnConfAceptar" Style="{StaticResource BtnPrimary}" Content="{i:T Aplicar}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
