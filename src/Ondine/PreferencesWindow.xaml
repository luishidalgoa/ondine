<Window x:Class="Ondine.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T PreferenciasTitulo}" Width="580" Height="620" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <!-- El alto es fijo, pero las pestañas SÍ se desplazan: el ScrollViewer está en la
       plantilla del TabControl (Theme.xaml). Antes no lo llevaban y la regla era «cada
       línea nueva se paga en el Height de arriba»; se incumplió tres veces —el selector
       de idioma dejó fuera la última casilla de «General», la pestaña del modelo volvió a
       subir el alto, y la de películas se salió otra vez—. Así que ya no hay que acordarse
       de nada al añadir una línea. -->

  <!-- 8 px: el mismo radio que Windows 11 recorta por fuera, para que el borde dibujado
       y el recorte del sistema coincidan en vez de pelearse en la esquina. -->
  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><!-- header -->
        <RowDefinition Height="*"/><!-- tabs -->
        <RowDefinition Height="Auto"/><!-- footer -->
      </Grid.RowDefinitions>

      <!-- header (arrastrable) -->
      <Grid x:Name="header" Grid.Row="0" Height="46" Background="Transparent">
        <TextBlock Text="{i:T PreferenciasTitulo}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="18,0,0,0"/>
        <Button x:Name="btnX" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource Neutral500}">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.3" Width="13" Height="13" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <TabControl x:Name="pestanias" Grid.Row="1" Margin="18,0,18,0">
        <!-- ══ General ══ -->
        <TabItem Header="{i:T PreferenciasTabGeneral}">
          <StackPanel>
            <TextBlock Text="{i:T PreferenciasIdiomaApp}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <TextBlock Text="{i:T PreferenciasIdiomaAppAyuda}" FontSize="10.5" Foreground="{StaticResource Neutral600}" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboIdioma" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="{i:T PreferenciasPresetPorDefecto}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboDefPreset" Width="320" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="{i:T PreferenciasIdiomaAudio}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <TextBlock Text="{i:T PreferenciasIdiomaAudioAyuda}" FontSize="10.5" Foreground="{StaticResource Neutral600}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDefLang" Width="140" HorizontalAlignment="Left" Margin="0,0,0,18"/>

            <CheckBox x:Name="chkRecurse" Content="{i:T PreferenciasSubcarpetas}" Margin="0,0,0,10"
                      ToolTip="{i:T PreferenciasSubcarpetasAyuda}"/>
            <CheckBox x:Name="chkUpdates" Content="{i:T PreferenciasBuscarActualizaciones}" Margin="0,0,0,14"/>

            <CheckBox x:Name="chkShell" Content="{i:T PreferenciasMenuExplorador}"
                      ToolTip="{i:T PreferenciasMenuExploradorAyuda}"/>
            <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Neutral600}" Margin="24,4,0,0"
                       Text="{i:T PreferenciasMenuExploradorNota}"/>
          </StackPanel>
        </TabItem>

        <!-- ══ Al comprimir ══ -->
        <TabItem Header="{i:T PreferenciasTabAlComprimir}">
          <StackPanel>
            <TextBlock Text="{i:T PreferenciasTrasComprimirTitulo}" FontSize="12" Foreground="{StaticResource Neutral400}" Margin="0,0,0,10"/>
            <RadioButton x:Name="rbAsk" GroupName="after" Content="{i:T PreferenciasTrasComprimirPreguntar}"/>
            <RadioButton x:Name="rbRecycle" GroupName="after" Content="{i:T PreferenciasTrasComprimirPapelera}"/>
            <RadioButton x:Name="rbKeep" GroupName="after" Content="{i:T PreferenciasTrasComprimirConservar}"/>
            <Border Background="{StaticResource Field}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Neutral500}"
                           Text="{i:T PreferenciasPapeleraNota}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Neutral500}" Margin="0,6,0,0"
                           Text="{i:T PreferenciasBorradoNota}"/>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Neutral600}" Margin="0,6,0,0"
                           Text="{i:T PreferenciasRutaNota}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <!-- ══ Rendimiento y disco ══ -->
        <TabItem Header="{i:T PreferenciasTabRendimiento}">
          <StackPanel>
            <TextBlock Text="{i:T PreferenciasMargenDisco}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBox x:Name="txtMinFree" Width="90" HorizontalAlignment="Left"/>
              <TextBlock Text="{i:T PreferenciasUnidadMb}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Neutral500}"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Neutral600}" Margin="0,0,0,18"
                       Text="{i:T PreferenciasMargenDiscoAyuda}"/>

            <CheckBox x:Name="chkHw" Content="{i:T PreferenciasAceleracion}"/>
            <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Neutral600}" Margin="0,6,0,0"
                       Text="{i:T PreferenciasAceleracionAyuda}"/>
          </StackPanel>
        </TabItem>
        <!-- ══ Modelo de lenguaje (opcional) ══ -->
        <TabItem Header="{i:T IaPestania}">
          <StackPanel>
            <TextBlock Text="{i:T IaTitulo}" FontSize="12" Foreground="{StaticResource Neutral400}" Margin="0,0,0,4"/>
            <TextBlock Text="{i:T IaIntro}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,12"/>

            <CheckBox x:Name="chkIa" Content="{i:T IaActivo}" Margin="0,0,0,14"/>

            <TextBlock Text="{i:T IaBaseUrl}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtIaUrl" Margin="0,0,0,3"/>
            <TextBlock Text="{i:T IaBaseUrlAyuda}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,12"/>

            <TextBlock Text="{i:T IaModelo}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <TextBox x:Name="txtIaModelo" Width="240" HorizontalAlignment="Left" Margin="0,0,0,3"/>
            <TextBlock Text="{i:T IaModeloAyuda}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,12"/>

            <TextBlock Text="{i:T IaClave}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <!-- PasswordBox y no TextBox: no se enseña en pantalla ni se puede
                 copiar de ahí. Lo que ya está guardado no se rellena — se dice
                 que lo hay, y escribir encima lo reemplaza. -->
            <Grid Margin="0,0,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="txtIaClave"/>
              <Button x:Name="btnIaOlvidar" Grid.Column="1" Style="{StaticResource BtnGhostMuted}"
                      Content="{i:T IaClaveBorrar}" FontSize="11" Padding="10,4" Margin="8,0,0,0"
                      Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="lblIaClaveNota" Text="{i:T IaClaveAyuda}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="btnIaProbar" Style="{StaticResource BtnSecondary}" Content="{i:T IaProbar}"
                      FontSize="12" Padding="12,5"/>
              <TextBlock x:Name="lblIaProbar" VerticalAlignment="Center" Margin="10,0,0,0"
                         FontSize="11.5" TextWrapping="Wrap" MaxWidth="330"
                         Foreground="{StaticResource Neutral500}"/>
            </StackPanel>
          </StackPanel>
        </TabItem>
        <!-- ══ Películas: identificar contra TMDb (opcional) ══ -->
        <TabItem Header="{i:T TmdbPestania}">
          <StackPanel>
            <TextBlock Text="{i:T TmdbTitulo}" FontSize="12" Foreground="{StaticResource Neutral400}" Margin="0,0,0,4"/>
            <TextBlock Text="{i:T TmdbIntro}" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,12"/>

            <CheckBox x:Name="chkTmdb" Content="{i:T TmdbActivo}" Margin="0,0,0,10"/>

            <!-- Qué sale de esta máquina. Va pegado al interruptor y no detrás de
                 un «saber más»: es justo la información con la que se decide
                 encenderlo, y leída después ya no sirve para decidir. -->
            <Border Padding="10,7" CornerRadius="8" Margin="0,0,0,16"
                    Background="{StaticResource Field}">
              <TextBlock Text="{i:T TmdbQueSeManda}" TextWrapping="Wrap" FontSize="10.5"
                         Foreground="{StaticResource Neutral500}"/>
            </Border>

            <TextBlock Text="{i:T TmdbClave}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
            <!-- PasswordBox y no TextBox, igual que la clave del modelo: no se
                 saca a pantalla algo que ya está a salvo. -->
            <Grid Margin="0,0,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="txtTmdbClave"/>
              <Button x:Name="btnTmdbOlvidar" Grid.Column="1" Style="{StaticResource BtnGhostMuted}"
                      Content="{i:T TmdbClaveBorrar}" FontSize="11" Padding="10,4" Margin="8,0,0,0"
                      Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="lblTmdbClaveNota" TextWrapping="Wrap" FontSize="10.5"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,10"/>

            <!-- CUÁL se está usando. Sin esta línea, «hay clave» y «funciona» se
                 parecen demasiado: una copia compilada del repo sin el secreto no
                 tiene ninguna, y eso hay que decirlo aquí, que es donde se
                 arregla, y no como un fallo de red al primer intento. -->
            <Border x:Name="cajaTmdbClave" Padding="10,7" CornerRadius="8" BorderThickness="1"
                    Margin="0,0,0,16">
              <TextBlock x:Name="lblTmdbOrigen" TextWrapping="Wrap" FontSize="11"/>
            </Border>

            <!-- Cómo sacar tu propia clave, paso a paso y con el enlace. Va aquí,
                 delante del campo donde se pega, y no en la Ayuda: mandar a
                 alguien a otra pantalla a leer cómo rellenar la que tiene abierta
                 pierde a la mitad por el camino. -->
            <TextBlock Text="{i:T TmdbComoTitulo}" FontSize="11" FontWeight="Medium"
                       Foreground="{StaticResource Neutral500}" Margin="0,0,0,6"/>
            <TextBlock Text="{i:T TmdbComoPasos}" TextWrapping="Wrap" FontSize="10.5" LineHeight="17"
                       Foreground="{StaticResource Neutral600}" Margin="0,0,0,10"/>
            <Button x:Name="btnTmdbAbrir" Style="{StaticResource BtnSecondary}" FontSize="11"
                    Padding="12,5" HorizontalAlignment="Left" Content="{i:T TmdbComoAbrir}"/>
          </StackPanel>
        </TabItem>
      </TabControl>

      <!-- footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="18,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnCancel" Style="{StaticResource BtnSecondary}" Content="{i:T Cancelar}" Width="100" Margin="0,0,8,0"/>
          <Button x:Name="btnSave" Style="{StaticResource BtnPrimary}" Content="{i:T Guardar}" Width="100" IsDefault="True"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
