<Window x:Class="Ondine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ondine"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T MainMarca}" Width="1180" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}"
        ToolTipService.InitialShowDelay="420" ToolTipService.BetweenShowDelay="180" ToolTipService.ShowDuration="30000">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
  </Window.Resources>

  <Border x:Name="rootBorder" Background="{StaticResource Bg}">
    <Grid Margin="0">
      <!-- La barra de título va la PRIMERA y no se mueve de ahí. WindowChrome reserva
           para arrastrar los primeros CaptionHeight píxeles de la VENTANA, no de la
           barra: con el aviso de actualización encima, esa franja se la comía el aviso
           (que además es no-arrastrable para que respondan sus botones) y la barra de
           título quedaba fuera. Resultado: no se podía mover la ventana de ninguna de
           las dos formas. Con la barra siempre arriba, el arrastre, el doble clic para
           maximizar y el Aero Snap siguen siendo los del sistema, sin parches. -->
      <!-- El panel lateral vive en una SEGUNDA COLUMNA, no encima. Empuja el
           contenido en vez de taparlo: lo que se está mirando en Organizar es
           justo contra lo que se coteja la lista, y esconderlo para enseñar la
           lista obliga a cerrarla para mirar. Todo lo demás se queda en la
           columna 0 sin tocar nada, que es la de por defecto. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition x:Name="colPanel" Width="0"/>
      </Grid.ColumnDefinitions>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><!-- titlebar -->
        <RowDefinition Height="Auto"/><!-- banner -->
        <RowDefinition Height="Auto"/><!-- origen/destino -->
        <RowDefinition Height="Auto"/><!-- opciones -->
        <RowDefinition Height="*"/><!-- tabla+lateral -->
        <RowDefinition Height="Auto"/><!-- progreso -->
        <RowDefinition Height="Auto"/><!-- acciones -->
        <RowDefinition Height="Auto"/><!-- log -->
      </Grid.RowDefinitions>

      <!-- ══ Luz ambiental ══
           Tres manchas radiales muy tenues detrás de TODO (RowSpan de las 8 filas,
           sin participar en el hit-test). El latido va en la opacidad del conjunto,
           muy lento y de recorrido corto (0,82→1 en 9 s): a esa velocidad se percibe
           como que la sala respira, no como una animación pidiendo atención.

           El BitmapCache pinta los degradados una sola vez; el DesiredFrameRate del
           latido (abajo) es el que de verdad importa — la historia completa está en
           el comentario de la animación. -->
      <Grid x:Name="ambiente" Grid.Row="0" Grid.RowSpan="8" Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="-1">
        <Grid.CacheMode>
          <BitmapCache/>
        </Grid.CacheMode>
        <Grid.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <!-- El DesiredFrameRate va en el STORYBOARD: puesto en la animación hija,
                   WPF lo ignora — solo se respeta en la raíz del árbol de tiempo. -->
              <Storyboard Timeline.DesiredFrameRate="5">
                <!-- A 5 fps, no a 60. El ambiente está DEBAJO de toda la ventana: cada
                     paso del latido marca sucia la ventana entera y WPF recompone toda la
                     interfaz. A 60 fps eso era el 6 % de la máquina parada — el pintor
                     dominante de la app, medido apagándolo. Una rampa de 9 s a 5 pasos por
                     segundo es visualmente idéntica y cuesta la doceava parte. -->
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.82" To="1" Duration="0:0:9"
                                 AutoReverse="True" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <Rectangle Fill="{StaticResource AmbienteA}"/>
        <Rectangle Fill="{StaticResource AmbienteB}"/>
        <Rectangle Fill="{StaticResource AmbienteC}"/>
      </Grid>

      <!-- ══ Banner de actualización ══ -->
      <!-- Va DEBAJO de la barra de título: puesto encima se quedaba con la franja que
           WindowChrome reserva para arrastrar y la ventana dejaba de poder moverse.
           IsHitTestVisibleInChrome ya no hace falta aquí, pero se conserva por si algún
           día vuelve a caer dentro de esa franja: no cuesta nada y evita repetir el fallo. -->
      <Border x:Name="updateBar" Grid.Row="1" Background="{StaticResource Accent900}" BorderBrush="{StaticResource Accent800}"
              BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed"
              WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
          <Viewbox Width="15" Height="15" VerticalAlignment="Center">
            <Path Data="M8 1.5v3M8 11.5v3M1.5 8h3M11.5 8h3M3.5 3.5l2 2M10.5 10.5l2 2M12.5 3.5l-2 2M5.5 10.5l-2 2"
                  Stroke="{StaticResource Accent300}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Viewbox>
          <TextBlock x:Name="lblUpdate" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                     Foreground="{StaticResource Accent200}" Text="{i:T MainActualizacionDisponible}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="20,0,0,0">
            <Button x:Name="btnUpdateNow" Style="{StaticResource BtnPrimary}" Content="{i:T MainActualizarAhora}" FontSize="12" Padding="12,4"/>
            <Button x:Name="btnUpdateLater" Style="{StaticResource BtnGhost}" Content="{i:T MainActualizarDespues}" FontSize="12" Foreground="{StaticResource Accent300}" Margin="6,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ Barra de título ══ -->
      <!-- Tres columnas para que la tira de pestañas viva en el hueco flexible del centro y
           nunca pise ni el menú (izq., Auto) ni los botones de ventana (der., Auto): así el
           conmutador escala a muchas más páginas —se desplaza y ofrece un menú «▾»— sin
           romper la cabecera. -->
      <!-- ColumnSpan="2": la barra cruza la ventana ENTERA, tambien por debajo del
           panel lateral. Sin esto vivia solo en la columna del contenido, asi que
           al abrir el panel se encogia y se llevaba por delante los botones de
           minimizar, maximizar y cerrar: un panel no puede mover los mandos de la
           ventana. Ademas es lo que fija el borde superior del panel, que empieza
           justo donde acaba esta franja. -->
      <Grid Grid.Row="0" Grid.ColumnSpan="2" Height="40" Panel.ZIndex="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <!-- La marca «Corrientes»: tres pasadas que van de onda a recta. Misma geometría que
               Assets\app.ico y docs\marca\*.svg (retícula 64, grosor 6, extremos redondos).
               SIN contenedor a propósito: ni squircle, ni fondo, ni degradado, ni halo. El trazo
               se sostiene solo, que es justo lo que el anterior no hacía. -->
          <Viewbox Width="24" Height="24" VerticalAlignment="Center">
            <Canvas Width="64" Height="64">
              <Canvas.Resources>
                <!-- #B5ABFC y no el acento a secas: a 24 px sobre el fondo oscuro el tono claro
                     tiene más presencia, que es lo que pide el diseño para tamaños pequeños. -->
                <Style TargetType="Path">
                  <Setter Property="Stroke" Value="#B5ABFC"/>
                  <Setter Property="StrokeThickness" Value="6"/>
                  <Setter Property="StrokeStartLineCap" Value="Round"/>
                  <Setter Property="StrokeEndLineCap" Value="Round"/>
                  <Setter Property="StrokeLineJoin" Value="Round"/>
                </Style>
              </Canvas.Resources>
              <Path Data="M7,17 C15.5,9 26.5,25 35,17 C43.5,9 48.5,25 57,17"/>
              <Path Data="M7,32 C16,28 26,36 35,32 C44,28 48,36 57,32"/>
              <Path Data="M7,47 L57,47"/>
            </Canvas>
          </Viewbox>
          <!-- Separación: media altura de la marca (24/2 = 12), como dice el bloque del diseño. -->
          <TextBlock Text="{i:T MainMarca}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock x:Name="lblVersion" Text="v0.3.0" FontSize="11" Foreground="{StaticResource Neutral600}" VerticalAlignment="Center" Margin="8,2,0,0"/>
          <Menu x:Name="menuBar" VerticalAlignment="Center" Margin="20,0,0,0" Background="Transparent"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- La hamburguesa recoge los cuatro menús cuando no caben. Los mismos
                 objetos se mueven de sitio, no se duplican: dos copias del menú son
                 dos sitios donde añadir la próxima entrada, y una se olvida. -->
            <MenuItem x:Name="miHamburguesa" Visibility="Collapsed" Padding="8,4">
              <MenuItem.Header>
                <Viewbox Width="15" Height="12">
                  <Canvas Width="16" Height="12">
                    <Path Data="M0,1 H16 M0,6 H16 M0,11 H16"
                          Stroke="{StaticResource Text}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                </Viewbox>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="miArchivo" Header="{i:T MainMenuArchivo}">
              <MenuItem x:Name="miPickSrc" Header="{i:T MainMenuElegirOrigen}"/>
              <MenuItem x:Name="miAddFiles" Header="{i:T MainMenuAnadirArchivos}"/>
              <MenuItem x:Name="miOpenDest" Header="{i:T MainMenuAbrirDestino}"/>
              <Separator/>
              <MenuItem x:Name="miExit" Header="{i:T MainMenuSalir}"/>
            </MenuItem>
            <MenuItem x:Name="miSeleccion" Header="{i:T MainMenuSeleccion}">
              <MenuItem x:Name="miSelAll" Header="{i:T MainSeleccionarTodo}"/>
              <MenuItem x:Name="miSelNone" Header="{i:T MainQuitarSeleccion}"/>
              <MenuItem x:Name="miSelInvert" Header="{i:T MainInvertirSeleccion}"/>
              <Separator/>
              <MenuItem x:Name="miDelSel" Header="{i:T MainEnviarSeleccionPapelera}"/>
            </MenuItem>
            <MenuItem x:Name="miHerramientas" Header="{i:T MainMenuHerramientas}">
              <MenuItem x:Name="miRename" Header="{i:T MainMenuRenombrarSalida}"/>
              <Separator/>
              <MenuItem x:Name="miComplementos" Header="{i:T MainMenuComplementos}"/>
              <Separator/>
              <MenuItem x:Name="miPrefs" Header="{i:T MainMenuPreferencias}"/>
              <Separator/>
              <MenuItem x:Name="miCheckUpd" Header="{i:T MainBuscarActualizaciones}"/>
            </MenuItem>
            <MenuItem x:Name="miAyuda" Header="{i:T MainMenuAyuda}">
              <MenuItem x:Name="miTutoriales" Header="{i:T MainMenuTutoriales}"/>
              <Separator/>
              <MenuItem x:Name="miAbout" Header="{i:T MainMenuAcercaDe}"/>
            </MenuItem>
          </Menu>
        </StackPanel>
        <!-- ══ Conmutador de páginas: desplegable compacto ══ -->
        <!-- Un solo control muestra la página ACTUAL y abre la lista al pulsarlo, en lugar de una
             tira de pestañas anchas: así el conmutador ocupa lo MÍNIMO del header y escala a
             cualquier número de páginas sin comérselo. Los RadioButton de abajo (ocultos) siguen
             siendo el modelo de estado —IsChecked manda el cambio de página—; el desplegable solo
             los refleja y los activa. Cae dentro de los 40 px de CaptionHeight, así que necesita
             IsHitTestVisibleInChrome o se tragaría los clics. -->
        <Grid Grid.Column="1" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <!-- Modelo de estado OCULTO: los RadioButton deciden la página (IsChecked → CambiarPagina).
               El Content es el nombre de la página: OnMasTabs arma el desplegable copiándolo, así que
               el menú habla el idioma en curso sin una segunda tabla de nombres que mantener. -->
          <StackPanel x:Name="panelTabs" Orientation="Horizontal" Visibility="Collapsed">
            <RadioButton x:Name="tabComprimir" Style="{StaticResource PageTab}" IsChecked="True" GroupName="pagina"
                         Content="{i:T MainPaginaComprimir}"/>
            <RadioButton x:Name="tabOrganizar" Style="{StaticResource PageTab}" GroupName="pagina" Content="{i:T MainPaginaOrganizar}"/>
            <RadioButton x:Name="tabRecortes" Style="{StaticResource PageTab}" GroupName="pagina" Content="{i:T MainPaginaRecortes}"/>
          </StackPanel>

          <!-- En fila. El Grid de fuera NO tiene columnas, así que apila a sus hijos
               en la misma celda: el botón de complementos quedaba DEBAJO del
               conmutador y no se veía. Un contenedor que coloca en capas no sirve
               para poner dos cosas al lado. -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

          <!-- El botón de complementos, al estilo de las extensiones de un navegador:
               una pieza, y detrás los que sirvan AQUÍ. Va pegado al conmutador de
               página porque lo que enseña depende de en qué página estés, y ponerlo
               lejos rompería esa relación. Se esconde cuando no hay ninguno: un botón
               que solo dice «no hay nada» es un botón que estorba. -->
          <Button x:Name="btnComplementos" Style="{StaticResource PageSelector}"
                  Margin="0,0,4,0" Visibility="Collapsed" Click="OnBotonComplementos"
                  ToolTip="{i:T MainComplementosTip}">
            <StackPanel Orientation="Horizontal">
              <!-- Una pieza de puzle dibujada con la geometría mínima: no hay
                   librería de iconos en el proyecto y no se va a traer una por esto. -->
              <Path Data="M4,4 h3 a1.6,1.6 0 1 1 3,0 h3 v3 a1.6,1.6 0 1 0 0,3 v3 h-3 a1.6,1.6 0 1 0 -3,0 h-3 v-3 a1.6,1.6 0 1 1 0,-3 z"
                    Fill="{StaticResource Neutral400}" Width="17" Height="17" Stretch="Uniform"
                    VerticalAlignment="Center"/>
              <TextBlock x:Name="lblCuantosComplementos" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Desplegable compacto: página actual + «▾». Al pulsarlo se despliega la lista. -->
          <Button x:Name="btnPagina" Style="{StaticResource PageSelector}" Click="OnMasTabs"
                  Margin="0,0,4,0" ToolTip="{i:T MainCambiarPagina}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="lblPaginaActual" Text="{i:T MainPaginaComprimir}" VerticalAlignment="Center"/>
              <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource Neutral400}" StrokeThickness="1.4"
                    Width="12" Height="12" Stretch="None" Margin="9,1,0,0" VerticalAlignment="Center"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </StackPanel>
          </Button>
          </StackPanel>
        </Grid>

        <!-- ══ Grupo derecho: píldora de proceso + botones de ventana ══ -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">

          <!-- ══ Píldora de trabajo en segundo plano ══ -->
          <!-- Al cambiar de página la compresión sigue: si no se dijera aquí, parecería
               que se ha detenido. El punto late para que se lea como «vivo» sin ruido. -->
          <Border x:Name="pillFondo" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}"
                  BorderThickness="1" CornerRadius="8" Padding="11,4" Margin="0,0,14,0"
                  Visibility="Collapsed" Cursor="Hand" ToolTip="{i:T MainPildoraTip}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="pillDot" Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center"
                       Margin="0,0,8,0">
                <Ellipse.CacheMode>
                  <BitmapCache/>
                </Ellipse.CacheMode>
                <Ellipse.Effect>
                  <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#968AE0" Opacity="0.9"
                                    RenderingBias="Performance"/>
                </Ellipse.Effect>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <!-- Solo late la OPACIDAD del elemento: como el halo es su efecto,
                             se atenúan juntos y en el mismo compás — igual que cuando el
                             latido animaba el radio del blur, pero sin recalcular el
                             desenfoque en cada fotograma (1,4 % de CPU constante, medido;
                             con el blur fijo y cacheado, nada). -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:1.2"
                                         AutoReverse="True" RepeatBehavior="Forever"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <TextBlock x:Name="lblPill" Text="{i:T MainPildoraComprimiendo}" FontSize="12" Foreground="{StaticResource Neutral300}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <Button x:Name="btnMin" Style="{StaticResource BtnTitle}">
            <Path Data="M2,8 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="14" Height="14" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="btnMax" Style="{StaticResource BtnTitle}">
            <Border Width="9" Height="9" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.2" CornerRadius="1.5"/>
          </Button>
          <Button x:Name="btnClose" Style="{StaticResource BtnClose}">
            <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="13" Height="13" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ══ Origen / Destino ══ -->
      <Grid x:Name="rowOrigen" Grid.Row="2" Margin="16,4,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{i:T MainOrigen}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
          <!-- Grid y no StackPanel horizontal: el horizontal da ancho infinito a sus hijos,
               asi que el campo se quedaba clavado en 330 px y la ventana no podia encoger. -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:CampoTexto x:Name="txtSrc" Icono="M1.5 3.5h4l1.5 2h7.5v7h-13z" MinWidth="120"/>
            <Button x:Name="btnSrc" Grid.Column="1" Style="{StaticResource BtnSecondary}" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="{i:T MainElegirCarpetaTip}">
              <Viewbox Width="15" Height="15"><Path Data="M1.5 3.5h4l1.5 2h7.5l-2 7h-11z M1.5 3.5v9h11" Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Viewbox>
            </Button>
            <Button x:Name="btnSrcFile" Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="34" Margin="6,0,0,0" ToolTip="{i:T MainAnadirArchivosTip}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M4 1.5h5l3 3v10h-8z M9 1.5v3h3 M6.5 9.5h3 M8 8v3" Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"/></Viewbox>
                <TextBlock Text="{i:T MainAnadirArchivos}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock VerticalAlignment="Center" Margin="0,0,0,4"><Run Text="{i:T MainDestino}" FontSize="11" Foreground="#9397AB"/><Run Text="{i:T MainOpcional}" FontSize="11" Foreground="#595D6C"/></TextBlock>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <local:CampoTexto x:Name="txtOut" MinWidth="100"
                              ToolTip="{i:T MainDestinoTip}"/>
            <Button x:Name="btnOut" Grid.Column="1" Style="{StaticResource BtnSecondary}" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="{i:T MainElegirDestinoTip}">
              <Viewbox Width="15" Height="15"><Path Data="M1.5 3.5h4l1.5 2h7.5l-2 7h-11z M1.5 3.5v9h11" Stroke="{StaticResource Text}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Viewbox>
            </Button>
          </Grid>
        </StackPanel>
      </Grid>

      <!-- ══ Panel de opciones ══ -->
      <Border x:Name="rowOpciones" Grid.Row="3" Margin="16,0,16,0" Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MaxWidth="260"/>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{i:T MainPreset}" FontSize="11" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cboPreset" Grid.Column="1" MinWidth="90" VerticalAlignment="Center" DisplayMemberPath="Name"
                      ToolTip="{i:T MainPresetTip}"/>
            <Button x:Name="btnSavePreset" Grid.Column="2" Style="{StaticResource BtnSecondary}" Content="{i:T MainGuardarPreset}" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                    ToolTip="{i:T MainGuardarPresetTip}"/>
            <Button x:Name="btnRename" Grid.Column="3" Style="{StaticResource BtnSecondary}" FontSize="12" Padding="10,4" Margin="8,0,0,0"
                    ToolTip="{i:T MainRenombrarTip}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                  <Path Data="M2 11.5l7.5-7.5 2.5 2.5-7.5 7.5H2z M9.5 4l2.5 2.5 1.5-1.5-2.5-2.5z"
                        Stroke="{StaticResource Neutral400}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                </Viewbox>
                <TextBlock x:Name="lblRename" Text="{i:T MainRenombrarSalida}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainIdiomaPrincipal}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <!-- El valor de partida («spa») lo pone el constructor: aquí sería texto suelto, y
                   además lo pisa en cuanto arranca el idioma por defecto de Preferencias. -->
              <ComboBox x:Name="cboLang" IsEditable="True"
                        ToolTip="{i:T MainIdiomaPrincipalTip}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainFormato}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <!-- El ORDEN de estos elementos está acoplado a los índices de BuildOptions: se
                   traduce el rótulo, nunca se reordena la lista. -->
              <ComboBox x:Name="cboFmt" SelectedIndex="0"
                        ToolTip="{i:T MainFormatoTip}">
                <ComboBoxItem Content="{i:T MainFormatoMkv}"/><ComboBoxItem Content="{i:T MainFormatoMp4}"/><ComboBoxItem Content="{i:T MainFormatoWebm}"/>
                <ComboBoxItem Content="{i:T MainFormatoMp3}"/><ComboBoxItem Content="{i:T MainFormatoM4a}"/>
                <ComboBoxItem Content="{i:T MainFormatoFlac}"/><ComboBoxItem Content="{i:T MainFormatoOpus}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainCodec}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <ComboBox x:Name="cboCodec" SelectedIndex="0"
                        ToolTip="{i:T MainCodecTip}">
                <ComboBoxItem Content="{i:T MainCodecH265}"/><ComboBoxItem Content="{i:T MainCodecH264}"/><ComboBoxItem Content="{i:T MainCodecAv1}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainCalidad}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <ComboBox x:Name="cboQ" SelectedIndex="0"
                        ToolTip="{i:T MainCalidadTip}">
                <ComboBoxItem Content="{i:T MainCalidadAuto}"/><ComboBoxItem Content="{i:T MainCalidad22}"/><ComboBoxItem Content="{i:T MainCalidad24}"/>
                <ComboBoxItem Content="{i:T MainCalidad27}"/><ComboBoxItem Content="{i:T MainCalidad30}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainResolucionMax}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <ComboBox x:Name="cboRes" SelectedIndex="0"
                        ToolTip="{i:T MainResolucionTip}">
                <ComboBoxItem Content="{i:T MainResolucionSinCambio}"/><ComboBoxItem Content="{i:T MainResolucion1080}"/><ComboBoxItem Content="{i:T MainResolucion720}"/><ComboBoxItem Content="{i:T MainResolucion480}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="5" Margin="0,0,10,0">
              <TextBlock Text="{i:T MainAudio}" FontSize="11" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
              <ComboBox x:Name="cboAud" SelectedIndex="0"
                        ToolTip="{i:T MainAudioTip}">
                <ComboBoxItem Content="{i:T MainAudioCopiar}"/><ComboBoxItem Content="{i:T MainAudioAac192}"/>
                <ComboBoxItem Content="{i:T MainAudioAac160}"/><ComboBoxItem Content="{i:T MainAudioAac128}"/><ComboBoxItem Content="{i:T MainAudioAac96}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="6" Margin="4,0,0,0" Orientation="Vertical">
              <StackPanel.Resources><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="8,1"/></Style></StackPanel.Resources>
              <Border BorderBrush="{StaticResource Divider}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                <StackPanel>
                  <CheckBox x:Name="chkRec" Content="{i:T MainSubcarpetas}"
                            ToolTip="{i:T MainSubcarpetasTip}"/>
                  <CheckBox x:Name="chkForce" Content="{i:T MainReprocesar}"
                            ToolTip="{i:T MainReprocesarTip}"/>
                  <CheckBox x:Name="chkDry" Content="{i:T MainSoloSimular}"
                            ToolTip="{i:T MainSoloSimularTip}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{i:T MainAudioDetectado}" Width="106" FontSize="11" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center"/>
                <WrapPanel x:Name="pnlALang" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{i:T MainSubtitulos}" Width="106" FontSize="11" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center"/>
                <WrapPanel x:Name="pnlSLang" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblLangHint" Text="{i:T MainPistaIdiomas}" FontSize="11" Foreground="{StaticResource Neutral700}" VerticalAlignment="Center" Margin="4,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ══ Tabla + panel lateral ══ -->
      <Grid x:Name="rowTabla" Grid.Row="4" Margin="16,10,16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <!-- Se pliega solo por debajo de cierto ancho: con la ventana estrecha, 262 px de
               panel secundario le quitan a la tabla justo lo que necesita para leerse. -->
          <ColumnDefinition x:Name="colLateral" Width="262"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="0,4" ClipToBounds="True">
          <Grid>
            <ListView x:Name="lst" Style="{StaticResource TableView}" SelectionMode="Extended" SelectionChanged="OnSelectionChanged">
              <ListView.ContextMenu>
                <ContextMenu x:Name="ctxTable">
                  <MenuItem x:Name="miCtxRemove" Header="{i:T MainCtxQuitar}" InputGestureText="{i:T MainTeclaSuprimir}"/>
                  <MenuItem x:Name="miCtxRecycle" Header="{i:T MainCtxPapelera}"/>
                  <Separator/>
                  <!-- Quitar un doblaje o unos subtítulos que no vas a usar NO necesita
                       recomprimir: se reempaqueta copiando los datos, en segundos y sin tocar
                       la imagen. Y un fichero con cinco audios lleva cientos de megas de más. -->
                  <MenuItem x:Name="miCtxPistas" Header="{i:T MainCtxPistas}"/>
                  <Separator/>
                  <MenuItem x:Name="miCtxOpenFolder" Header="{i:T MainCtxAbrirCarpeta}"/>
                  <MenuItem x:Name="miCtxCopyPath" Header="{i:T MainCtxCopiarRuta}"/>
                  <Separator/>
                  <!-- «Ctrl+A» es la combinación física de teclas, igual en los dos idiomas;
                       la de suprimir sí cambia de nombre (Supr / Del) y sale del catálogo. -->
                  <MenuItem x:Name="miCtxSelectAll" Header="{i:T MainSeleccionarTodo}" InputGestureText="Ctrl+A"/>
                  <MenuItem x:Name="miCtxInvert" Header="{i:T MainInvertirSeleccion}"/>
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                  <GridViewColumn Header="{i:T MainColVideo}" Width="316" DisplayMemberBinding="{Binding Name}" local:HeaderSort.Field="Name"/>
                  <GridViewColumn Header="{i:T MainColCarpeta}" Width="130" DisplayMemberBinding="{Binding Dir}" local:HeaderSort.Field="Dir"/>
                  <!-- TAMAÑO y DURACIÓN ordenan por su valor numérico (Bytes / DurationSec), no por el texto formateado -->
                  <GridViewColumn Header="{i:T MainColTamano}" Width="80" DisplayMemberBinding="{Binding SizeMB}" local:HeaderSort.Field="Bytes"/>
                  <GridViewColumn Header="{i:T MainColDuracion}" Width="76" DisplayMemberBinding="{Binding Dur}" local:HeaderSort.Field="DurationSec"/>
                  <GridViewColumn Header="{i:T MainColCodec}" Width="64" DisplayMemberBinding="{Binding Codec}" local:HeaderSort.Field="Codec"/>
                  <GridViewColumn Header="{i:T MainColAudio}" Width="88" DisplayMemberBinding="{Binding Audio}" local:HeaderSort.Field="Audio"/>
                  <GridViewColumn Header="{i:T MainColSubs}" Width="64" DisplayMemberBinding="{Binding Subs}" local:HeaderSort.Field="Subs"/>
                  <!-- El color solo REFUERZA: el texto ya distingue por sí solo (daltonismo) -->
                  <GridViewColumn Header="{i:T MainColEstado}" Width="132" local:HeaderSort.Field="Estado">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Estado}" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource Neutral500}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding EstadoBrush}" Value="Ok">
                                  <Setter Property="Foreground" Value="{StaticResource EstadoOk}"/>
                                  <Setter Property="FontWeight" Value="Medium"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EstadoBrush}" Value="Err">
                                  <Setter Property="Foreground" Value="{StaticResource EstadoErr}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EstadoBrush}" Value="Live">
                                  <Setter Property="Foreground" Value="{StaticResource Accent300}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <!-- estado vacío: guía en vez de un hueco en negro -->
            <StackPanel x:Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="420" IsHitTestVisible="False">
              <Viewbox Width="46" Height="46" HorizontalAlignment="Center" Opacity="0.5">
                <Path Data="M1.5 3.5h4l1.5 2h7.5v7h-13z" Stroke="{StaticResource Neutral600}"
                      StrokeThickness="1.1" StrokeLineJoin="Round"/>
              </Viewbox>
              <TextBlock Text="{i:T MainVacioTitulo}" FontSize="13.5" Foreground="{StaticResource Neutral400}"
                         HorizontalAlignment="Center" Margin="0,14,0,6"/>
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5" Foreground="{StaticResource Neutral600}"
                         Text="{i:T MainVacioTexto}"/>
            </StackPanel>

            <!-- banda de selección (rubber-band), estilo explorador -->
            <Canvas x:Name="marqueeCanvas" IsHitTestVisible="False">
              <Border x:Name="marquee" Visibility="Collapsed" Background="#33968AE0"
                      BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="1"/>
            </Canvas>
          </Grid>
        </Border>

        <Grid x:Name="sideCol" Grid.Column="1" Margin="10,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource Surface}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <DockPanel>
              <!-- pestañas del panel lateral (fijas arriba) -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="tabDetalle" BorderThickness="0,0,0,2" BorderBrush="{StaticResource Accent}" Padding="2,0,2,5" Margin="0,0,14,0" Cursor="Hand"
                        ToolTip="{i:T MainDetalleTip}">
                  <TextBlock Text="{i:T MainDetalle}" FontSize="12.5" Foreground="{StaticResource Accent300}"/>
                </Border>
                <Border x:Name="tabEstim" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,0,2,5" Cursor="Hand"
                        ToolTip="{i:T MainEstimacionTip}">
                  <TextBlock Text="{i:T MainEstimacion}" FontSize="12.5" Foreground="{StaticResource Neutral400}"/>
                </Border>
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
              <!-- Detalle -->
              <StackPanel x:Name="panelDetalle">
                <Border CornerRadius="4" Height="130" ClipToBounds="True">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#292B31" Offset="0"/><GradientStop Color="#161826" Offset="0.7"/></LinearGradientBrush>
                  </Border.Background>
                  <Image x:Name="imgPrev" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="lblPrevName" Margin="0,10,0,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="Medium" FontSize="12.5"/>
                <TextBlock x:Name="lblPrevInfo" Foreground="{StaticResource Neutral500}" TextWrapping="Wrap" FontSize="11.5"/>
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                  <StackPanel>
                    <!-- El rótulo lleva dentro el segundo de partida, así que lo escribe el
                         constructor con MainPrevisualizarDesde: una sola clave con {0} en vez
                         de dos (una con el «0:00» pegado) que se separarían a la primera. -->
                    <TextBlock x:Name="lblPreviewAt" FontSize="11" Foreground="{StaticResource Neutral500}"/>
                    <Slider x:Name="sldPreview" Style="{StaticResource TimelineSlider}" Minimum="0" Maximum="0"
                            Margin="0,6,0,8" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <Button x:Name="btnPreview" Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Center"
                            ToolTip="{i:T MainPrevisualizarTip}">
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0"><Path Data="M4 3l8 5-8 5z" Fill="{StaticResource Accent}"/></Viewbox>
                        <TextBlock Text="{i:T MainPrevisualizar10s}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Estimación -->
              <StackPanel x:Name="panelEstim" Visibility="Collapsed">
                <Border Background="{StaticResource Accent900}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="{i:T MainEstTamano}" FontSize="10" Foreground="{StaticResource Accent400}"/>
                    <TextBlock x:Name="lblEstSize" Text="—" FontSize="18" FontWeight="Medium" Foreground="{StaticResource Accent200}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="lblEstSaving" Text="{i:T MainEstSinSeleccion}" FontSize="11.5" Foreground="{StaticResource Accent300}"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{i:T MainEstVideo}" FontSize="10" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{i:T MainCalidad}" FontSize="11" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"/>
                  <StackPanel x:Name="barVQ" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{i:T MainAhorro}" FontSize="11" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"/>
                  <StackPanel x:Name="barVS" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{i:T MainEstAudio}" FontSize="10" Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{i:T MainCalidad}" FontSize="11" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"/>
                  <StackPanel x:Name="barAQ" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{i:T MainAhorro}" FontSize="11" Foreground="{StaticResource Neutral400}" VerticalAlignment="Center"/>
                  <StackPanel x:Name="barAS" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="lblEstDetail" FontSize="10.5" Foreground="{StaticResource Neutral600}" TextWrapping="Wrap"/>
                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                  <StackPanel>
                    <Button x:Name="btnMeasure" Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Center"
                            ToolTip="{i:T MainMedirTip}">
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                          <Path Data="M2 12h12 M4 12V7 M8 12V3 M12 12V9" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="{i:T MainMedir}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <TextBlock x:Name="lblMeasure" FontSize="10.5" Foreground="{StaticResource Neutral600}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{i:T MainMedirNota}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="8" Padding="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="btnMarkAll" Style="{StaticResource BtnSecondary}" Content="{i:T MainSeleccionarTodo}" FontSize="12" Padding="5,6" Width="112" Margin="0,0,6,0"
                        ToolTip="{i:T MainSeleccionarTodoTip}"/>
                <Button x:Name="btnMarkNone" Style="{StaticResource BtnSecondary}" Content="{i:T MainQuitarSeleccion}" FontSize="12" Padding="5,6" Width="112"
                        ToolTip="{i:T MainQuitarSeleccionTip}"/>
              </StackPanel>
              <Button x:Name="btnDelSel" Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Left" FontSize="12" Padding="10,6" Margin="0,0,0,6" ToolTip="{i:T MainEnviarSeleccionPapelera}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="13" Height="13" Margin="0,0,7,0"><Path Data="M2.5 4h11 M5.5 4V2.5h5V4 M4 4l.8 9.5h6.4L12 4 M6.7 6.5v4.5 M9.3 6.5v4.5" Stroke="{StaticResource Neutral400}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"/></Viewbox>
                  <TextBlock Text="{i:T MainEliminarSeleccion}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="btnDelDir" Style="{StaticResource BtnSecondary}" HorizontalContentAlignment="Left" FontSize="12" Padding="10,6" ToolTip="{i:T MainEliminarCarpetaTip}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="13" Height="13" Margin="0,0,7,0"><Path Data="M2.5 4h11 M5.5 4V2.5h5V4 M4 4l.8 9.5h6.4L12 4" Stroke="{StaticResource Neutral400}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"/></Viewbox>
                  <TextBlock Text="{i:T MainEliminarCarpeta}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ══ Progreso ══ -->
      <Grid x:Name="progRow" Grid.Row="5" Margin="16,8,16,0" Visibility="Collapsed">
        <ProgressBar x:Name="bar" Minimum="0" Maximum="1" Value="0"/>
      </Grid>

      <!-- ══ Acciones ══ -->
      <Grid x:Name="rowAcciones" Grid.Row="6" Margin="16,10,16,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- WrapPanel: al estrechar, los botones bajan a otra linea en vez de recortarse.
             Es lo que hace que la ventana pueda encoger sin perder ninguna accion. -->
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="btnScan" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                  ToolTip="{i:T MainAnalizarTip}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="16" Height="16"><Ellipse Width="9" Height="9" Canvas.Left="2.5" Canvas.Top="2.5" Stroke="#968AE0" StrokeThickness="1.5"/><Path Data="M10.5 10.5L14 14" Stroke="#968AE0" StrokeThickness="1.5" StrokeStartLineCap="Round"/></Canvas></Viewbox>
              <TextBlock Text="{i:T MainAnalizar}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="btnRun" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                  ToolTip="{i:T MainComprimirTip}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M2 2l4 4M6 3.5V6H3.5M14 14l-4-4M10 12.5V10h2.5" Stroke="#968AE0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
              <TextBlock Text="{i:T MainComprimirSeleccion}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="btnPause" Style="{StaticResource BtnSecondary}" Content="{i:T MainPausar}" IsEnabled="False" Margin="0,0,8,0"
                  ToolTip="{i:T MainPausarTip}"/>
          <Button x:Name="btnCancel" Style="{StaticResource BtnSecondary}" Content="{i:T MainDetener}" IsEnabled="False" Margin="0,0,8,0"
                  ToolTip="{i:T MainDetenerTip}"/>
          <Button x:Name="btnOpen" Style="{StaticResource BtnGhost}"
                  ToolTip="{i:T MainAbrirDestinoTip}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M1.5 3.5h4l1.5 2h7.5l-2 7h-11z M1.5 3.5v9h11" Stroke="#968AE0" StrokeThickness="1.4" StrokeLineJoin="Round"/></Viewbox>
              <TextBlock Text="{i:T MainAbrirDestino}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="lblProg" Text="{i:T MainProgresoListo}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Neutral500}"
                     Margin="0,0,12,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="btnCheckUpdate" Style="{StaticResource BtnGhostMuted}" Content="{i:T MainBuscarActualizaciones}"/>
        </StackPanel>
      </Grid>

      <!-- ══ Página «Organizar» ══ -->
      <!-- Ocupa las mismas filas que la página de compresión (2..6) y se turnan por
           visibilidad: cada oficio tiene su propia lista y su propio ciclo de vida, pero
           comparten ventana, barra de título y registro. -->
      <local:OrganizarView x:Name="pageOrganizar" Grid.Row="2" Grid.RowSpan="5" Visibility="Collapsed"/>
      <local:RecortesView x:Name="pageRecortes" Grid.Row="2" Grid.RowSpan="5" Visibility="Collapsed"/>

      <!-- ══ Registro ══ -->
      <StackPanel Grid.Row="7" Margin="16,0,16,10">
        <Rectangle Height="1" Fill="{StaticResource FadedRule}" Margin="0,0,0,6"/>
        <ToggleButton x:Name="tglLog" Cursor="Hand" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
          <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <Path x:Name="car" Data="M5 3l6 5-6 5" Stroke="{StaticResource Neutral500}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                <TextBlock Text="{i:T MainRegistro}" Margin="7,0,0,0" FontSize="11.5" Foreground="{StaticResource Neutral500}" VerticalAlignment="Center"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="car" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>
        <Border Margin="0,6,0,0" Background="{StaticResource Field}" CornerRadius="4"
                Visibility="{Binding IsChecked, ElementName=tglLog, Converter={StaticResource B2V}}">
          <TextBox x:Name="txtLog" Height="120" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Neutral400}" FontFamily="{StaticResource FontMono}" FontSize="11"
                   Padding="10,8" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </Border>
      </StackPanel>

      <!-- ══ Panel lateral de complementos ══
           Desde la fila 1: la barra de título sigue cruzando entera, porque es
           la franja que WindowChrome reserva para arrastrar la ventana y
           partirla deja media ventana sin agarre. -->
      <Grid x:Name="panelLateral" Grid.Column="1" Grid.Row="1" Grid.RowSpan="7"
            Visibility="Collapsed">
        <ContentControl x:Name="huecoPanel" Margin="9,0,0,0"/>
      </Grid>

      <!-- El tirador va AQUÍ, hermano del panel y no dentro de él: un
           GridSplitter solo mueve las columnas de SU Grid padre. Metido dentro
           estiraba las columnas interiores del panel -que no son la que manda- y
           por fuera no se movía nada. Se dibuja sobre el borde izquierdo de la
           columna del panel, que es donde se busca con el ratón. -->
      <!-- El tirador SE VE. Transparente cumplía como zona de arrastre y no
           existía como pista: un borde que se puede mover y no lo parece no lo
           mueve nadie. Lleva la línea divisoria dentro -es la misma cosa, no dos-
           y al pasar por encima se enciende, que es lo que dice «esto se agarra». -->
      <GridSplitter x:Name="tirador" Grid.Column="1" Grid.Row="1" Grid.RowSpan="7"
                    Width="9" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent"
                    Cursor="SizeWE" Panel.ZIndex="10" Visibility="Collapsed">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="linea" Width="1" HorizontalAlignment="Center"
                      Background="{StaticResource Divider}"/>
              <!-- Tres puntos en el centro: la señal de agarre de toda la vida,
                   y no cuesta ni una línea de altura. -->
              <StackPanel x:Name="puntos" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Opacity="0.55">
                <Ellipse Width="2.5" Height="2.5" Margin="0,2" Fill="{StaticResource Neutral500}"/>
                <Ellipse Width="2.5" Height="2.5" Margin="0,2" Fill="{StaticResource Neutral500}"/>
                <Ellipse Width="2.5" Height="2.5" Margin="0,2" Fill="{StaticResource Neutral500}"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="linea" Property="Background" Value="{StaticResource Accent300}"/>
                <Setter TargetName="linea" Property="Width" Value="2"/>
                <Setter TargetName="puntos" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>
    </Grid>
  </Border>
</Window>
