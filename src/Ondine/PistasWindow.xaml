<Window x:Class="Ondine.PistasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T PistasTitulo}" Width="700" Height="560" MinWidth="480" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Height="38">
        <TextBlock x:Name="lblTitulo" Text="{i:T PistasTitulo}" FontSize="13.5" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
        <Button x:Name="btnCerrar" Style="{StaticResource BtnClose}" HorizontalAlignment="Right"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="13" Height="13" Stretch="None"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,4,16,10">
        <TextBlock x:Name="lblFichero" FontSize="12.5" Foreground="{StaticResource Text}"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral500}" TextWrapping="Wrap"
                   Text="{i:T PistasAyuda}"/>
      </StackPanel>

      <ListBox x:Name="lista" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- La de vídeo no se puede quitar: sin ella el resultado ya no es este vídeo. -->
              <CheckBox IsChecked="{Binding Quitar, Mode=TwoWay}" IsEnabled="{Binding SePuedeQuitar}"
                        VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="{Binding Resumen}" FontSize="12.5" VerticalAlignment="Center"
                         Foreground="{StaticResource Text}"/>
              <TextBlock Grid.Column="2" Text="{Binding Nota}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{StaticResource Neutral500}" Margin="8,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="3" Margin="16,10,16,14">
        <TextBlock x:Name="lblAviso" FontSize="11.5" Foreground="{StaticResource OrgWarn}"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
        <Grid>
          <TextBlock x:Name="lblAhorro" FontSize="12" Foreground="{StaticResource Neutral400}"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancelar" Style="{StaticResource BtnGhost}" Content="{i:T Cancelar}"
                    FontSize="12" Margin="0,0,8,0"/>
            <Button x:Name="btnQuitar" Style="{StaticResource BtnPrimary}" Content="{i:T PistasQuitarMarcadas}"
                    FontSize="12" Padding="12,5" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
