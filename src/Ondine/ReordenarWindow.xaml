<Window x:Class="Ondine.ReordenarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T ReordenarTitulo}" Width="760" Height="620" MinWidth="520" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><!-- título -->
        <RowDefinition Height="Auto"/><!-- resumen y opciones -->
        <RowDefinition Height="*"/>   <!-- lista -->
        <RowDefinition Height="Auto"/><!-- pie -->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Height="38">
        <TextBlock Text="{i:T ReordenarTitulo}" FontSize="13.5" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
        <Button x:Name="btnCerrar" Style="{StaticResource BtnClose}" HorizontalAlignment="Right"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="13" Height="13" Stretch="None"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,4,16,10">
        <!-- El idioma de la carpeta se elige AQUÍ y no en preferencias porque es
             donde se ve el efecto: cambiarlo repinta la lista al momento. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="{i:T ReordenarIdiomaCarpeta}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{StaticResource Neutral400}" Margin="0,0,8,0"/>
          <ComboBox x:Name="cboIdioma" MinWidth="170" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="lblResumen" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>

        <CheckBox x:Name="chkSoloLosQueVan" Margin="0,8,0,0" FontSize="12" IsChecked="True"
                  Foreground="{StaticResource Neutral400}"
                  Content="{i:T ReordenarVerSoloLosQueVan}"/>
      </StackPanel>

      <ListBox x:Name="lista" Grid.Row="2" Background="Transparent" BorderThickness="0"
               Margin="8,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingStackPanel.IsVirtualizing="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Nombre}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource Text}"/>
                <TextBlock Text="{Binding Adonde}" FontFamily="{StaticResource FontMono}" FontSize="11"
                           Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Neutral500}"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{StaticResource Field}" CornerRadius="6" Padding="7,2"
                      VerticalAlignment="Top" Margin="8,0,0,0">
                <TextBlock Text="{Binding Etiqueta}" FontSize="10.5" Foreground="{Binding Color}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Margin="16,10,16,14">
        <TextBlock x:Name="lblPie" FontSize="11" Foreground="{StaticResource Neutral500}"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0"
                   Text="{i:T ReordenarPie}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnDeshacer" Style="{StaticResource BtnGhostMuted}" FontSize="12" Padding="12,5"
                  Margin="0,0,8,0" Visibility="Collapsed" Content="{i:T ReordenarDeshacer}"/>
          <Button x:Name="btnMover" Style="{StaticResource BtnPrimary}" FontSize="12" Padding="14,5"
                  Content="{i:T ReordenarBotonNada}" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
