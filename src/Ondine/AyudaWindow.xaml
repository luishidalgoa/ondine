<Window x:Class="Ondine.AyudaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T AyudaTitulo}" Width="900" Height="680" MinWidth="720" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Neutral400}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14E9E9ED"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource Neutral300}"/><Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Neutral400}"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,7"/>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- ═ barra de título ═ -->
      <Grid Grid.Row="0">
        <!-- La marca, igual que en la ventana principal: mismo dibujo, sin contenedor. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Viewbox Width="18" Height="18" VerticalAlignment="Center">
            <Canvas Width="64" Height="64">
              <Canvas.Resources>
                <Style TargetType="Path">
                  <Setter Property="Stroke" Value="#B5ABFC"/>
                  <Setter Property="StrokeThickness" Value="6"/>
                  <Setter Property="StrokeStartLineCap" Value="Round"/>
                  <Setter Property="StrokeEndLineCap" Value="Round"/>
                  <Setter Property="StrokeLineJoin" Value="Round"/>
                </Style>
              </Canvas.Resources>
              <Path Data="M7,17 C15.5,9 26.5,25 35,17 C43.5,9 48.5,25 57,17"/>
              <Path Data="M7,32 C16,28 26,36 35,32 C44,28 48,36 57,32"/>
              <Path Data="M7,47 L57,47"/>
            </Canvas>
          </Viewbox>
          <TextBlock Text="{i:T AyudaTitulo}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <Button x:Name="btnCerrar" Style="{StaticResource BtnClose}" HorizontalAlignment="Right"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="13" Height="13" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ═ índice lateral ═ -->
        <Border Grid.Column="0" Background="#151725" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
          <StackPanel Margin="10,14">
            <TextBlock Text="{i:T AyudaNavCabecera}" FontSize="11" Foreground="{StaticResource Neutral600}" Margin="12,0,0,8"/>
            <RadioButton x:Name="navOrgComo" Style="{StaticResource NavItem}" GroupName="pag" IsChecked="True" Content="{i:T AyudaNavOrgComo}"/>
            <RadioButton x:Name="navOrgPasos" Style="{StaticResource NavItem}" GroupName="pag" Content="{i:T AyudaNavOrgPasos}"/>
            <RadioButton x:Name="navComprimir" Style="{StaticResource NavItem}" GroupName="pag" Content="{i:T AyudaNavComprimir}"/>
            <RadioButton x:Name="navRecortes" Style="{StaticResource NavItem}" GroupName="pag" Content="{i:T AyudaNavRecortes}"/>
          </StackPanel>
        </Border>

        <!-- ═ contenido ═ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,26">
          <Grid>

            <!-- ── Organizar · cómo funciona ── -->
            <StackPanel x:Name="pagOrgComo">
              <TextBlock Style="{StaticResource H2}" Text="{i:T AyudaOrgComoTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgComoIntro}"/>

              <TextBlock Style="{StaticResource H3}" Text="{i:T AyudaOrgComoLeeTitulo}"/>
              <WrapPanel>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="{i:T AyudaOrgComoChipNombre}" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="{i:T AyudaOrgComoChipNombreSub}" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="{i:T AyudaOrgComoChipCarpeta}" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="{i:T AyudaOrgComoChipCarpetaSub}" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="{i:T AyudaOrgComoChipMetadato}" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="{i:T AyudaOrgComoChipMetadatoSub}" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Background="{StaticResource Accent900}" BorderBrush="{StaticResource Accent700}">
                  <StackPanel><TextBlock Text="{i:T AyudaOrgComoChipCatalogo}" FontSize="13" Foreground="{StaticResource Accent200}"/><TextBlock Text="{i:T AyudaOrgComoChipCatalogoSub}" FontSize="11" Foreground="{StaticResource Accent300}"/></StackPanel>
                </Border>
              </WrapPanel>
              <TextBlock Style="{StaticResource P}" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}"
                         Text="{i:T AyudaOrgComoNotaMetadato}"/>

              <TextBlock Style="{StaticResource H3}" Text="{i:T AyudaOrgComoReglasTitulo}"/>
              <StackPanel>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="0" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoRegla0Etiqueta}" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoRegla0}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="1" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoEtiquetaSeguro}" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoRegla1}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="2" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoEtiquetaSeguro}" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoRegla2}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgWarnBg}" BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="3" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoEtiquetaRevisar}" FontSize="12" Foreground="{StaticResource OrgWarn}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoRegla3}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgWarnBg}" BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="4" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoEtiquetaRevisar}" FontSize="12" Foreground="{StaticResource OrgWarn}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoRegla4}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Background="{StaticResource OrgDangerBg}" BorderBrush="{StaticResource OrgDangerBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="◆" FontSize="11" Foreground="{StaticResource OrgDanger}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{i:T AyudaOrgComoEtiquetaConflicto}" FontSize="12" Foreground="{StaticResource OrgDanger}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="{i:T AyudaOrgComoConflicto}" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
              </StackPanel>
              <TextBlock Style="{StaticResource P}" Margin="0,10,0,0" FontSize="11.5">
                <Run Foreground="{StaticResource OrgOk}" Text="●"/><Run Foreground="{StaticResource Neutral500}" Text="{i:T AyudaOrgComoLeyendaVerde}"/>
                <Run Foreground="{StaticResource OrgWarn}" Text="●"/><Run Foreground="{StaticResource Neutral500}" Text="{i:T AyudaOrgComoLeyendaAmbar}"/>
                <Run Foreground="{StaticResource OrgDanger}" Text="●"/><Run Foreground="{StaticResource Neutral500}" Text="{i:T AyudaOrgComoLeyendaRojo}"/>
              </TextBlock>

              <TextBlock Style="{StaticResource H3}" Text="{i:T AyudaOrgComoRequisitosTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgComoRequisito1}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgComoRequisito2}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgComoRequisito3}"/>
            </StackPanel>

            <!-- ── Organizar · paso a paso ── -->
            <StackPanel x:Name="pagOrgPasos" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="{i:T AyudaOrgPasosTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgPaso1}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgPaso2}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosVinculadas}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgPaso3}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgPaso4}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosCorregirFila}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosFueraCatalogo}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosHistoriasMezcladas}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaOrgPaso5}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosQueFalta}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosRepetido}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosSegmentos}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosReordenar}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosTipo}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaOrgPasosOrdenar}"/>
            </StackPanel>

            <!-- ── Comprimir ── -->
            <StackPanel x:Name="pagComprimir" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="{i:T AyudaComprimirTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaComprimirPaso1}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaComprimirPaso2}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaComprimirPaso3}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaComprimirPaso4}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaComprimirPaso5}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaComprimirPapelera}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaComprimirQuitarPistas}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaComprimirDiscoLleno}"/>
            </StackPanel>

            <!-- ── Recortes ── -->
            <StackPanel x:Name="pagRecortes" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="{i:T AyudaRecortesTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesPaso1}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesPaso2}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesPaso3}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesPaso4}"/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="{i:T AyudaRecortesPapelera}"/>
              <TextBlock Style="{StaticResource H3}" Text="{i:T AyudaRecortesSinRecodificarTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesSinRecodificar}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesSinRecodificarTrato}"/>
              <TextBlock Style="{StaticResource H3}" Text="{i:T AyudaRecortesConOrganizarTitulo}"/>
              <TextBlock Style="{StaticResource P}" Text="{i:T AyudaRecortesConOrganizar}"/>
            </StackPanel>

          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
