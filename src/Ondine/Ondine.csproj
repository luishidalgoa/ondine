<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ondine</AssemblyName>
    <RootNamespace>Ondine</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Versión: única fuente para el ejecutable, el instalador y el auto-update -->
    <Version>1.14.4</Version>
    <Product>Ondine</Product>
    <!-- FileDescription del exe: es el nombre que muestra el submenú «Abrir con» -->
    <AssemblyTitle>Ondine</AssemblyTitle>
    <Company>luishidalgoa</Company>
    <Authors>luishidalgoa</Authors>
    <Description>Ondine: batch video compressor. Shrinks to HEVC/H.264/AV1 in MKV/MP4/WebM with hardware acceleration, keeps the audio languages you choose, and never touches the originals.</Description>
    <Copyright>© luishidalgoa</Copyright>

    <!-- Repo de GitHub del que la app descarga sus actualizaciones -->
    <UpdateRepo>luishidalgoa/ondine</UpdateRepo>
  </PropertyGroup>

  <!-- Marca de compilación local/dev. La build OFICIAL (build.ps1, en CI) pasa -p:Official=true
       y NO define esta constante; cualquier otra compilación (dotnet build/publish en local) sí,
       para que la etiqueta de versión distinga el dev de la release de GitHub. -->
  <PropertyGroup Condition="'$(Official)' != 'true'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepo</_Parameter1>
      <_Parameter2>$(UpdateRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- El motor. Antes vivia aqui dentro y la CLI y las pruebas lo tomaban prestado
       fichero a fichero; ahora es un proyecto y se referencia. La clave de TMDb se
       hornea ALLI, no aqui: quien la lee es ClaveDeTmdb, que esta en el motor y la
       busca en su propio ensamblado. -->
  <ItemGroup>
    <ProjectReference Include="..\Ondine.Core\Ondine.Core.csproj" />
  </ItemGroup>

  <!-- El arnes de humo entra por los mismos caminos que la pantalla, no por copias de
       ellos. Para eso necesita ver los enganches internos -encolar sin pasar por la
       seleccion de WPF, por ejemplo-. Se abre a el y a nadie mas: hacerlos publicos seria
       inventar una API que nadie ha disenado. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ui-smoke</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
