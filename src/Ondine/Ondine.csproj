<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ondine</AssemblyName>
    <RootNamespace>Ondine</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Versión: única fuente para el ejecutable, el instalador y el auto-update -->
    <Version>1.9.2</Version>
    <Product>Ondine</Product>
    <!-- FileDescription del exe: es el nombre que muestra el submenú «Abrir con» -->
    <AssemblyTitle>Ondine</AssemblyTitle>
    <Company>luishidalgoa</Company>
    <Authors>luishidalgoa</Authors>
    <Description>Ondine: batch video compressor. Shrinks to HEVC/H.264/AV1 in MKV/MP4/WebM with hardware acceleration, keeps the audio languages you choose, and never touches the originals.</Description>
    <Copyright>© luishidalgoa</Copyright>

    <!-- Repo de GitHub del que la app descarga sus actualizaciones -->
    <UpdateRepo>luishidalgoa/ondine</UpdateRepo>
  </PropertyGroup>

  <!-- Marca de compilación local/dev. La build OFICIAL (build.ps1, en CI) pasa -p:Official=true
       y NO define esta constante; cualquier otra compilación (dotnet build/publish en local) sí,
       para que la etiqueta de versión distinga el dev de la release de GitHub. -->
  <PropertyGroup Condition="'$(Official)' != 'true'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateRepo</_Parameter1>
      <_Parameter2>$(UpdateRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- La clave de TMDb, horneada SOLO si se pasa. Viaja como metadato del
       ensamblado, igual que UpdateRepo, y la lee ClaveDeTmdb.
       En CI sale de un secreto por la variable de entorno ONDINE_TMDB_KEY; en
       local se puede pasar con -p:TmdbKey=...  Sin ella la app compila y arranca
       igual: la identificacion queda apagada y lo dice, y quien quiera usarla
       pone su propia clave en Preferencias. Es lo que hace que clonar el repo y
       compilar no deje una funcion muerta sin explicacion. -->
  <PropertyGroup Condition="'$(TmdbKey)' == ''">
    <TmdbKey>$(ONDINE_TMDB_KEY)</TmdbKey>
  </PropertyGroup>

  <ItemGroup Condition="'$(TmdbKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TmdbKey</_Parameter1>
      <_Parameter2>$(TmdbKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
