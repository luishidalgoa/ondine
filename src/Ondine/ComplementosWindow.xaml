<Window x:Class="Ondine.ComplementosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="clr-namespace:Ondine.Localizacion"
        Title="{i:T ComplementosTitulo}" Width="820" Height="620" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><!-- cabecera -->
        <RowDefinition Height="Auto"/><!-- elegir complemento y fuente -->
        <RowDefinition Height="*"/><!-- los elementos -->
        <RowDefinition Height="Auto"/><!-- pie -->
      </Grid.RowDefinitions>

      <Grid x:Name="header" Grid.Row="0" Height="46" Background="Transparent">
        <TextBlock Text="{i:T ComplementosTitulo}" FontSize="14" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="18,0,0,0"/>
        <Button x:Name="btnX" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand"
                Foreground="{StaticResource Neutral500}">
          <Path Data="M2,2 L11,11 M11,2 L2,11"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.3" Width="13" Height="13" Stretch="None"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="18,0,18,12">
        <!-- Los descartados se enseñan ARRIBA y en color de aviso: quien instaló
             uno y no lo ve tiene que enterarse de por qué, no buscarlo. -->
        <Border x:Name="cajaDescartados" Visibility="Collapsed" Margin="0,0,0,12"
                Background="{StaticResource Field}" CornerRadius="8" Padding="12,10">
          <StackPanel>
            <TextBlock Text="{i:T ComplementosDescartados}" FontSize="11"
                       Foreground="{StaticResource Accent300}" Margin="0,0,0,6"/>
            <ItemsControl x:Name="listaDescartados">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,3"
                             Foreground="{StaticResource Neutral500}" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Dos pestañas y no dos ventanas: instalar y usar son el mismo viaje
             -«necesito algo que haga X»- y partirlo en dos sitios obliga a
             acordarse de dónde estaba cada cosa. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <RadioButton x:Name="tabInstalados" GroupName="secc" IsChecked="True"
                       Style="{StaticResource PageTab}" Content="{i:T ComplementosInstalados}"/>
          <RadioButton x:Name="tabDisponibles" GroupName="secc"
                       Style="{StaticResource PageTab}" Content="{i:T ComplementosDisponibles}"/>
        </StackPanel>

        <TextBlock Text="{i:T ComplementosCual}" FontSize="11"
                   Foreground="{StaticResource Neutral500}" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="cboComplemento" Grid.Column="0" Height="34"/>
          <TextBox x:Name="txtFuente" Grid.Column="1" Height="34" Margin="8,0,0,0"
                   VerticalContentAlignment="Center"/>
          <Button x:Name="btnListar" Grid.Column="2" Style="{StaticResource BtnSecondary}"
                  Height="34" Margin="8,0,0,0" Content="{i:T ComplementosListar}"/>
        </Grid>
        <TextBlock Text="{i:T ComplementosFuenteAyuda}" FontSize="10.5"
                   Foreground="{StaticResource Neutral600}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="2" Margin="18,0,18,0" Background="{StaticResource Field}" CornerRadius="8">
        <Grid>
          <!-- El estado vacío dice qué hacer, no «no hay nada»: una lista vacía
               sin instrucción deja a quien abre la ventana sin siguiente paso. -->
          <TextBlock x:Name="lblVacio" Text="{i:T ComplementosVacio}" TextWrapping="Wrap"
                     MaxWidth="420" TextAlignment="Center" FontSize="12.5"
                     Foreground="{StaticResource Neutral600}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <!-- Los disponibles. Comparten el mismo hueco que los elementos: nunca
               se enseñan las dos cosas a la vez. -->
          <ListBox x:Name="listaTienda" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch" Visibility="Collapsed">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Nombre}" FontSize="13.5" FontWeight="Medium"/>
                      <TextBlock Text="{Binding Version}" FontSize="11" Margin="8,2,0,0"
                                 Foreground="{StaticResource Neutral600}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Descripcion}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,3,12,0" Foreground="{StaticResource Neutral500}"/>
                    <TextBlock Text="{Binding Donde}" FontSize="10.5" Margin="0,3,0,0"
                               Foreground="{StaticResource Neutral600}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Height="30"
                          MinWidth="96" VerticalAlignment="Center" Margin="8,0,4,0"
                          Content="{Binding Accion}" IsEnabled="{Binding SePuede}"
                          Tag="{Binding}" Click="OnInstalar"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox x:Name="lista" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch" Visibility="Collapsed">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <CheckBox Grid.Column="0" IsChecked="{Binding Marcado, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="4,0,10,0"/>

                  <!-- Hueco fijo para la miniatura aunque no haya: sin él las filas
                       se descolocan según cargue cada imagen. -->
                  <Border Grid.Column="1" Width="96" Height="54" CornerRadius="4"
                          Background="#14161C" Margin="0,0,12,0">
                    <Image Source="{Binding Miniatura}" Stretch="UniformToFill"/>
                  </Border>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                    <TextBlock Text="{Binding Detalle}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource Neutral600}"/>
                  </StackPanel>

                  <Border Grid.Column="3" CornerRadius="999" Padding="8,2" VerticalAlignment="Center"
                          Margin="10,0,4,0" Background="{Binding ColorFondo}">
                    <TextBlock Text="{Binding Veredicto}" FontSize="10.5" Foreground="{Binding ColorTexto}"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Row="3" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="18,12">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="btnSoloFaltan" Style="{StaticResource BtnGhost}" FontSize="12"
                    Content="{i:T ComplementosMarcarLosQueFaltan}"/>
            <Button x:Name="btnNinguno" Style="{StaticResource BtnGhost}" FontSize="12" Margin="6,0,0,0"
                    Content="{i:T ComplementosDesmarcar}"/>
            <TextBlock x:Name="lblEstado" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11.5" Foreground="{StaticResource Neutral500}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCerrar" Style="{StaticResource BtnSecondary}" Width="100"
                    Margin="0,0,8,0" Content="{i:T Cerrar}"/>
            <Button x:Name="btnTraer" Style="{StaticResource BtnPrimary}" Width="140"
                    Content="{i:T ComplementosTraer}" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
