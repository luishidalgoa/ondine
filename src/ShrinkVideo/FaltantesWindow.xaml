<Window x:Class="ShrinkVideo.FaltantesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qué falta" Width="720" Height="600" MinWidth="480" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><!-- título -->
        <RowDefinition Height="Auto"/><!-- resumen -->
        <RowDefinition Height="*"/>   <!-- lista -->
        <RowDefinition Height="Auto"/><!-- pie -->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Height="38">
        <TextBlock x:Name="lblTitulo" Text="Qué falta" FontSize="13.5" FontWeight="Medium"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
        <Button x:Name="btnCerrar" Style="{StaticResource BtnClose}" HorizontalAlignment="Right"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="13" Height="13" Stretch="None"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <!-- Resumen y el interruptor de alcance: por defecto solo se miran las temporadas de las
           que hay algo, porque listar las que ni has empezado no informa de nada. -->
      <StackPanel Grid.Row="1" Margin="16,4,16,10">
        <!-- Mirar UNA temporada es lo normal: con 16, «qué falta» en bloque no dice mucho; lo
             útil es qué queda de la que estás completando. El rótulo dice «Temporada» o «Año»
             según cómo las numere el catálogo (hay series que van por año de emisión). -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock x:Name="lblTemporada" Text="Temporada" FontSize="12" VerticalAlignment="Center"
                     Foreground="{StaticResource Neutral400}" Margin="0,0,8,0"/>
          <ComboBox x:Name="cboTemporada" MinWidth="150" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="lblResumen" FontSize="13" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
        <TextBlock x:Name="lblEspeciales" FontSize="11.5" Margin="0,3,0,0"
                   Foreground="{StaticResource Neutral500}" TextWrapping="Wrap"/>
        <CheckBox x:Name="chkTodas" Margin="0,8,0,0" FontSize="12"
                  Foreground="{StaticResource Neutral400}"
                  Content="Incluir las temporadas que no he empezado"/>
      </StackPanel>

      <ListBox x:Name="lista" Grid.Row="2" Background="Transparent" BorderThickness="0"
               Margin="8,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingStackPanel.IsVirtualizing="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Codigo}" FontFamily="{StaticResource FontMono}" FontSize="12"
                         Foreground="{StaticResource OrgWarn}" VerticalAlignment="Top" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding Titulos}" FontSize="12.5" TextWrapping="Wrap"
                         Foreground="{StaticResource Text}"/>
              <!-- «entero» frente a «a medias» es la diferencia que importa: uno hay que
                   conseguirlo y el otro puede estar ahí sin partir. -->
              <Border Grid.Column="2" Background="{StaticResource Field}" CornerRadius="6" Padding="7,2"
                      VerticalAlignment="Top" Margin="8,0,0,0">
                <TextBlock Text="{Binding Etiqueta}" FontSize="10.5" Foreground="{StaticResource Neutral400}"/>
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="3" Margin="16,10,16,14">
        <TextBlock x:Name="lblPie" FontSize="11" Foreground="{StaticResource Neutral500}"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Se cuenta por historias: un capítulo con tres y solo dos en disco sale como incompleto."/>
        <Button x:Name="btnCopiar" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right"
                Content="Copiar la lista" FontSize="12" Padding="12,5"/>
      </Grid>
    </Grid>
  </Border>
</Window>
