<Window x:Class="ShrinkVideo.AyudaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayuda — ShrinkStudio" Width="900" Height="680" MinWidth="720" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontUI}" Foreground="{StaticResource Text}" Background="{StaticResource Bg}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Neutral400}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14E9E9ED"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource Neutral300}"/><Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="LineHeight" Value="20"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Neutral400}"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11,7"/>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- ═ barra de título ═ -->
      <Grid Grid.Row="0">
        <TextBlock Text="Ayuda — ShrinkStudio" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <Button x:Name="btnCerrar" Style="{StaticResource BtnClose}" HorizontalAlignment="Right"
                WindowChrome.IsHitTestVisibleInChrome="True">
          <Path Data="M2,2 L11,11 M11,2 L2,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="13" Height="13" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- ═ índice lateral ═ -->
        <Border Grid.Column="0" Background="#151725" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
          <StackPanel Margin="10,14">
            <TextBlock Text="Tutoriales" FontSize="11" Foreground="{StaticResource Neutral600}" Margin="12,0,0,8"/>
            <RadioButton x:Name="navOrgComo" Style="{StaticResource NavItem}" GroupName="pag" IsChecked="True" Content="Organizar · cómo funciona"/>
            <RadioButton x:Name="navOrgPasos" Style="{StaticResource NavItem}" GroupName="pag" Content="Organizar · paso a paso"/>
            <RadioButton x:Name="navComprimir" Style="{StaticResource NavItem}" GroupName="pag" Content="Comprimir · paso a paso"/>
            <RadioButton x:Name="navRecortes" Style="{StaticResource NavItem}" GroupName="pag" Content="Recortes"/>
          </StackPanel>
        </Border>

        <!-- ═ contenido ═ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,26">
          <Grid>

            <!-- ── Organizar · cómo funciona ── -->
            <StackPanel x:Name="pagOrgComo">
              <TextBlock Style="{StaticResource H2}" Text="Cómo identifica Organizar tus ficheros"/>
              <TextBlock Style="{StaticResource P}" Text="Organizar coteja los vídeos de una carpeta contra un catálogo (un JSON con los episodios de la serie) y propone el nombre canónico de cada uno. Nunca toca los originales hasta que pulsas Aplicar, y nunca se inventa un episodio: lo dudoso lo deja para que decidas tú."/>

              <TextBlock Style="{StaticResource H3}" Text="QUÉ LEE DE CADA FICHERO"/>
              <WrapPanel>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="Nombre del fichero" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="número · fecha · título" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="Carpeta" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="la temporada" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="Metadato del vídeo" FontSize="13" Foreground="{StaticResource Text}"/><TextBlock Text="título embebido · solo rescate" FontSize="11" Foreground="{StaticResource Neutral600}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Background="{StaticResource Accent900}" BorderBrush="{StaticResource Accent700}">
                  <StackPanel><TextBlock Text="Tu catálogo (JSON)" FontSize="13" Foreground="{StaticResource Accent200}"/><TextBlock Text="títulos · número · fecha" FontSize="11" Foreground="{StaticResource Accent300}"/></StackPanel>
                </Border>
              </WrapPanel>
              <TextBlock Style="{StaticResource P}" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}"
                         Text="El metadato solo se lee de los ficheros dudosos y que estén en disco: abrir uno que está solo en la nube (OneDrive) lo descargaría entero."/>

              <TextBlock Style="{StaticResource H3}" Text="CÓMO DECIDE · GANA LA PRIMERA REGLA QUE ENCAJA"/>
              <StackPanel>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="0" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="siempre manda" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="tu decisión manual" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="1" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="seguro" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="número + fecha de emisión que cuadran" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgOkBg}" BorderBrush="{StaticResource OrgOkBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="2" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="seguro" FontSize="12" Foreground="{StaticResource OrgOk}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="el título coincide con el catálogo" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgWarnBg}" BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="3" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="a revisar" FontSize="12" Foreground="{StaticResource OrgWarn}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="número + fecha aproximada (±2 días)" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,7" Background="{StaticResource OrgWarnBg}" BorderBrush="{StaticResource OrgWarnBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="4" FontSize="12" Foreground="{StaticResource Neutral400}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="a revisar" FontSize="12" Foreground="{StaticResource OrgWarn}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="el título se parece, pero poco" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Border CornerRadius="8" Padding="12,9" Background="{StaticResource OrgDangerBg}" BorderBrush="{StaticResource OrgDangerBorder}" BorderThickness="1">
                  <DockPanel><Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Surface}" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="◆" FontSize="11" Foreground="{StaticResource OrgDanger}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="conflicto" FontSize="12" Foreground="{StaticResource OrgDanger}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    <TextBlock Text="dos ficheros al mismo número, o sin pistas" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></DockPanel>
                </Border>
              </StackPanel>
              <TextBlock Style="{StaticResource P}" Margin="0,10,0,0" FontSize="11.5">
                <Run Foreground="{StaticResource OrgOk}">●</Run><Run Foreground="{StaticResource Neutral500}"> verde: se aplica solo   </Run>
                <Run Foreground="{StaticResource OrgWarn}">●</Run><Run Foreground="{StaticResource Neutral500}"> ámbar: lo decides tú   </Run>
                <Run Foreground="{StaticResource OrgDanger}">●</Run><Run Foreground="{StaticResource Neutral500}"> rojo: conflicto</Run>
              </TextBlock>

              <TextBlock Style="{StaticResource H3}" Text="QUÉ NECESITAN TUS FICHEROS"/>
              <TextBlock Style="{StaticResource P}" Text="• Al menos una pista fuerte por fichero: un número reconocible (S04E01, 4x01, [438], E72…) o un título parecido al del catálogo."/>
              <TextBlock Style="{StaticResource P}" Text="• Organizados por carpetas de temporada (o con Sxx en el nombre) para acertar la temporada."/>
              <TextBlock Style="{StaticResource P}" Text="• El catálogo debe incluir ese episodio. La morralla de la descarga (AMZN, WEB-DL, x265…) la ignora sola, así que no hace falta limpiarla."/>
            </StackPanel>

            <!-- ── Organizar · paso a paso ── -->
            <StackPanel x:Name="pagOrgPasos" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="Usar Organizar paso a paso"/>
              <TextBlock Style="{StaticResource P}" Text="1.  Carga un catálogo con «Catálogos…» (o impórtalo). Es el JSON con los episodios de la serie."/>
              <TextBlock Style="{StaticResource P}" Text="2.  Elige la carpeta con los vídeos. La plantilla de arriba define cómo se nombrarán (serie, temporada, episodio, título)."/>
              <TextBlock Style="{StaticResource P}" Text="3.  Pulsa «Analizar». Cada fichero recibe un estado: verde «Correcto» (ya bien nombrado), ámbar «Con cambios» (se renombrará) o «Revisar/Conflicto» (decides tú)."/>
              <TextBlock Style="{StaticResource P}" Text="4.  Revisa. Los chips de estado y su color te dicen de qué fiarte; abre una fila para ver contra qué episodio ha casado y elegir otro si hace falta."/>
              <TextBlock Style="{StaticResource P}" Text="5.  Marca los que quieras y pulsa «Aplicar». Solo entonces se renombran los ficheros. Puedes «Deshacer lote» justo después."/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="Pulsa la cabecera de una columna para ordenar; un fichero dudoso puedes apartarlo «para revisar luego» con el botón derecho."/>
            </StackPanel>

            <!-- ── Comprimir ── -->
            <StackPanel x:Name="pagComprimir" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="Comprimir vídeos por lotes"/>
              <TextBlock Style="{StaticResource P}" Text="1.  En «Origen» elige una carpeta (o arrastra vídeos a la lista). Con «Subcarpetas» marcado entra en las temporadas."/>
              <TextBlock Style="{StaticResource P}" Text="2.  Pulsa «Analizar»: lista cada vídeo con su tamaño, duración, códec e idiomas."/>
              <TextBlock Style="{StaticResource P}" Text="3.  Ajusta el preset o las opciones (formato, códec, calidad, resolución, audio). El idioma principal se marca como pista por defecto; los que no elijas se descartan para ahorrar espacio."/>
              <TextBlock Style="{StaticResource P}" Text="4.  Mira el pronóstico de ahorro; si quieres la cifra real, «Medir con una muestra» codifica unos fragmentos cortos."/>
              <TextBlock Style="{StaticResource P}" Text="5.  Selecciona los vídeos y pulsa «Comprimir selección». Verás el progreso en vivo, con Pausar y Detener. Nunca toca los originales salvo que lo pidas (y entonces van a la Papelera)."/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="«Enviar a la Papelera» usa una papelera propia de la app: puedes recuperar lo último con Ctrl+Z al instante. Al acumularse o cerrar la app, esos ficheros pasan a la Papelera de Windows (siguen recuperables ahí)."/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="Si el disco se llena, la tanda se pausa sola y sigue cuando liberas espacio. Puedes seguir el progreso desde cualquier pestaña con la píldora de la cabecera."/>
            </StackPanel>

            <!-- ── Recortes ── -->
            <StackPanel x:Name="pagRecortes" Visibility="Collapsed">
              <TextBlock Style="{StaticResource H2}" Text="Recortes: partir un vídeo o quitarle un trozo"/>
              <TextBlock Style="{StaticResource P}" Text="1.  Carga un vídeo (o llega aquí desde Organizar con «Enviar a Recortes…»)."/>
              <TextBlock Style="{StaticResource P}" Text="2.  Marca los cortes en la línea de tiempo para separar los tramos que quieres conservar (útil para partir un fichero que trae dos capítulos, o quitar una intro)."/>
              <TextBlock Style="{StaticResource P}" Text="3.  Pulsa «Exportar»: genera un fichero por tramo. El original no se toca."/>
              <TextBlock Style="{StaticResource P}" Text="4.  «Vaciar» deja la página como recién abierta y libera la memoria del vídeo y las miniaturas, sin cerrar la app."/>
              <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource Neutral600}" Text="Con los tramos ya en disco, la app ofrece mandar el original a la Papelera (nunca sin preguntar). Va a la papelera propia: si algo salió mal, Ctrl+Z lo recupera al instante."/>
              <TextBlock Style="{StaticResource H3}" Text="COMBINAR CON ORGANIZAR"/>
              <TextBlock Style="{StaticResource P}" Text="Cuando Organizar detecta que un fichero trae DOS episodios, ofrece «Partirlo en dos» → lo abre en Recortes para que separes los dos capítulos. Después, cada trozo se identifica y renombra por separado en Organizar."/>
            </StackPanel>

          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
